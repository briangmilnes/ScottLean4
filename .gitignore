# The ComputAItionalThinking ruleset is a separate repository, cloned/installed
# on its own. It is imported by CLAUDE.md, not committed into this repo.
/ComputAItionalThinking/

# Lean build output
/.lake/
/build/

# Emacs
# backup files
*~
# auto-save files
\#*\#
# lock files (symlink to the editing user)
.\#*
# byte-compiled elisp
*.elc
auto-save-list/
tramp

# macOS
.DS_Store

# The one carve-out: the verbatim Harper PFPL book is Cambridge University Press
# copyright, and its free edition is marked no-redistribution. Keep the raw book
# local; our own OUTLINE.md and generated Lean under HarperBook/ are tracked.
# (Remove these two lines if the repo is private.)
/HarperBook/PFPL.pdf
/HarperBook/PFPL.txt
