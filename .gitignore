# The ComputAItionalThinking ruleset is a separate repository, cloned/installed
# on its own. It is imported by CLAUDE.md, not committed into this repo.
/ComputAItionalThinking/

# Lean build output
/.lake/
/build/

# Emacs
# backup files
*~
# auto-save files
\#*\#
# lock files (symlink to the editing user)
.\#*
# byte-compiled elisp
*.elc
auto-save-list/
tramp

# macOS
.DS_Store

# Downloaded third-party PDFs stay local (copyright: do not redistribute via the
# public repo). Remove/adjust per-file if a specific PDF is openly licensed.
*.pdf

# Harper PFPL working area: the abbreviated edition is personal-use / no
# redistribution, so its extracted text and derivatives stay local.
/HarperBook/
