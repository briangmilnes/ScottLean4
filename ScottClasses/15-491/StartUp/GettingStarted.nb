Notebook[{
Cell[TextData[{
  StyleBox["Getting Started with ",
    FontFamily->"Swiss721bt"],
  StyleBox["Mathematica",
    FontFamily->"Swiss721bt",
    FontSlant->"Italic"],
  StyleBox[" 3.0:\na Brief Introduction",
    FontFamily->"Swiss721bt"]
}], "Title"],

Cell[TextData[{
  StyleBox[
  "prepared by\n\nAndrej Bauer                 and                 Dana S. \
Scott            ",
    FontSize->16,
    FontWeight->"Bold"],
  "\n",
  StyleBox["Andrej.Bauer@cs.cmu.edu                dana.scott@cs.cmu.edu",
    FontFamily->"Courier",
    FontSize->12]
}], "Subtitle"],

Cell["Last Revised 7 January 1997", "Subsubtitle",
  FormatType->InputForm,
  FontWeight->"Bold"],

Cell[CellGroupData[{

Cell[TextData[{
  CounterBox["Section", "toc"],
  ". Table of Contents"
}], "Section",
  CellTags->"toc"],

Cell[TextData[{
  CounterBox["Section", "toc"],
  ". ",
  ButtonBox["Table of Contents",
    ButtonData:>"toc",
    ButtonStyle->"Hyperlink"]
}], "ItemizedText"],

Cell[TextData[{
  CounterBox["Section", "intro"],
  ". ",
  ButtonBox["Introduction",
    ButtonData:>"intro",
    ButtonStyle->"Hyperlink"]
}], "ItemizedText"],

Cell[TextData[{
  CounterBox["Section", "frontend"],
  ". ",
  ButtonBox["Using the Front End",
    ButtonData:>"frontend",
    ButtonStyle->"Hyperlink"]
}], "ItemizedText"],

Cell[TextData[{
  CounterBox["Section", "kernel"],
  ".",
  ButtonBox["Running Mathematica",
    ButtonData:>"kernel",
    ButtonStyle->"Hyperlink"]
}], "ItemizedText",
  FormatType->InputForm]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  CounterBox["Section", "intro"],
  ". Introduction\n",
  StyleBox[
  "[if you only see section titles, double-click on the little triangle on \
the right side of this cell]",
    FontSize->9,
    FontWeight->"Plain"]
}], "Section",
  CellTags->"intro"],

Cell[TextData[{
  "This document will teach you the basics of ",
  StyleBox["Mathematica 3.0",
    FontSlant->"Italic"],
  ". It should take about XX minutes to complete. You should not try to \
remember everything the first time you read it. You can always check things \
later. At the end of the document you will find reference cards, which you \
can print out."
}], "Text"],

Cell[TextData[{
  "A ",
  StyleBox["Mathematica ",
    FontSlant->"Italic"],
  " document is called a ",
  StyleBox["notebook",
    FontWeight->"Bold"],
  "."
}], "NoteWell"],

Cell[TextData[{
  "Notebooks are usually stored in files with extension ",
  StyleBox[".nb", "Input"],
  ". Files with extensions ",
  StyleBox[".m", "Input"],
  " and ",
  StyleBox[".ma", "Input"],
  " contain ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " programs or ",
  StyleBox["Mathemati",
    FontSlant->"Italic"],
  "ca 2.2 notebooks."
}], "Text"],

Cell[TextData[{
  "A notebook has a hierarchical structure. It is divided into ",
  StyleBox["cells",
    FontWeight->"Bold"],
  ". Cells contain text, pictures, formulas, programs, or other cells."
}], "NoteWell"],

Cell[TextData[{
  "You can tell where a cell starts and ends by looking at the ",
  StyleBox["cell brackets",
    FontWeight->"Bold"],
  " on the right-hand side of the notebook (the long blue square brackets)."
}], "Text"],

Cell[TextData[{
  "A cell which contains other cells is called a ",
  StyleBox["composite cell",
    FontWeight->"Bold"],
  ". The first cell in a composite cell is the ",
  StyleBox["title cell",
    FontWeight->"Bold"],
  ". A composite cell is either ",
  StyleBox["open",
    FontSlant->"Italic"],
  " or ",
  StyleBox["closed",
    FontSlant->"Italic"],
  ". When it is closed, you can only see its title cell. When it is open, you \
can see the cells that are grouped inside. When a cell is closed, this is \
indicated by a small triangular arrow at the bottom of its bracket. Here is \
an example:"
}], "Text"],

Cell[CellGroupData[{

Cell[TextData[{
  StyleBox["This is the title of a closed composite cell. ",
    FontColor->RGBColor[0, 0, 1]],
  "\n",
  StyleBox[
  "[To open the composite cell, double-click on the bracket with the small \
triangle.]",
    FontWeight->"Plain"]
}], "Subsubsection"],

Cell["As an illustration, here is a cell that contains a picture:", "Text",
  FontColor->RGBColor[0, 0, 1],
  Background->None],

