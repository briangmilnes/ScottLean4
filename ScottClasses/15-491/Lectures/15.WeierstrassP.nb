Notebook[{
Cell[TextData[{
  "Week 15   Projective Geometry\n",
  StyleBox["The Weierstra\[SZ] ",
    FontSize->18],
  StyleBox["\[WeierstrassP]",
    FontFamily->"Symbol",
    FontSize->18,
    FontWeight->"Plain"],
  StyleBox[" Function",
    FontSize->18]
}], "Title",
  Evaluatable->False,
  AspectRatioFixed->True,
  FontSize->36],

Cell[TextData[{
  StyleBox["\[Copyright] Dana Scott 1993/1997/1998",
    FontSize->16,
    FontWeight->"Bold"],
  StyleBox["\nNotebook  last edited: ",
    FontSize->16],
  StyleBox["3 December 1998",
    FontSize->16,
    FontWeight->"Bold"]
}], "Subtitle",
  FontSize->18],

Cell[CellGroupData[{

Cell[TextData[{
  "The ",
  StyleBox["\[WeierstrassP]",
    FontFamily->"Symbol",
    FontWeight->"Plain"],
  " Function and Cubics"
}], "Section"],

Cell[CellGroupData[{

Cell["Parameterizarion of cubics", "Subsection"],

Cell[CellGroupData[{

Cell["The Weierstra\[SZ] function", "Subsubsection"],

Cell[TextData[{
  StyleBox["Definition.",
    FontWeight->"Bold"],
  "  The ",
  StyleBox["Weierstra\[SZ]",
    FontSize->17,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" ",
    FontSize->17,
    FontWeight->"Bold"],
  StyleBox["\[WeierstrassP]",
    FontFamily->"Symbol",
    FontSize->17,
    FontWeight->"Bold"],
  StyleBox[" ",
    FontSize->17,
    FontWeight->"Bold"],
  StyleBox["function",
    FontSize->17,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " is the complex meromorphic function that satisfies the following \
algebraic differential equation (for given parameters ",
  Cell[BoxData[
      StyleBox[\(g\_2\),
        FontWeight->"Bold"]]],
  "and ",
  Cell[BoxData[
      StyleBox[\(g\_3\),
        FontWeight->"Bold"]]],
  ")\n\t\t",
  Cell[BoxData[
      RowBox[{
        StyleBox[
          SuperscriptBox[
            StyleBox[\(\(\[WeierstrassP]\^\[Prime]\)[u]\),
              FontSize->18,
              FontWeight->"Bold"], 
            StyleBox["2",
              FontWeight->"Bold"]],
          FontWeight->"Bold"], 
        StyleBox["=",
          FontSize->18,
          FontWeight->"Bold"], 
        RowBox[{
          StyleBox[
            RowBox[{
              StyleBox["4",
                FontSize->18,
                FontWeight->"Bold"], 
              StyleBox[" ",
                FontSize->18,
                FontWeight->"Bold"], 
              SuperscriptBox[
                StyleBox[\(\[WeierstrassP][u]\),
                  FontSize->18,
                  FontWeight->"Bold"], "3"]}],
            FontWeight->"Bold"], 
          StyleBox["-",
            FontSize->18,
            FontWeight->"Bold"], 
          StyleBox[\(g\_2\ \[WeierstrassP][u]\),
            FontSize->18,
            FontWeight->"Bold"], 
          StyleBox["-",
            FontSize->18,
            FontWeight->"Bold"], 
          StyleBox[\(g\_3\),
            FontSize->18,
            FontWeight->"Bold"]}]}]]]
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  "Of course, it is not obvious that such a function ",
  StyleBox["exists",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " \[LongDash] that is a whole chaper in a book on complex analysis.  As far \
as numerical computations go,  ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " has this functionand important related functions ",
  StyleBox["built in",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  Some of the following information is copied from the ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " book."
}], "Text"],

Cell[TextData[{
  "The ",
  StyleBox["Weierstra\[SZ] elliptic function", "TB"],
  " ",
  Cell[BoxData[
      StyleBox[
        RowBox[{"WeierstrassP", "[", 
          RowBox[{"u", ",", " ", 
            RowBox[{"{", 
              RowBox[{
                FormBox[
                  
                  SubscriptBox[
                    "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"g\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "2"],
                  "TraditionalForm"], ",", " ", 
                FormBox[
                  
                  SubscriptBox[
                    "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"g\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "3"],
                  "TraditionalForm"]}], "}"}]}], "]"}],
        FontWeight->"Bold"]]],
  " can also be considered as the ",
  StyleBox["inverse of an elliptic integral",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  The Weierstra\[SZ] function ",
  Cell[BoxData[
      FormBox[
        StyleBox[\(\[WeierstrassP](u; g\_2, g\_3)\),
          FontWeight->"Bold"], TraditionalForm]], "InlineFormula",
    CellTags->"S3.2.11"],
  " gives the value of ",
  Cell[BoxData[
      FormBox[
        StyleBox["x",
          FontWeight->"Bold"], TraditionalForm]], "InlineFormula",
    CellTags->"S3.2.11"],
  " for which \n\t\t\t",
  Cell[BoxData[
      StyleBox[
        \(u = \[Integral]\_\[Infinity]\%x
              \(1\/\@\(4\ t\^3 - g\_2\ t - g\_3\)\) \[DifferentialD]t\),
        FontWeight->"Bold"]],
    FontSize->18],
  StyleBox[". ",
    FontSize->18,
    FontWeight->"Bold"]
}], "Text"],

Cell[TextData[{
  "The ",
  StyleBox["Laurent powerseries expansion",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of ",
  Cell[BoxData[
      FormBox[
        StyleBox[\(\[WeierstrassP](u; g\_2, g\_3)\),
          FontWeight->"Bold"], TraditionalForm]]],
  " has the form:\n       ",
  Cell[BoxData[
      \(TraditionalForm\`\[WeierstrassP](u; g\_2, g\_3)\)],
    FontSize->18,
    FontWeight->"Bold"],
  StyleBox[" = ",
    FontSize->18,
    FontWeight->"Bold"],
  Cell[BoxData[
      \(1\/u\^2 + \(g\_2\ u\^2\)\/20 + \(g\_3\ u\^4\)\/28 + 
          \(g\_2\^2\ u\^6\)\/1200 + \(3\ g\_2\ g\_3\ u\^8\)\/6160 + \  ... 
        \)],
    FontSize->18,
    FontWeight->"Bold"]
}], "Text"],

Cell[BoxData[
    RowBox[{"?", 
      StyleBox["WeierstrassP",
        "MR\[UHat]"]}]], "Input"],

Cell[BoxData[
    RowBox[{"?", 
      StyleBox["InverseWeierstrassP",
        "MR\[DownQuestion]"]}]], "Input"],

Cell[BoxData[
    \(\(?WeierstrassInvariants\)\)], "Input"],

Cell[BoxData[
    \(\(?WeierstrassHalfPeriods\)\)], "Input"],

Cell[TextData[{
  Cell[BoxData[
      StyleBox["WeierstrassP",
        FontWeight->"Bold"]]],
  " takes as a second argument the coefficients ",
  Cell[BoxData[
      StyleBox[\({g\_2, g\_3}\),
        FontWeight->"Bold"]]],
  " of the equation of the elliptic curve under consideration (in Weierstra\
\[SZ] normal form). If instead we know the periods of the curve, we start by \
using ",
  Cell[BoxData[
      StyleBox["WeierstrassInvariants",
        FontWeight->"Bold"]]],
  ". "
}], "ExampleText",
  CellTags->"WeierstrassP"],

Cell[TextData[{
  "This plot illustrates that ",
  Cell[BoxData[
      \(TraditionalForm\`\[WeierstrassP](g\_2, g\_3)\)], "InlineFormula",
    CellTags->"WeierstrassP"],
  " has periods ",
  Cell[BoxData[
      \(TraditionalForm\`2  \[Omega]\)], "InlineFormula",
    CellTags->"WeierstrassP"],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`2  \[Omega]\^\[Prime]\)], "InlineFormula",
    CellTags->"WeierstrassP"],
  "."
}], "ExampleText",
  CellTags->"WeierstrassP"],

Cell[BoxData[
    \({g\_2, g\_3} = WeierstrassInvariants[{\(-1. \) - I, 1 - 2.  I}]; \n
    ContourPlot[
      Abs[WeierstrassP[x + I  y, {g\_2, g\_3}]], {x, \(-5\), 5}, {y, \(-5\), 
        5}]; \)], "Input",
  CellTags->"WeierstrassP"],

Cell[TextData[{
  "The function ",
  Cell[BoxData[
      StyleBox[
        RowBox[{"WeierstrassPPrime", "[", 
          RowBox[{"u", ",", " ", 
            RowBox[{"{", 
              RowBox[{
                FormBox[
                  
                  SubscriptBox[
                    "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"g\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "2"],
                  "TraditionalForm"], ",", " ", 
                FormBox[
                  
                  SubscriptBox[
                    "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"g\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "3"],
                  "TraditionalForm"]}], "}"}]}], "]"}],
        FontWeight->"Bold"]]],
  " is given by \n\t\t\t",
  Cell[BoxData[
      FormBox[
        StyleBox[
          \(\(\[WeierstrassP]\^\[Prime]\) \((u; g\_2, g\_3)\) = 
            \(\[PartialD]\/\[PartialD]u\) \[WeierstrassP] 
              \((u; g\_2, g\_3)\)\),
          FontWeight->"Bold"], TraditionalForm]], "InlineFormula",
    CellTags->"S3.2.11"],
  ". \nThe Weierstra\[SZ] functions are also sometimes written in terms of \
their ",
  StyleBox["fundamental half\[Hyphen]periods", "TI"],
  " ",
  Cell[BoxData[
      \(TraditionalForm\`\[Omega]\)], "InlineFormula",
    CellTags->"S3.2.11"],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`\[Omega]\^\[Prime]\)], "InlineFormula",
    CellTags->"S3.2.11"],
  ", obtained from the invariants ",
  Cell[BoxData[
      \(TraditionalForm\`g\_2\)], "InlineFormula",
    CellTags->"S3.2.11"],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`g\_3\)], "InlineFormula",
    CellTags->"S3.2.11"],
  " using ",
  Cell[BoxData[
      StyleBox[
        RowBox[{"WeierstrassHalfPeriods", "[", 
          RowBox[{"{", 
            RowBox[{
              FormBox[
                
                SubscriptBox[
                  "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"g\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "2"],
                "TraditionalForm"], ",", " ", 
              FormBox[
                
                SubscriptBox[
                  "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"g\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "3"],
                "TraditionalForm"]}], "}"}], "]"}],
        FontWeight->"Bold"]]],
  ". \nThe function ",
  Cell[BoxData[
      StyleBox[
        RowBox[{"InverseWeierstrassP", "[", 
          RowBox[{"p", ",", " ", 
            RowBox[{"{", 
              RowBox[{
                FormBox[
                  
                  SubscriptBox[
                    "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"g\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "2"],
                  "TraditionalForm"], ",", " ", 
                FormBox[
                  
                  SubscriptBox[
                    "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"g\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "3"],
                  "TraditionalForm"]}], "}"}]}], "]"}],
        FontWeight->"Bold"]]],
  " finds one of the two values of ",
  Cell[BoxData[
      \(TraditionalForm\`u\)], "InlineFormula",
    CellTags->"S3.2.11"],
  " for which ",
  Cell[BoxData[
      \(TraditionalForm\`p = \[WeierstrassP](u; g\_2, g\_3)\)], 
    "InlineFormula",
    CellTags->"S3.2.11"],
  ". This value always lies in the parallelogram defined by the complex \
number half\[Hyphen]periods ",
  Cell[BoxData[
      \(TraditionalForm\`\[Omega]\)], "InlineFormula",
    CellTags->"S3.2.11"],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`\[Omega]\^\[Prime]\)], "InlineFormula",
    CellTags->"S3.2.11"],
  ". \n",
  Cell[BoxData[
      StyleBox[
        RowBox[{"InverseWeierstrassP", "[", 
          RowBox[{\({p, \ q}\), ",", " ", 
            RowBox[{"{", 
              RowBox[{
                FormBox[
                  
                  SubscriptBox[
                    "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"g\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "2"],
                  "TraditionalForm"], ",", " ", 
                FormBox[
                  
                  SubscriptBox[
                    "\<\"\\!\\(\\*StyleBox[\\\"\\\\\\\"g\\\\\\\"\\\", \
\\\"TI\\\"]\\)\"\>", "3"],
                  "TraditionalForm"]}], "}"}]}], "]"}],
        FontWeight->"Bold"]]],
  " finds the unique value of ",
  Cell[BoxData[
      \(TraditionalForm\`u\)], "InlineFormula",
    CellTags->"S3.2.11"],
  " for which ",
  Cell[BoxData[
      \(TraditionalForm\`p = \[WeierstrassP](u; g\_2, g\_3)\)], 
    "InlineFormula",
    CellTags->"S3.2.11"],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`q = \(\[WeierstrassP]\^\[Prime]\)(u; g\_2, g\_3)\)], 
    "InlineFormula",
    CellTags->"S3.2.11"],
  ". In order for any such value of ",
  Cell[BoxData[
      \(TraditionalForm\`u\)], "InlineFormula",
    CellTags->"S3.2.11"],
  " to exist, ",
  Cell[BoxData[
      \(TraditionalForm\`p\)], "InlineFormula",
    CellTags->"S3.2.11"],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`q\)], "InlineFormula",
    CellTags->"S3.2.11"],
  " must be related by ",
  Cell[BoxData[
      StyleBox[\(q\^2 = 4\ p\^3 - g\_2\ p - g\_3\),
        FontWeight->"Bold"]]],
  ". "
}], "Text"],

Cell[TextData[{
  "Here are some basic computations in ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  ". First we make some ",
  StyleBox["abbreviations",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text"],

Cell["\<\
WP[u_, g2_, g3_] := WeierstrassP[u, g2, g3];

WPP[u_, g2_, g3_] := WeierstrassPPrime[u, g2, g3];

poly[g2_,g3_][x_,y_] := y^2 - 4 x^3 + g2 x + g3;

test[g2_,g3_][u_] := N[poly[g2,g3][WP[u,g2,g3],WPP[u,g2,g3]], 20];\
\>", 
  "Input",
  AspectRatioFixed->True],

Cell[TextData[{
  "Let us see if the points given by ",
  Cell[BoxData[
      StyleBox["WeierstrassP",
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox["WeierstrassPPrime",
        FontWeight->"Bold"]]],
  " do lie on the cubic."
}], "Text"],

Cell["\<\
try = Table[test[1,-1][N[E(x + I y),20]], {x,1,4},{y,1,4}];

try //TableForm\
\>", "Input",
  AspectRatioFixed->True],

Cell[TextData[{
  "That looks quite close to ",
  StyleBox["0",
    FontWeight->"Bold"],
  ", and here is another test."
}], "Text"],

Cell["1. + Abs /@ try // TableForm", "Input",
  AspectRatioFixed->True],

Cell[TextData[{
  "So the points ",
  Cell[BoxData[
      StyleBox[\({WP[u], \ WPP[u]}\ \),
        FontWeight->"Bold"]]],
  "do lie on the cubic curve.  "
}], "Text"],

Cell[TextData[{
  "Let us try some ",
  StyleBox["inverse computations. ",
    FontWeight->"Bold",
    FontSlant->"Italic"]
}], "Text"],

Cell["InverseWeierstrassP[I,{1,-1}]", "Input"],

Cell["Hmm, that seems odd.  What does it mean?", "Text"],

Cell["poly[1,-1][I, Sqrt[1 - 5*I]]", "Input"],

Cell[TextData[{
  "Ah, yes, we have a point on the curve.  Now, we try to evaluate the \
expression ",
  StyleBox["numerically",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text"],

Cell["\<\
InverseWeierstrassP[I,{1,-1}]// N

WP[%,1,-1]\
\>", "Input"],

Cell["That seems to work.  Here is another example.", "Text"],

Cell["InverseWeierstrassP[3+I,{1,-1}]", "Input"],

Cell["\<\
InverseWeierstrassP[3+I,{1,-1}]// N

WP[%,1,-1]\
\>", "Input"],

Cell["We can try for the half-periods.", "Text"],

Cell[TextData[{
  StyleBox["WeierstrassHalfPeriods[", "MRs",
    FontWeight->"Bold"],
  "{1,-1}]//N\nArgandPlot[Join[%,{0,1,I}]];"
}], "Input"],

Cell["\<\
Here is the finding of the coefficients from the half-periods.\
\>",
   "Text"],

Cell[TextData[{
  "N[WeierstrassInvariants[{1,I}],50]\n\n",
  StyleBox["WeierstrassHalfPeriods[", "MRst",
    FontWeight->"Bold"],
  "%]//N"
}], "Input"],

Cell["\<\
So, we can compute a lot of information about these functions.\
\>",
   "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Tracing curves", "Subsubsection",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell["\<\
First we can just try some sections of the Weierstrass functions.  \
We take absolute values of complex numbers in order to have a real-valued \
graph.\
\>", "Text"],

Cell["\<\
Plot[Abs[WP[I t, 1, -1]],
\t\t{t,-4, 4},
\t\tPlotPoints -> 63,
\t\tPlotRange -> {{-4,4},{0,10}}];\
\>", "Input",
  AspectRatioFixed->True,
  AnimationCycleOffset->0.0625,
  AnimationCycleRepetitions->Infinity],

Cell["\<\
In other words, this is a section along the imaginary axis, and it \
indicates that there is a periodicity.\
\>", "Text"],

Cell["\<\
Plot[Abs[WPP[I t, 1, -1]],
\t\t{t,-4, 4},
\t\tPlotPoints -> 63,
\t\tPlotRange -> {{-4,4},{0,10}}];\
\>", "Input",
  AspectRatioFixed->True],

Cell[TextData[{
  "It is a theorem that the derivative has the ",
  StyleBox["same periods",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "; and we have an indication of that.  It is even more obvious when the \
graphs are superimposed."
}], "Text"],

Cell["\<\
Plot[{WP[I t, 1, -1],
     WPP[I t, 1, -1] I},
\t\t{t,-4, 4},
\t\tPlotPoints -> 63,
\t\tPlotRange -> {{-4,4},{-20,20}}];\
\>", "Input",
  AspectRatioFixed->True],

Cell[TextData[{
  "It turned out that ",
  Cell[BoxData[
      StyleBox[\(WP[I\ t, 1, \(-1\)]\),
        FontWeight->"Bold"]]],
  " is real, and ",
  Cell[BoxData[
      StyleBox[\(WPP[I\ t, 1, \(-1\)]\),
        FontWeight->"Bold"]]],
  " is purely imaginary.  On the other hand, the quantities ",
  Cell[BoxData[
      StyleBox[\(WP[t, 1, \(-1\)]\),
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox[\(WPP[t, 1, \(-1\)]\),
        FontWeight->"Bold"]]],
  " are both real \[LongDash] provided, of course, that ",
  Cell[BoxData[
      StyleBox["t",
        FontWeight->"Bold"]]],
  " is real.  Thus, we can try a ",
  StyleBox["parametric plot",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ". "
}], "Text"],

Cell["\<\
pp = ParametricPlot[{WP[t,1,-1], WPP[t,1,-1]},
            {t,0.5,6}, 
            AspectRatio -> Automatic,
            PlotRange -> {{-1,3},{-3,3}}];\
\>", "Input",
  AspectRatioFixed->True,
  AnimationCycleOffset->0.0625,
  AnimationCycleRepetitions->Infinity],

Cell["\<\
It looks like a cubic!  Now let is do an implicit plot of the \
polynomial itself.\
\>", "Text"],

Cell["poly[1,-1][x,y]==0", "Input"],

Cell["\<\
ip = ImplicitPlot[poly[1,-1][x,y]==0, {x,-1,3},{y,-3,3},
\tAxesOrigin->{0,0}, PlotPoints->100, PlotStyle->Blue];\
\>", "Input"],

Cell["It looks the same!  But we can superimpose the two graphs.", "Text"],

Cell["Show[{pp,ip}];", "Input"],

Cell[TextData[
"The match is good, but there are some numerical problems \[LongDash] whether \
in the graphics renderings or in the numerical computation of the functions \
it is hard to tell."], "Text"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "Visualizing the ",
  StyleBox["\[WeierstrassP]",
    FontFamily->"Symbol"],
  " function"
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[CellGroupData[{

Cell["The real and the imaginary parts", "Subsubsection",
  Evaluatable->False,
  AspectRatioFixed->True],

Cell[TextData[
"Plot3D[Re[WP[x + I y, 1, -1]],\n\t\t{x,-4, 4},\n\t\t{y,-4, 4},\n\t\t\
PlotPoints -> 63,\n\t\tPlotRange -> {{-4, 4},{-4, 4},{-6,6}},\n\t\tBoxRatios \
-> {4,4,6}];"], "Input",
  AspectRatioFixed->True],

Cell[TextData["Show[%, ViewPoint->{0.000, -0.000, 3.384}];"], "Input",
  AspectRatioFixed->True],

Cell[TextData["Show[%, ViewPoint->{1.104, -1.627, 2.754}];"], "Input",
  AspectRatioFixed->True],

Cell[TextData[
"Plot3D[Re[WP[x + I y, 1, -1]],\n\t\t{x,-1, 1},\n\t\t{y,-1, 1},\n\t\t\
PlotPoints -> 31,\n\t\tPlotRange -> {{-1, 1},{-1, 1},{-8,8}},\n\t\tBoxRatios \
-> {1,1,8}];"], "Input",
  AspectRatioFixed->True],

Cell[TextData[
"ContourPlot[Re[WP[x + I y, 1, -1]],\n\t\t{x,-1, 1},{y,-1, 1},\n\t\tContours \
-> 16,\n\t\tPlotPoints -> 32];"], "Input",
  AspectRatioFixed->True],

Cell[TextData[
"ContourPlot[Re[WP[x + I y, 1, -1]],\n\t\t{x,-0.1, 0.1},{y,-0.1, 0.1},\n\t\t\
Contours -> 10,\n\t\tPlotPoints -> 32];"], "Input",
  AspectRatioFixed->True],

Cell[TextData[
"Plot3D[Im[WP[x + I y, 1, -1]],\n\t\t{x,-4, 4},\n\t\t{y,-4, 4},\n\t\t\
