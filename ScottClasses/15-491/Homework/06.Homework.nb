Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  Can you find matrix representations of the general form of \
transformations that do the following?\n",
  StyleBox["\t(a)",
    FontWeight->"Bold"],
  " Leave the points ",
  StyleBox["u",
    FontWeight->"Bold"],
  ", ",
  StyleBox["v",
    FontWeight->"Bold"],
  ", and ",
  StyleBox["w",
    FontWeight->"Bold"],
  " fixed.\n\t",
  StyleBox["(b)",
    FontWeight->"Bold"],
  " Leave the points ",
  StyleBox["u",
    FontWeight->"Bold"],
  " and ",
  StyleBox["v",
    FontWeight->"Bold"],
  " fixed.\n\t",
  StyleBox["(c)",
    FontWeight->"Bold"],
  " Leave the point ",
  StyleBox["u",
    FontWeight->"Bold"],
  " fixed.\n\t",
  StyleBox["(d)",
    FontWeight->"Bold"],
  " Leave the line ",
  StyleBox["x+y+z",
    FontWeight->"Bold"],
  " fixed.  (And is there a pretty answer?)\n\t",
  StyleBox["(e)",
    FontWeight->"Bold"],
  " Leave ",
  StyleBox["all the points",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " on the line ",
  StyleBox["x+y+z",
    FontWeight->"Bold"],
  " fixed."
}], "Text",
  Evaluatable->False,
  AspectRatioFixed->False,
  Background->RGBColor[0, 1, 1]]
}, Closed]],

