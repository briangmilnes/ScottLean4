Cell[TextData[{
  "Question 2.",
  StyleBox["  Given a (long) list of forms representing ",
    FontWeight->"Plain"],
  StyleBox["distinct points",
    FontSlant->"Italic"],
  StyleBox[
  ", how do we get the (probably longer) list of forms representing ",
    FontWeight->"Plain"],
  StyleBox[
  "all the lines joining all pairs of points, but without repetitions?",
    FontSlant->"Italic"],
  StyleBox["  Call the procedure ",
    FontWeight->"Plain"],
  StyleBox["JoinPoints", "InlineInput"],
  StyleBox[".  \nBe sure to ",
    FontWeight->"Plain"],
  StyleBox["test",
    FontSlant->"Italic"],
  StyleBox[" your programs.",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Extra Credit.  ",
    FontWeight->"Bold"],
  StyleBox["And how would we know whether ",
    FontWeight->"Plain"],
  StyleBox["at least one triple of three points",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" in the original list were ",
    FontWeight->"Plain"],
  StyleBox["collinear",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox["?",
    FontSlant->"Italic"]
}], "Text",
  Background->RGBColor[1, 0.700008, 0.700008]],

Cell[TextData[{
  StyleBox["Hints: (1)  ",
    FontWeight->"Bold"],
  StyleBox["Outer[f, list1, list2, ... ]",
    FontFamily->"Courier",
    FontWeight->"Bold"],
  " gives the generalized ",
  StyleBox["outer product",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of the ",
  StyleBox["listi",
    FontFamily->"Courier",
    FontWeight->"Bold"],
  ", forming ",
  StyleBox["all possible combinations",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " with ",
  StyleBox["f",
    FontFamily->"Courier",
    FontWeight->"Bold"],
  " of the elements in each of them.  \n",
  StyleBox["(2) ",
    FontWeight->"Bold"],
  StyleBox["Flatten", "InlineInput",
    FontWeight->"Bold"],
  StyleBox[" ",
    FontWeight->"Bold"],
  "reduces lists of lists to a ",
  StyleBox["simple list",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".\n",
  StyleBox["(2) ",
    FontWeight->"Bold"],
