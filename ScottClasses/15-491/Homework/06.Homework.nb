Cell[CellGroupData[{

Cell[TextData[{
  "2. Projectively equivalent figures ",
  StyleBox["[30 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "The Question  ",
  StyleBox["[30 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question.  ",
    FontWeight->"Bold"],
  "Can you use ",
  StyleBox["matrices",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " to determine which of the following pairs of configurations of points and \
lines ",
  StyleBox["are equivalent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " under a projective transformation?  \nIn case they ",
  StyleBox["are equivalent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", give a matrix for a transformation that maps one into the other.  \nIn \
case they are ",
  StyleBox["not equivalent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", give a reason for your answer."
}], "Text",
  Evaluatable->False,
  AspectRatioFixed->False,
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \(\({cf11, cf12} = {{u, v, w, u + v + w}, {v, w, u + v + w, u}}; \)\)], 
  "Input",
  AspectRatioFixed->False],

Cell[BoxData[
    \(\({cf21, cf22} = {{u, v, w, u + v + w}, {v, w, u + w, u + v + w}}; 
    \)\)], "Input",
  AspectRatioFixed->False],

Cell[BoxData[
    \(\({cf31, 
        cf32} = {{x, x + y, x + y + z, x - y + z}, {2\ x + 3\ y, x - y, z, 
          y}}; \)\)], "Input",
  AspectRatioFixed->False],

Cell[BoxData[
    \(\({cf41, 
        cf42} = {{u, u + v, u + v + w, PE[x - y, x + y]}, {5\ u + w, 
          8\ u - 2\ v + 2\ w, 8\ u - 2\ v + 3\ w, PE[x + 4\ y, x - y]}}; 
    \)\)], "Input",
  AspectRatioFixed->False],

Cell[BoxData[
    \(\({cf51, 
        cf52} = {{PE[u, u + v], PE[u, u + v - w], x - y, x + y}, {
          PE[v, v + w], PE[v, u + 2\ v + 2\ w], \(-y\) + z, 2\ x - y - z}}; 
    \)\)], "Input",
  AspectRatioFixed->False]
}, Closed]],

