Cell[CellGroupData[{

Cell[TextData[{
  "4. Programming checks/constructions  ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.  ",
    FontWeight->"Bold"],
  "Suppose",
  StyleBox[" ",
    FontWeight->"Bold"],
  "I have a ",
  StyleBox["long",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["list of linear forms with numerical coefficients",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " representing ",
  StyleBox["points",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  Call it ",
  StyleBox["list",
    FontWeight->"Bold"],
  ".  I want to check whether any of the forms are either ",
  StyleBox["0",
    FontWeight->"Bold"],
  " or whether two of them represent the ",
  StyleBox["same point",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  If so, I want to ",
  StyleBox["eliminate",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the trivial and redundant forms.  \n",
  StyleBox["Can you write a program ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  Cell[BoxData[
      StyleBox[\(RedP[list_] := \),
        FontWeight->"Bold"]]],
  StyleBox["........  ",
    FontWeight->"Bold"],
  StyleBox["that will do this elimination? ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " \nBe sure to ",
  StyleBox["test",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " your program."
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Extra Credit.  ",
    FontWeight->"Bold"],
  "How could this program be used to check if one set of points was ",
  StyleBox["included",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" ",
    FontSlant->"Italic"],
  "in another?"
}], "Text",
  Background->RGBColor[1, 0.700008, 0.700008]],

Cell[TextData[{
  "Hints.  ",
  StyleBox["(Not all of these need be used.)  \n",
    FontWeight->"Plain"],
  "(1)",
  StyleBox[
  " Don't forget to expand the terms of the list to avoid overlooking trivial \
forms such as this form (which expands to ",
    FontWeight->"Plain"],
  "0",
  StyleBox["):   ",
    FontWeight->"Plain"],
  "-3 u - 3 v + 3 (u+v) ",
  StyleBox[".  \n",
    FontWeight->"Plain"],
  "(2) ",
  StyleBox["The triple-equal exprerssion ",
    FontWeight->"Plain"],
  StyleBox["Expand[pp]===0",
    FontFamily->"Courier"],
  StyleBox[" is the test for being \"formally\" ",
    FontWeight->"Plain"],
  "0",
  StyleBox[".  \n",
    FontWeight->"Plain"],
  "(3) ",
  StyleBox["Select[list,crit]",
    FontFamily->"Courier"],
  StyleBox[" picks out all elements",
    FontWeight->"Plain"],
  " ei ",
  StyleBox["of list for which",
    FontWeight->"Plain"],
  " ",
  StyleBox["crit[ei]",
    FontFamily->"Courier"],
  " ",
  StyleBox["is",
    FontWeight->"Plain"],
  " True.  \n(4) ",
  StyleBox["MemberQ[list,form] ",
    FontFamily->"Courier"],
  StyleBox["returns ",
    FontWeight->"Plain"],
  "True ",
  StyleBox["if an element of ",
    FontWeight->"Plain"],
  StyleBox["list",
    FontFamily->"Courier"],
  StyleBox[" matches",
    FontWeight->"Plain"],
  " ",
  StyleBox["form",
    FontFamily->"Courier"],
  StyleBox[",",
    FontWeight->"Plain"],
  " ",
  StyleBox["and",
    FontWeight->"Plain"],
  " False ",
  StyleBox["otherwise.",
    FontWeight->"Plain"],
  " \n(5)",
  StyleBox["  The ",
    FontWeight->"Plain"],
  StyleBox["Mathematica",
    FontWeight->"Plain",
    FontSlant->"Italic"],
  StyleBox[" command",
    FontWeight->"Plain"],
  StyleBox[" Complement[eall, e1, e2, ... ] ",
    FontFamily->"Courier"],
  StyleBox["gives the elements in",
    FontWeight->"Plain"],
  " eall ",
  StyleBox["which are ",
    FontWeight->"Plain"],
  StyleBox["not",
    FontSlant->"Italic"],
  StyleBox[" in any of the",
    FontWeight->"Plain"],
  " ei.",
  StyleBox["  \n",
    FontWeight->"Plain"],
  "(6)",
  StyleBox["  The test for two forms ",
    FontWeight->"Plain"],
  StyleBox["p1",
    FontFamily->"Courier"],
  " ",
  StyleBox["and ",
    FontWeight->"Plain"],
  StyleBox["p2",
    FontFamily->"Courier"],
  StyleBox[" representing the ",
    FontWeight->"Plain"],
  StyleBox["same point",
    FontSlant->"Italic"],
  StyleBox[" (",
    FontWeight->"Plain"],
  StyleBox["i.e.",
    FontWeight->"Plain",
    FontSlant->"Italic"],
  StyleBox[", being the same up to a common scalar multiple) is that ",
    FontWeight->"Plain"],
  StyleBox["PE[p1,p2]",
    FontFamily->"Courier"],
  StyleBox[" expands to the ",
    FontWeight->"Plain"],
  "0",
  StyleBox[" ",
    FontWeight->"Plain"],
  "xyz",
  StyleBox["-form.  \n",
    FontWeight->"Plain"],
  "(7)",
  StyleBox["  A ",
    FontWeight->"Plain"],
  StyleBox["recursive definition",
    FontSlant->"Italic"],
  StyleBox[" ",
    FontWeight->"Plain",
    FontSlant->"Italic"],
  StyleBox["of ",
    FontWeight->"Plain"],
  "RedP",
  StyleBox[" ",
    FontWeight->"Plain"],
  StyleBox["is acceptable.", "Subsubsection",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold"]
}, Closed]],

