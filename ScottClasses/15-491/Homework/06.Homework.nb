Cell[CellGroupData[{

Cell[TextData[{
  "1. Linear transformations and crossratios ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Let us consider points ",
  Cell[BoxData[
      StyleBox[\(A == a\ u + b\ w\),
        FontWeight->"Bold"]]],
  StyleBox[" ",
    FontWeight->"Bold"],
  "on the ",
  StyleBox["x",
    FontWeight->"Bold"],
  "-axis.  Given a 2x2 matrix ",
  Cell[BoxData[
      StyleBox["M",
        FontWeight->"Bold"]]],
  ", we can define the ",
  StyleBox["linear transformation of points",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " (on this line to other points on the same line) in terms of homogeneous \
coordinates as follows:"
}], "Text"],

Cell[BoxData[
    \(\(L[M_]\)[A_] := 
      Tidy[{A /. {u \[Rule] 1, w \[Rule] 0}, 
            A /. {u \[Rule] 0, w \[Rule] 1}} . M . {u, w}]\)], "Input"],

Cell[TextData[{
  "Question 1.",
  StyleBox["  For the points ",
    FontWeight->"Plain"],
  Cell[BoxData[
      \({a\ u + w, b\ u + w, c\ u + w, d\ u + w}\)]],
  StyleBox[" with the known crossratio ",
    FontWeight->"Plain"],
  Cell[BoxData[
      \(\(\((a - c)\)\ \((b - d)\)\)\/\(\((b - c)\)\ \((a - d)\)\)\)]],
  StyleBox[
  ", can you verify (again) that for an arbitrary linear transformation",
    FontWeight->"Plain"],
  " ",
  StyleBox["of these points with \n\t",
    FontWeight->"Plain"],
  Cell[BoxData[
      \(M = {{m\_11, m\_12}, {m\_21, m\_22}}\)]],
  " \n",
  StyleBox["the cross ratio will be ",
    FontWeight->"Plain"],
  StyleBox["preserved",
    FontSlant->"Italic"],
  StyleBox["?",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell["", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 2.",
  StyleBox[" What linear transformation ",
    FontWeight->"Plain"],
  Cell[BoxData[
      \(L[M]\)]],
  StyleBox[" maps the four points ",
    FontWeight->"Plain"],
  Cell[BoxData[
      \(A\_i\)]],
  StyleBox[" to the four points ",
    FontWeight->"Plain"],
  Cell[BoxData[
      \(B\_i\)]],
  StyleBox[" given below?",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 1]],

Cell[CellGroupData[{

Cell[BoxData[{
    \(ClearAll[a, b, c, d, e, Subscript]; \nA\_1 = 1  u + w; 
    B\_1 = \((e + 1)\)\ u + w; \nA\_2 = 2\ u + w; B\_2 = \((e + 2)\)\ u + w; 
    \nA\_3 = 3\ u + w; B\_3 = \((e + 3)\)\ u + w; \nA\_4 = 4\ u + w; 
    B\_4 = \((e + 4)\)\ u + w; \nRP[A\_1, A\_2, A\_3, A\_4]\), 
    \(RP[B\_1, B\_2, B\_3, B\_4]\)}], "Input"],

Cell[BoxData[
    \(4\/3\)], "Output"],

Cell[BoxData[
    \(4\/3\)], "Output"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell["", "Text"]
}, Closed]],

