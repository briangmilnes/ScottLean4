  StyleBox["?  \nIf not, does that mean that no ",
    FontWeight->"Plain"],
  StyleBox["projective transformation",
    FontSlant->"Italic"],
  StyleBox[" ",
    FontWeight->"Plain",
    FontSlant->"Italic"],
  StyleBox[
  "can move the three points represented by the first triple to the points \
represented by the second triple?",
    FontWeight->"Plain"]
}], "Text",
