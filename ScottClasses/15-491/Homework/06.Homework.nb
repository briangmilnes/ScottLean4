Cell[CellGroupData[{

Cell[TextData[{
  "Question 1",
  " ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 1.  ",
  StyleBox["Thinking of ",
    FontWeight->"Plain"],
  StyleBox["w", "InlineInput"],
  StyleBox[" as the ",
    FontWeight->"Plain"],
  StyleBox["origin",
    FontSlant->"Italic"],
  StyleBox[" and ",
    FontWeight->"Plain"],
  StyleBox["u + w", "InlineInput"],
  StyleBox[" ", "InlineInput",
    FontWeight->"Plain"],
  StyleBox["and ",
    FontWeight->"Plain"],
  StyleBox["v + w", "InlineInput"],
  StyleBox[" as the ",
    FontWeight->"Plain"],
  StyleBox["unit points",
    FontSlant->"Italic"],
  StyleBox[" on the ",
    FontWeight->"Plain"],
  "x",
  StyleBox["-axis and ",
    FontWeight->"Plain"],
  "y",
  StyleBox["-axis, respectively, can you give the ",
    FontWeight->"Plain"],
  StyleBox["projective form",
    FontSlant->"Italic"],
  StyleBox[" for the matrices of the following ",
    FontWeight->"Plain"],
  StyleBox["Euclidean",
    FontSlant->"Italic"],
  StyleBox[" transformations?\n\t",
    FontWeight->"Plain"],
  "(a)",
  StyleBox["  A ",
    FontWeight->"Plain"],
  StyleBox["rotation",
    FontSlant->"Italic"],
  StyleBox[" about the origin through angle ",
    FontWeight->"Plain"],
  "\[CurlyPhi]",
  StyleBox[";\n\t",
    FontWeight->"Plain"],
  "(b)",
  StyleBox[" A ",
    FontWeight->"Plain"],
  StyleBox["reflection",
    FontSlant->"Italic"],
  StyleBox[" about the line ",
    FontWeight->"Plain"],
  Cell[BoxData[
      \(x + y == 0\)]],
  StyleBox[";\n\t",
    FontWeight->"Plain"],
  "(c)",
  StyleBox[" A ",
    FontWeight->"Plain"],
  StyleBox["translation",
    FontSlant->"Italic"],
  StyleBox[" of ",
    FontWeight->"Plain"],
  StyleBox["w", "InlineInput"],
  StyleBox[" to a point ",
    FontWeight->"Plain"],
  Cell[BoxData[
      \(a\ u + b\ v + w\)]],
  StyleBox[".\nIn each case show what happens to a point ",
    FontWeight->"Plain"],
  Cell[BoxData[
      \(c\ u + d\ v\)]],
  " ",
  StyleBox["on the line at infinity.",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

