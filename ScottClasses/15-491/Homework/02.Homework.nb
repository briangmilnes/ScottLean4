Notebook[{
Cell[TextData[{
  "Week 2   Projective Geometry\n",
  StyleBox["Homework 2",
    FontSize->18]
}], "Title",
  Evaluatable->False,
  PageBreakAbove->True,
  AspectRatioFixed->True],

Cell["\[Copyright] Dana Scott 1993/1997/1998", "Text",
  FontWeight->"Bold",
  FontSlant->"Italic"],

Cell[TextData[{
  StyleBox[
  "Copy this notebook and do all work in it\nName the file: \
02.YourUserName.nb\nPlease hand in by ",
    FontSize->12,
    FontWeight->"Bold"],
  StyleBox["Tuesday, 8 September",
    FontSize->12,
    FontWeight->"Bold",
    FontColor->GrayLevel[0]],
  StyleBox[
  " (the day after Labor Day)\nSave it in your subdirectory of\nthe class \
handin directory ",
    FontSize->12,
    FontWeight->"Bold"]
}], "Subsubtitle",
  FontColor->RGBColor[1, 0, 0]],

Cell["Name: ", "Subsubtitle"],

Cell[CellGroupData[{

Cell[TextData[{
  "1. Intersecting curves  ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  The two solutions to the first set of equations are ",
  StyleBox["real numbers",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "; however, the two solutions to the second set of equations involve ",
  StyleBox["complex numbers",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  Can you explain why there is a difference here?"
}], "Text"],

Cell[BoxData[
    \(ExpandAll[Solve[{x\^2 + y\^2 == 4, x - y == 1}, {x, y}]]\)], "Input"],

Cell[BoxData[
    \(ExpandAll[Solve[{x\^2 + y\^2 == 4, x - y == 4}, {x, y}]]\)], "Input"],

Cell[TextData[{
  StyleBox["Hint:",
    FontWeight->"Bold"],
  "  Consider this picture:"
}], "Text"],

Cell[BoxData[
    \(\(ImplicitPlot[{x^2\  + \ y^2\  == \ 4, \ x\  - \ y\  == \ 1, 
        x - y == 4}, \ {x, \(-4\), 6}, {y, \(-6\), 4}]; \)\)], "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2. ",
    FontWeight->"Bold"],
  " Draw pictures to  explain the nature of the following results with \
respect to real and complex numbers."
}], "Text",
  FontWeight->"Plain"],

Cell["Solve[{x^2 + y^2 == 4, x^2 - y^2 == 1}, {x,y}] // ExpandAll", "Input"],

Cell["Solve[{x^2 + y^2 == 4, x^2 - y^2 == 5}, {x,y}] // ExpandAll", "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "2. Inverting lines and circles  ",
  StyleBox["[30 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  " Assume ",
  StyleBox["b",
    FontWeight->"Bold"],
  " is ",
  StyleBox["real",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " and ",
  StyleBox["non negative",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " and ",
  StyleBox["a ",
    FontWeight->"Bold"],
  "is ",
  StyleBox["real",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  As ",
  StyleBox["t",
    FontWeight->"Bold"],
  " varies over the real numbers, show that the complex number ",
  Cell[BoxData[
      StyleBox[
        RowBox[{"a", "+", \(b \(1 - t\^2\)\/\(1 + t\^2\)\), "+", 
          RowBox[{"b", 
            FractionBox[
              RowBox[{"2", " ", "I", " ", 
                StyleBox["t",
                  FontWeight->"Bold"]}], \(1 + t\^2\)]}]}],
        FontWeight->"Bold"]]],
  "traces out a ",
  StyleBox["circle",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " with ",
  StyleBox["radius",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["b",
    FontWeight->"Bold"],
  " and with ",
  StyleBox["center",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " at the (real) point ",
  StyleBox["a",
    FontWeight->"Bold"],
  "."
}], "Text"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Extra Credit ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Extra Credit.",
    FontWeight->"Bold"],
  "  Show that the one point left out in this parameterization is ",
  StyleBox["a-b",
    FontWeight->"Bold"],
  "."
}], "Text"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Extra Credit ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Extra Credit.",
    FontWeight->"Bold"],
  "  Show that if ",
  StyleBox["a",
    FontWeight->"Bold"],
  " is replaced by a ",
  StyleBox["complex number",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", the formula still gives the parameterization of a ",
  StyleBox["circle",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2. ",
    FontWeight->"Bold"],
  " Assume ",
  StyleBox["\[LeftBracketingBar]a\[RightBracketingBar] \[NotEqual] b",
    FontWeight->"Bold"],
  ".  Under the transformation of ",
  StyleBox["inversion",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " with respect to the unit circle, find an ",
  StyleBox["equation",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " for the curve that is the ",
  StyleBox["image",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of the circle of Question 1."
}], "Text"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Extra Credit ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Extra Credit.",
    FontWeight->"Bold"],
  "  What happlens if ",
  StyleBox["\[LeftBracketingBar]a\[RightBracketingBar]==b ",
    FontWeight->"Bold"],
  "?"
}], "Text"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3.",
    FontWeight->"Bold"],
  " Show that the curve of Question 2 is a ",
  StyleBox["circle",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", and find the ",
  StyleBox["center",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " and ",
  StyleBox["radius",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "3. Squaring grids  ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  Explain the first picture in terms of what we see in the second \
picture."
}], "Text"],

Cell[BoxData[{
    \(\(f[z_] := z\^2; \)\), 
    \(\(CartesianMap[f, {\(-1\), 1, 0.1}, {0, 1, 0.1}, 
      PlotRange \[Rule] {{\(-1.1\), 1.1}, {\(-2.1\), 2.1}}]; \)\)}], "Input"],

Cell[BoxData[{
    \(\(f[z_] := z\^2; \)\), 
    \(\(CartesianMap[f, {0, 1, 0.1}, {0, 1, 0.1}, 
      PlotRange \[Rule] {{\(-1.1\), 1.1}, {\(-2.1\), 2.1}}]; \)\)}], "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 2. ",
  StyleBox[
  "Why is the following picture the same as the first picture in Question 1?",
    
    FontWeight->"Plain"]
}], "Text"],

Cell[BoxData[{
    \(\(f[z_] := z\^2; \)\), 
    \(\(CartesianMap[f, {\(-1\), 1, 0.1}, {\(-1\), 1, 0.1}, 
      PlotRange \[Rule] {{\(-1.1\), 1.1}, {\(-2.1\), 2.1}}]; \)\)}], "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3.",
    FontWeight->"Bold"],
  " Explain how and why the magnification factors were entered to get the \
next picture."
}], "Text"],

Cell[BoxData[{
    \(\(f[z_] := z\^2; \)\), 
    \(\(CartesianMap[f, 2 {\(-1\), 1, 0.1}, 2 {0, 1, 0.1}, 
      PlotRange \[Rule] {4 {\(-1.1\), 1.1}, 4 {\(-2.1\), 2.1}}]; \)\)}], 
  "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "4. Polar Coordinates  ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  Explain the relationship between the following two pictures."
}], "Text"],

Cell[BoxData[
    \(f[z_] := z; \n
    PolarMap[f, {1, 2, 0.1}, {0, \(2  \[Pi]\)\/5, 0.05\ \(2  \[Pi]\)\/5}, \n\t
      PlotRange \[Rule] {{\(-4.1\), 4.1}, {\(-4.1\), 4.1}}]; \)], "Input"],

Cell[BoxData[
    \(f[z_] := z\^2; \n
    PolarMap[f, {1, 2, 0.1}, {0, \(2  \[Pi]\)\/5, 0.05\ \(2  \[Pi]\)\/5}, \n\t
      PlotRange \[Rule] {{\(-4.1\), 4.1}, {\(-4.1\), 4.1}}]; \)], "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  " Explain the relationship between the following two pictures."
}], "Text"],

Cell[BoxData[
    \(f[z_] := \((\(-1\)\  + I + z\ 2)\); \n
    PolarMap[f, {0.9, 1, 0.1}, {0, 2  \[Pi], 0.05\ 2  \[Pi]}, \n\t
      PlotRange \[Rule] {{\(-4.1\), 4.1}, {\(-4.1\), 4.1}}]; \)], "Input"],

Cell[BoxData[
    \(f[z_] := \((\(-1\)\  + I + z\ 2)\)\^2; \n
    PolarMap[f, {0.9, 1, 0.1}, {0, 2  \[Pi], 0.05\ 2  \[Pi]}, \n\t
      PlotRange \[Rule] {{\(-9.1\), 9.1}, {\(-12.1\), 4.1}}]; \)], "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3.",
    FontWeight->"Bold"],
  "  Is the image of a circle under the squaring transform ",
  Cell[BoxData[
      StyleBox[\(z \[Rule] z\^2\),
        FontWeight->"Bold"]]],
  " always a circle?  Why?"
}], "Text"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Extra Credit ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Extra Credit. ",
    FontWeight->"Bold"],
  "What ",
  StyleBox["is",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the curve (in ",
  StyleBox["x,y",
    FontWeight->"Bold"],
  "-coordinates) that is the image of the ",
  StyleBox["unit",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["circle",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " under the transform ",
  Cell[BoxData[
      StyleBox[\(z \[Rule] \((\(-1\) + I + z\ 2)\)\^2\),
        FontWeight->"Bold"]]],
  "?"
}], "Text"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"]
}, Closed]]
},
