Cell[CellGroupData[{

Cell[TextData[{
  "1. Intersecting a circle ",
  StyleBox["[30 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.  ",
    FontWeight->"Bold"],
  "Find the ",
  StyleBox["2",
    FontWeight->"Bold"],
  " intersections of the line ",
  Cell[BoxData[
      StyleBox[\(x + 2\ y - 3\ z\),
        FontWeight->"Bold"]]],
  " with the circle ",
  Cell[BoxData[
      StyleBox[\(x\^2 + y\^2 - z\^2\),
        FontWeight->"Bold"]]],
  "."
}], "Text"],

Cell[TextData[{
  StyleBox["Hint.",
    FontWeight->"Bold"],
  "  Use ",
  StyleBox["Solve", "InlineInput"],
  " and a fixed value of ",
  StyleBox["z", "InlineInput"],
  "."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell["", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3.  ",
    FontWeight->"Bold"],
  "Find the ",
  StyleBox["2",
    FontWeight->"Bold"],
  " lines passing through the point  ",
  Cell[BoxData[
      StyleBox[\(2\ u + 3\ v\  + \ w\),
        FontWeight->"Bold"]]],
  " each having only ",
  StyleBox["one intersection ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "with the circle ",
  Cell[BoxData[
      StyleBox[\(x\^2 + y\^2 - z\^2\),
        FontWeight->"Bold"]]],
  ".  (These will be the ",
  StyleBox["tangent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " lines.)"
}], "Text"],

Cell[TextData[{
  StyleBox["Hint.",
    FontWeight->"Bold"],
  "  ",
  StyleBox["Parameterize",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the pencil through the point."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell["", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3.  ",
    FontWeight->"Bold"],
  "Find the ",
  StyleBox["6",
    FontWeight->"Bold"],
  " intersections of the cubic  ",
  Cell[BoxData[
      RowBox[{
        StyleBox[\(x\^3\),
          FontWeight->"Bold"], 
        StyleBox["-",
          FontWeight->"Bold"], 
        StyleBox[\(\(y\^2\) z\),
          FontWeight->"Bold"], 
        StyleBox["+",
          FontWeight->"Bold"], 
        StyleBox[
          SuperscriptBox[
            StyleBox["z",
              FontWeight->"Bold"], "3"],
          FontWeight->"Bold"]}]]],
  StyleBox[" ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "with the circle ",
  Cell[BoxData[
      StyleBox[\(x\^2 + y\^2 - z\^2\),
        FontWeight->"Bold"]]],
  ".   Explain what is happening here."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell["", "Text"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "2. Homogeneous polynomials ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  Without actually ",
  StyleBox["looking at",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the following list of cubic polynomials, make up a test for finding which \
are ",
  StyleBox["homogeneous",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \(\(polys = {x\^3 - y, \ x\^3 - y\ z, \ x\^3 - \(y\^2\) z, \n
        \t\t\ \ \ \ \ \ \ \ \ \ \ \ \ \ \ 
        x \((x + y + z)\) y - \((x - z)\)\^2, 
        \(-x\) \((x + y + z)\) y + \((x - z)\)\^3}; \)\)], "Input"],

Cell[TextData[{
  StyleBox["Hint.",
    FontWeight->"Bold"],
  "  Check out using ",
  StyleBox["CoefficientList", "InlineInput"],
  " and ",
  StyleBox["Position", "InlineInput"],
  "."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell["", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.  ",
    FontWeight->"Bold"],
  "Here is a big polynomial.  Use ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " to write it as a sum of ",
  StyleBox["homogeneous parts",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " (of different degrees).  ",
  StyleBox["Test",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " your answer!"
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \(\(pp = \ \((x + z)\)\^4 - \((x - y - z)\)\^3 + \((z + 2  y + 1)\)\^2; 
    \)\)], "Input"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell["", "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3.",
    FontWeight->"Bold"],
  "  Explain why the following substitution ",
  StyleBox["has to",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " produce a homogeneous polynomial."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
    \(x\^3 + x\ y\ z - y\^2\ z /. {x \[Rule] x\^2 - x\ z, y \[Rule] x\ y, 
          z \[Rule] y\^2 - z\^2} // Expand\)], "Input"],

Cell[BoxData[
    \(x\^6 + x\^3\ y\^3 - x\^2\ y\^4 - 3\ x\^5\ z - x\^2\ y\^3\ z + 
      3\ x\^4\ z\^2 - x\^3\ y\ z\^2 + x\^2\ y\^2\ z\^2 - x\^3\ z\^3 + 
      x\^2\ y\ z\^3\)], "Output"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell["", "Text"]
}, Closed]]
}, Closed]],

