Cell[CellGroupData[{

Cell[TextData[{
  "1. The symmetry of polydifferentiation ",
  StyleBox["[30 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  Assume that ",
  Cell[BoxData[
      StyleBox[\(i\_1 + j\_1 + k\_1 \[GreaterEqual] i\_2 + j\_2 + k\_2\),
        FontWeight->"Bold"]]],
  StyleBox[" ",
    FontWeight->"Bold"],
  " (as the opposite case is analogous).  Find a ",
  StyleBox["general formula",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " for the result of applying ",
  Cell[BoxData[
      StyleBox["PD",
        FontWeight->"Bold"]]],
  " to ",
  StyleBox["monomials",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " that will be more or less of the form\n\t ",
  Cell[BoxData[
      \(PD[x\^i\_1\ y\^j\_1\ z\^k\_1, u\^i\_2\ v\^j\_2\ w\^k\_2] == 
        \(i\_1!\)\ \(j\_1!\)\ \(k\_1!\) (\)], "Input",
    Background->None],
  ".....)."
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Hint.  ",
    FontWeight->"Bold"],
  "Perhaps a ",
  StyleBox["conditional expression",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " is needed as well, in case the answer is ",
  Cell[BoxData[
      StyleBox["0",
        FontWeight->"Bold"]]],
  "."
}], "Text",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2. ",
    FontWeight->"Bold"],
  StyleBox["Verify",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the formula for the cases of ",
  Cell[BoxData[
      StyleBox[\(Bxyz[5]\),
        FontWeight->"Bold"]]],
  StyleBox[" ",
    FontWeight->"Bold"],
  "and ",
  Cell[BoxData[
      StyleBox[\(Buvw[3]\),
        FontWeight->"Bold"]]],
  "."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3.",
    FontWeight->"Bold"],
  " Use the formula to argue again that in computing ",
  Cell[BoxData[
      StyleBox[\(PD[f, g]\),
        FontWeight->"Bold"]]],
  ", when the degrees of the two homogeneous polynomials are ",
  StyleBox["the same",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", it does not matter which polynomial we take as the differential \
operator."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "2. Euler's Theorem ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  " Prove the result in the way it is usually stated: \n",
  StyleBox["Euler's Theorem.",
    FontWeight->"Bold"],
  " For ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " a homogeneous ",
  StyleBox["xyz",
    FontWeight->"Bold"],
  "-polynomial of degree ",
  Cell[BoxData[
      StyleBox["n",
        FontWeight->"Bold"]]],
  ", if ",
  Cell[BoxData[
      StyleBox[\(m \[LessEqual] n\),
        FontWeight->"Bold"]]],
  ", we have\n\t",
  Cell[BoxData[
      StyleBox[
        \(PD[f, \((a\ u + b\ v + c\ w)\)\^m] /. {a \[Rule] x, b \[Rule] y, 
              c \[Rule] z} == \(\(n!\)\ f\)\/\(\((n - m)\)!\)\),
        FontWeight->"Bold"]]],
  "."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  Verify the formula in three special cases."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "3. Leibniz' Rule ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.  ",
    FontWeight->"Bold"],
  "Prove the result that tells us how to differentiate a ",
  StyleBox["product",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " many times by a first-degree operator:\n",
  StyleBox["Leibniz' Theorem",
    FontWeight->"Bold"],
  ".  If ",
  Cell[BoxData[
      StyleBox[\(n \[LessEqual] DegP[f\_1\ f\_2]\),
        FontWeight->"Bold"]]],
  "  and ",
  StyleBox[" ",
    FontWeight->"Bold"],
  Cell[BoxData[
      StyleBox[\(DegP[g] == 1\),
        FontWeight->"Bold"]]],
  ",  then \n",
  Cell[BoxData[
      StyleBox[
        RowBox[{
          RowBox[{"PD", "[", 
            RowBox[{
              RowBox[{
                SubscriptBox[
                  StyleBox["f",
                    FontWeight->"Bold"], "1"], 
                StyleBox[" ",
                  FontWeight->"Bold"], 
                SubscriptBox[
                  StyleBox["f",
                    FontWeight->"Bold"], "2"]}], 
              StyleBox[",",
                FontWeight->"Bold"], 
              StyleBox[\(g\^n\),
                FontWeight->"Bold"]}], "]"}], "==", 
          RowBox[{
          \(\[Sum]\+\(k = Max[0, n - DegP[f\_2]]\)\%\(Min[n, DegP[f\_1]]
                  \)\), 
            RowBox[{
              FormBox[
                TagBox[
                  RowBox[{"(", GridBox[{
                        {"n"},
                        {"k"}
                        }], ")"}],
                  Binomial,
                  Editable->False],
                "TraditionalForm"], 
              RowBox[{"PD", "[", 
                RowBox[{
                  SubscriptBox[
                    StyleBox["f",
                      FontWeight->"Bold"], "1"], 
                  StyleBox[",",
                    FontWeight->"Bold"], 
                  StyleBox[\(g\^k\),
                    FontWeight->"Bold"]}], "]"}], " ", 
              RowBox[{"PD", "[", 
                RowBox[{
                  SubscriptBox[
                    StyleBox["f",
                      FontWeight->"Bold"], "2"], 
                  StyleBox[",",
                    FontWeight->"Bold"], 
                  StyleBox[\(g\^\(n - k\)\),
                    FontWeight->"Bold"]}], "]"}]}]}]}],
        FontWeight->"Bold"]]],
  "."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  Verify the formula in three special cases."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "4. Expressing monomials by powers ",
  StyleBox["[30 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.  ",
    FontWeight->"Bold"],
  "Show that the polynomial ",
  Cell[BoxData[
      StyleBox[\(x\ y\),
        FontWeight->"Bold"]]],
  " is ",
  StyleBox["not",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " a square of any linear ",
  StyleBox["xyz",
    FontWeight->"Bold"],
  "-polynomial, but it is the ",
  StyleBox["sum",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of two squares. "
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Hint.  ",
    FontWeight->"Bold"],
  "Note that the ",
  StyleBox["n",
    FontWeight->"Bold"],
  "th powers of linear polynomials are closed under ",
  StyleBox["scalar multiplication",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ". (Why?)  So in considering vector subspaces generated by ",
  StyleBox["n",
    FontWeight->"Bold"],
  "th powers we can often just think of sums of ",
  StyleBox["n",
    FontWeight->"Bold"],
  "th powers.  So check out",
  Cell[BoxData[
      \(\((x + y)\)\^2 \[PlusMinus] \((x - y)\)\^2\)],
    FontWeight->"Bold"],
  "."
}], "Text",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2  ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.  ",
    FontWeight->"Bold"],
  "Show that the polynomial ",
  Cell[BoxData[
      StyleBox[\(x\ y\ z\),
        FontWeight->"Bold"]]],
  " is ",
  StyleBox["not",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " a cube of any linear ",
  StyleBox["xyz",
    FontWeight->"Bold"],
  "-polynomial, but it is the ",
  StyleBox["sum",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of  ",
  StyleBox["four",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " cubes. "
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Hint.  ",
    FontWeight->"Bold"],
  "Check out",
  Cell[BoxData[
      \(\(\(\((x - y - z)\)\^3 \[PlusMinus] \((x + y - z)\)\^3\) \[PlusMinus] 
          \((x - y + z)\)\^3\) \[PlusMinus] \((x + y + z)\)\^3\)],
    FontWeight->"Bold"],
  "."
}], "Text",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3  ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3.  ",
    FontWeight->"Bold"],
  "Show that the polynomial ",
  Cell[BoxData[
      StyleBox[\(x\ y\ z\),
        FontWeight->"Bold"]]],
  " is ",
  StyleBox["not",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the sum of  ",
  StyleBox["two",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " cubes. "
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Hint.",
    FontWeight->"Bold"],
  "  Two lines intersect at a point."
}], "Text",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]]
},
