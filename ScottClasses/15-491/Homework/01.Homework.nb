Notebook[{
Cell[TextData[{
  "Week 1   Projective Geometry\n",
  StyleBox["Homework 1",
    FontSize->18]
}], "Title",
  Evaluatable->False,
  PageBreakAbove->True,
  AspectRatioFixed->True],

Cell["\[Copyright] Dana Scott 1993/1997/1998", "Text",
  FontWeight->"Bold",
  FontSlant->"Italic"],

Cell[TextData[{
  StyleBox[
  "Copy this notebook and do all work in it\nName the file: 01.Homework.nb\n\
Please hand in by ",
    FontSize->12,
    FontWeight->"Bold"],
  StyleBox["Monday, 31 August",
    FontSize->12,
    FontWeight->"Bold",
    FontColor->GrayLevel[0]],
  StyleBox["\nSave it in your subdirectory of\nthe class handin directory ",
    FontSize->12,
    FontWeight->"Bold"]
}], "Subsubtitle",
  FontColor->RGBColor[1, 0, 0]],

Cell[TextData[{
  "Name: ",
  StyleBox["xxxxxxxxx",
    FontWeight->"Bold"]
}], "Subsubtitle"],

Cell[CellGroupData[{

Cell[TextData[{
  "1. Complex arithmetic  ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 1.",
  StyleBox["  Give an explanation ",
    FontWeight->"Plain"],
  StyleBox["in words",
    FontSlant->"Italic"],
  StyleBox[" of what is seen in the picture.  ",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 0]],

Cell[BoxData[
    \(z = 1\/5\ \((3 + 4\ I)\); \nrr = z\^Range[6]; \nArgandPlot[rr]; \)], 
  "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 2.  ",
  StyleBox["Now explain this picture.  Does the circle ",
    FontWeight->"Plain"],
  StyleBox["\"close up\"",
    FontSlant->"Italic"],
  StyleBox["?",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 0]],

Cell[BoxData[
    \(z = 1\/5\ \((3 + 4\ I)\); \nrr = z\^Range[60]; \nArgandPlot[rr, 7]; 
    \)], "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 3.",
  StyleBox[
  "  Will the coordinates of all those points in the above pictures always be \
",
    FontWeight->"Plain"],
  StyleBox["rational numbers",
    FontSlant->"Italic"],
  StyleBox["?  Why?",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "2. Laws of algebra  ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 1.",
  StyleBox["  If complex numbers were defined simply as ",
    FontWeight->"Plain"],
  StyleBox["ordered pairs",
    FontSlant->"Italic"],
  StyleBox[" of (real) numbers, then ",
    FontWeight->"Plain"],
  StyleBox["multiplication ",
    FontSlant->"Italic"],
  StyleBox["would be defined as follows:",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 0]],

Cell[BoxData[
    \(M[{a_, b_}, {c_, d_}] := {a\ c - b\ d, b\ c + a\ d}\)], "Input"],

Cell[TextData[{
  "Can you explain in words why the following calculation verifies the ",
  StyleBox["Associative Law",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " for multiplication?"
}], "Text",
  Background->RGBColor[0, 1, 0]],

Cell[BoxData[
    \(Expand[M[{a, b}, M[{c, d}, {e, f}]]] == 
      Expand[M[M[{a, b}, {c, d}], {e, f}]]\)], "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question.",
  StyleBox[
  "  What do you have to calculate in the style of Question 1 to verify the ",
    
    FontWeight->"Plain"],
  StyleBox["Distributive Law ",
    FontSlant->"Italic"],
  StyleBox["?",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question.",
  StyleBox["  Can you show the right definition by ordered pairs of the ",
    FontWeight->"Plain"],
  StyleBox["reciprocal ",
    FontSlant->"Italic"],
  StyleBox["?  Will its basic property be ",
    FontWeight->"Plain"],
  StyleBox["verified",
    FontSlant->"Italic"],
  StyleBox["?",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "3. Conjugate roots of polynomials  ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 1.  ",
  StyleBox["Let ",
    FontWeight->"Plain"],
  "f[z]",
  StyleBox[" be a polynomial with ",
    FontWeight->"Plain"],
  StyleBox["real",
    FontSlant->"Italic"],
  StyleBox[" coefficients.  \nExplain why if ",
    FontWeight->"Plain"],
  "r",
  StyleBox[" is a root of the equation ",
    FontWeight->"Plain"],
  "f[z] == 0",
  StyleBox[", then so is ",
    FontWeight->"Plain"],
  "Conjugate[r]",
  StyleBox[".",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 2.",
  StyleBox[" Here is a table of ",
    FontWeight->"Plain"],
  "7",
  StyleBox[" complex numbers:",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 0]],

Cell["\<\
tt = Table[1 + k I, {k,-3,3}]

ArgandPlot[tt, 7];\
\>", "Input"],

Cell["Why does the following polynomial have exactly these roots?", "Text",
  Background->RGBColor[0, 1, 0]],

Cell["\<\
ClearAll[z];
pp = Times@@(z - tt) // Expand

RootPlot[pp == 0, z, 7];\
\>", "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3. ",
    FontWeight->"Bold"],
  "And why did the above polynomial have all ",
  StyleBox["real",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " coefficients?"
}], "Text",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "4. Factorization by roots  ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[TextData[{
  "Background.",
  StyleBox[
  "  It is well known from Advanced Calculus that a well-behaved function ",
    FontWeight->"Plain"],
  "pp[z] of a complex variable ",
  StyleBox["has a ",
    FontWeight->"Plain"],
  StyleBox["Taylor Series Expansion",
    FontSlant->"Italic"],
  StyleBox[", ten terms of which are illustrated here:",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[1, 1, 0]],

Cell["\<\
ClearAll[z,pp];
Series[pp[z], {z, a, 10}]\
\>", "Input"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 1.",
  StyleBox[
  "  Why is it that the higher derivatives of a given polynomial are \
eventually  identically ",
    FontWeight->"Plain"],
  "0",
  StyleBox[
  " from some point on (thus making the series expansions of polynomial \
functions ",
    FontWeight->"Plain"],
  StyleBox["finite",
    FontSlant->"Italic"],
  StyleBox[" and very well behaved)?",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 2.",
  StyleBox[
  "  With reference to the Taylor Series, explain why every polynomial  ",
    FontWeight->"Plain"],
  "pp[z] ",
  StyleBox["can be written in the form\n\t\t\t",
    FontWeight->"Plain"],
  "pp[z] == qq[z] (z - a) + pp[a]",
  StyleBox[",\nwhere ",
    FontWeight->"Plain"],
  "a",
  StyleBox[" is a given (complex) number and where ",
    FontWeight->"Plain"],
  "qq[z]",
  StyleBox[" is another polynomial.",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 3.",
  StyleBox["  Suppose ",
    FontWeight->"Plain"],
  "a",
  StyleBox[", ",
    FontWeight->"Plain"],
  "b",
  StyleBox[", and ",
    FontWeight->"Plain"],
  "c",
  StyleBox[" are ",
    FontWeight->"Plain"],
  StyleBox["distinct",
    FontSlant->"Italic"],
  StyleBox[" ",
    FontWeight->"Plain"],
  StyleBox["roots",
    FontSlant->"Italic"],
  StyleBox[" of a polynomial ",
    FontWeight->"Plain"],
  "pp[z]",
  StyleBox[", then why can we write\n\t\t\t",
    FontWeight->"Plain"],
  "pp[z] == rr[z] (z - a) (z - b) (z - c) ",
  StyleBox[",\nwhere ",
    FontWeight->"Plain"],
  "rr[z]",
  StyleBox[" is another polynomial?  And what is the degree of  ",
    FontWeight->"Plain"],
  "rr[z] ",
  StyleBox["?",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 4 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 4.",
  StyleBox[
  "  Assuming we know that every polynomial has at least one (complex) root, \
why can we conclude that if ",
    FontWeight->"Plain"],
  "pp[z] ",
  StyleBox[" is an ",
    FontWeight->"Plain"],
  StyleBox["nth-degree",
    FontSlant->"Italic"],
  StyleBox[" polynomial, then it can be written in the form:\n\t\t\t",
    FontWeight->"Plain"],
  "pp[z] == c (z - a",
  Cell[BoxData[
      \(TraditionalForm\`\_1\)]],
  ") (z - ",
  Cell[BoxData[
      FormBox[
        SubscriptBox[
          StyleBox["a",
            FontSlant->"Plain"], "2"], TraditionalForm]]],
  ") (z - a",
  Cell[BoxData[
      \(TraditionalForm\`\_3\)]],
  ")  . . . (z - a",
  Cell[BoxData[
      \(TraditionalForm\`\_n\)]],
  ") ",
  StyleBox[",\nwhere ",
    FontWeight->"Plain"],
  "c",
  StyleBox[" is a constant?",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 5 ",
  StyleBox["[extra credit]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 5.",
  StyleBox["  How  ",
    FontWeight->"Plain"],
  StyleBox["unique",
    FontSlant->"Italic"],
  StyleBox[" is the representation \n\t\t\t",
    FontWeight->"Plain"],
  "pp[z] == c (z - a",
  Cell[BoxData[
      \(TraditionalForm\`\_1\)]],
  ") (z - ",
  Cell[BoxData[
      FormBox[
        SubscriptBox[
          StyleBox["a",
            FontSlant->"Plain"], "2"], TraditionalForm]]],
  ") (z - a",
  Cell[BoxData[
      \(TraditionalForm\`\_3\)]],
  ")  . . . (z - a",
  Cell[BoxData[
      \(TraditionalForm\`\_n\)]],
  ") \n",
  StyleBox["of an  ",
    FontWeight->"Plain"],
  StyleBox["n",
    FontSlant->"Italic"],
  StyleBox["th-degree polynomial in terms of its roots?",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection"]
}, Closed]]
},
