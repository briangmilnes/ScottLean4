Cell[CellGroupData[{

Cell["1. Projections and transformations  ", "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.  ",
    FontWeight->"Bold"],
  "Lines are ",
  StyleBox["parallel",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " if they intersect at infinity.  Here are several lines and points:"
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \(l\_1 = x; l\_2 = x - z; l\_3 = x - r\ z; \nP\_1 = p\ v + w; \ \ 
    P\_2 = u + p\ v + w; \nQ\_1 = q\ v + w; \ \ Q\_2 = u + q\ v + w; \n
    m\_1 = PE[P\_1, P\_2]; m\_2 = PE[Q\_1, Q\_2]; \)], "Input"],

Cell[TextData[{
  "Why are the lines ",
  Cell[BoxData[
      RowBox[{
        StyleBox["{",
          FontWeight->"Bold"], 
        StyleBox[\(l\_1, l\_2, l\_3\),
          FontWeight->"Bold"], 
        StyleBox["}",
          FontWeight->"Bold"]}]]],
  " parallel?   On which lines do the points ",
  Cell[BoxData[
      RowBox[{
        StyleBox["{",
          FontWeight->"Bold"], 
        StyleBox[
          RowBox[{
            StyleBox[
              SubscriptBox[
                StyleBox["P",
                  FontWeight->"Bold"], "1"],
              FontWeight->"Bold"], 
            StyleBox[",",
              FontWeight->"Bold"], 
            StyleBox[\(Q\_1\),
              FontWeight->"Bold"], 
            StyleBox[",",
              FontWeight->"Bold"], 
            SubscriptBox[
              StyleBox["P",
                FontWeight->"Bold"], "2"], ",", \(Q\_2\)}],
          FontWeight->"Bold"], 
        StyleBox["}",
          FontWeight->"Bold"]}]]],
  " lie?  What can you say about the lines ",
  Cell[BoxData[
      RowBox[{
        StyleBox["{",
          FontWeight->"Bold"], 
        StyleBox[
          RowBox[{
            SubscriptBox[
              StyleBox["m",
                FontWeight->"Bold"], "1"], 
            StyleBox[",",
              FontWeight->"Bold"], 
            SubscriptBox[
              StyleBox["m",
                FontWeight->"Bold"], "2"]}],
          FontWeight->"Bold"], 
        StyleBox["}",
          FontWeight->"Bold"]}]]],
  "?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.  ",
    FontWeight->"Bold"],
  "Assuming that ",
  Cell[BoxData[
      StyleBox["r",
        FontWeight->"Bold"]]],
  " is different from both ",
  Cell[BoxData[
      StyleBox["0",
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox["1",
        FontWeight->"Bold"]]],
  " and neither ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  " nor ",
  Cell[BoxData[
      StyleBox["q",
        FontWeight->"Bold"]]],
  " is ",
  Cell[BoxData[
      StyleBox["0",
        FontWeight->"Bold"]]],
  ", why do these two transformations define ",
  StyleBox["projective transformations",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of the set of points along the ",
  StyleBox["x",
    FontWeight->"Bold"],
  "-axis onto itself?  Can you give ",
  StyleBox["two",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " reasons? "
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \(F[xx_] := Tidy[PE[PE[PE[PE[xx, P\_1], l\_3], P\_2], y]]; \n
    G[xx_] := Tidy[PE[PE[PE[PE[xx, Q\_1], l\_3], Q\_2], y]]; \)], "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3.  ",
    FontWeight->"Bold"],
  "Can you give ",
  StyleBox["two proofs",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " that the two transformations represent ",
  StyleBox["the same",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " projectivity on the ",
  StyleBox["x",
    FontWeight->"Bold"],
  "-axis?  And what are the ",
  StyleBox["fixed points",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of this projectivity?  Does a ",
  StyleBox["picture",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " help?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell["2. Crossratios  ", "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  " Why ought you to ",
  StyleBox["know",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " what the following locus of points is?  And how do you find its ",
  StyleBox["equation",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "? "
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \(PE[XL[x, y, x - y, s, t], XL[x - y, y - z, x - z, s, t]]\)], "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  Two sets of points are ",
  StyleBox["projectively equivalent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " if there is a projective transformation mapping one onto the other.  How \
can you determine the division of the following ",
  StyleBox["set of sets",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " into ",
  StyleBox["equivalence classes",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?  (And do it!)"
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \({{4\ v, 3\ v - w, 3\ v + w, 9\ v + w}, {6\ v, 4\ v - w, 5\ v + w, 
        24\ v + 3\ w}, {2\ u + 2\ v, u + 2\ v - w, 2\ u + v + w, 
        5\ u + 4\ v + w}, {4\ u + 2\ v, 2\ u + 2\ v - w, 4\ u + v + w, 
        18\ u + 6\ v + 3\ w}, {2\ u + 4\ v, u + 3\ v - w, 2\ u + 3\ v + w, 
        5\ u + 9\ v + w}, {4\ u + 4\ v, 2\ u + 3\ v - w, 4\ u + 3\ v + w, 
        18\ u + 15\ v + 3\ w}, {2\ u + w, u + 2\ w, 2\ u + 2\ w, 
        5\ u + 4\ w}, {2\ u + w, u + 2\ w, 2\ u + 2\ w, 9\ u + 6\ w}}\)], 
  "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell["3. Duality  ", "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  Carefully state the ",
  StyleBox["dual",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of Pascal's Theorem.  Explain as fully as you can why we do not need to \
prove it (having already proved Pascal's Theorem)."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  A (non-degenerate) ",
  StyleBox["quadrangle",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " is a configuration of type ",
  Cell[BoxData[
      StyleBox[\({{4, 3}, {2, 6}}\),
        FontWeight->"Bold"]]],
  " consisting of ",
  StyleBox["4",
    FontWeight->"Bold"],
  " points (no three collinear) and the ",
  StyleBox["6",
    FontWeight->"Bold"],
  " lines (which have to be all distinct) joining them by pairs.  Each of the \
given points lies on ",
  StyleBox["3",
    FontWeight->"Bold"],
  " of the lines, and each of the lines passes through ",
  StyleBox["2",
    FontWeight->"Bold"],
  " of the given points.  \n",
  StyleBox["Dually",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", a ",
  StyleBox["quadrilateral",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " is a configuration of type ",
  Cell[BoxData[
      StyleBox[\({{6, 2}, {3, 4}}\),
        FontWeight->"Bold"]]],
  "consiting of ",
  StyleBox["6",
    FontWeight->"Bold"],
  " points and ",
  StyleBox["4",
    FontWeight->"Bold"],
  " lines ",
  StyleBox[".... (",
    FontWeight->"Bold"],
  "You complete the statement!)  \nUse a conic (or other method) to show \
there is a natural ",
  StyleBox["one-one correspondence",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " between all quadrangles and all quadrilaterals.  \nArgue, then, that if \
one quadrangle had ",
  StyleBox["collinear",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["diagonal",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["points",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " you could immediately find a quadrilateral with ",
  StyleBox["concurrent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["diagonals",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  \nBut does such a quadrangle ",
  StyleBox["exist",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell["4. Conics and conjugate points  ", "Subsection",
