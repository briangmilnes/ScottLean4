Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.  ",
    FontWeight->"Bold"],
  "Prove that if the ",
