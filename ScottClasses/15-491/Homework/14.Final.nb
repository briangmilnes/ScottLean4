Cell[TextData[{
  StyleBox["Question 1.  ",
    FontWeight->"Bold"],
  "Prove that in general there is ",
  StyleBox["one",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " conic passing through  ",
  StyleBox["four",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" ",
    FontSlant->"Italic"],
  StyleBox["given",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" ",
    FontSlant->"Italic"],
  StyleBox["points",
    FontWeight->"Bold",
    FontSlant->"Italic"],
