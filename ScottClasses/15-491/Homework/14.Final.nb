Cell[TextData[{
  "What is the ",
  StyleBox["homogeneous",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["xyz",
    FontWeight->"Bold"],
  "-polynomial representing this curve?  What is the ",
  StyleBox["multiplicity",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of the curve at the origin?  What are the ",
  StyleBox["tangents",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " at the origin?  Does the curve have any other ",
  StyleBox["multiple points",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  Find a ",
  StyleBox["homogeneous parameterization",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      StyleBox[\(pt[s, t]\),
        FontWeight->"Bold"]]],
  " of the points on the curve, and use it to find ",
  StyleBox["all",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the points on the curve having ",
  StyleBox["vertical",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["tangents",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " (= passing through ",
  Cell[BoxData[
      StyleBox["v",
        FontWeight->"Bold"]]],
  ").  Check you have the ",
  StyleBox["right number",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " by finding the dual polynomial for the ",
  StyleBox["envelope",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of the curve."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell["9. Inflections of a cubic  ", "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  Consider the cubic ",
  Cell[BoxData[
      StyleBox[\(z\^3 - d\ x\ y \((x + y + z)\)\),
        FontWeight->"Bold"]]],
  ".  Verify it has these inflection points ",
  StyleBox["at infinity:",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      StyleBox[\({u, v, u - v}\),
        FontWeight->"Bold"]]],
  " no matter what the value of ",
  Cell[BoxData[
      StyleBox["d",
        FontWeight->"Bold"]]],
  ".  Where are the ",
  StyleBox["other",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " inflection points when ",
  Cell[BoxData[
      StyleBox[\(d == 12\),
        FontWeight->"Bold"]]],
  "?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  For what value of ",
  Cell[BoxData[
      StyleBox["d",
        FontWeight->"Bold"]]],
  " is the cubic ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["singular",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " but ",
  StyleBox["non degenerate",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?  ",
  StyleBox["Find",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the double point in that case.  Draw a ",
  StyleBox["picture",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  Discuss why you cannot ",
  StyleBox["see",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the double point."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell["10. Conic tangents and poles  ", "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  Suppose ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox["g",
        FontWeight->"Bold"]]],
  " represent two ",
  StyleBox["conics",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  As a ",
  StyleBox["tangent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " moves around the curve ",
  Cell[BoxData[
      StyleBox[\(f == 0\),
        FontWeight->"Bold"]]],
  ", it has a ",
  StyleBox["pole",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " with respect to the conic ",
  Cell[BoxData[
      StyleBox[\(g == 0\),
        FontWeight->"Bold"]]],
  ".  The moving pole traces out a curve.  What ",
  StyleBox["kind",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of curve is this?  Give a ",
  StyleBox["proof",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " for your assertion."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  Here below are two conics.  ",
  StyleBox["Find",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the polynomial for the curve described in Question 1 and draw a ",
  StyleBox["picture",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \(f = x\^2 + y\^2 - z\^2; \n
    g = \((x - 2  z)\)\^2 + 2\ \((y - 2  z)\)\^2 - 3  z\^2; \)], "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell["11. Euclidean transformations  ", "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  By using the formulae developed in lectures, prove that the ",
  StyleBox["composition",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of two reflections about ",
  StyleBox["parallel axes",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " is a ",
  StyleBox["translation",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  Prove additionally that if the axes are ",
  StyleBox["not",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " parallel, the composition is a ",
  StyleBox["rotation",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  (In the second case, let the axes intersect at the origin.)"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  Refer to the definition given in lectures of a ",
  StyleBox["parabola",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " and its ",
  StyleBox["focus",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  Argue that Euclidean transformations ",
  StyleBox["must",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " map parabolas to parabolas and take the focus of  one to the focus of the \
image.  Check this out in a special case ",
  StyleBox["by computation",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
