Cell["5. Polarity of perspective triangles  ", "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.  ",
    FontWeight->"Bold"],
  StyleBox["Prove that if two triangles are in "],
  StyleBox["perspective",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[", then there is a conic such that the "],
  StyleBox["polars of the vertices",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" of either triangle are the "],
  StyleBox["corresponding sides",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" of the other.  Moreover, the "],
  StyleBox["center",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" of the perspectivity is the "],
  StyleBox["pole",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" ",
    FontWeight->"Bold"],
  StyleBox["of the axis of perspectivity."]
}], "Text",
  Evaluatable->False,
  AspectRatioFixed->False,
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
