  "Question 2 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.  ",
    FontWeight->"Bold"],
  "Deduce that if two quadrangles have the ",
  StyleBox["same diagonal triangle",
    FontWeight->"Bold",
    FontSlant->"Italic"],
