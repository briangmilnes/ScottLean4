Cell[TextData[{
  "Question 2 ",
  StyleBox["[20 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2. ",
    FontWeight->"Bold"],
