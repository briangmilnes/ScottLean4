  FontSlant->"Italic"],

Cell[TextData[{
  StyleBox[
  "Copy this notebook and do all work in it\nName the file: 03.Homework.nb\n\
Please hand in by ",
    FontSize->12,
    FontWeight->"Bold"],
  StyleBox["Monday, 14 September",
    FontSize->12,
    FontWeight->"Bold",
    FontColor->GrayLevel[0]],
  StyleBox[" \nSave it in your subdirectory of\nthe class handin directory ",
    FontSize->12,
    FontWeight->"Bold"]
}], "Subsubtitle",
  FontColor->RGBColor[1, 0, 0]],

Cell["Name: xxxxxxxxx", "Subsubtitle"],

Cell[CellGroupData[{

Cell[TextData[{
  "1. Areas of polygons ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  Can you find a neat formula for the ",
  StyleBox["area",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of a general quadralateral?"
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell["Here is an example to think about:", "Text"],

Cell[BoxData[
    \({AA, BB, CC, DD} = {{5, 1}, {7, 4}, {2, 7}, {1, 2}}\)], "Input"],

Cell[BoxData[
    \(\(Show[
      Graphics[{AbsoluteThickness[2.1], \n\t\t\tLine[{{0, 0}, {5, 1}}], \n
          \t\t\tLine[{{0, 0}, {7, 4}}], \n\t\t\tLine[{{0, 0}, {2, 7}}], \n
          \t\t\tLine[{{0, 0}, {1, 2}}]}], \n\t
      Graphics[{AbsoluteThickness[2.1], RGBColor[1, 0, 0], 
          Line[{{5, 1}, {7, 4}, {2, 7}, {1, 2}, {5, 1}}]}], \n\t
      Graphics[{AbsolutePointSize[8], Point[{5, 1}], 
          Text["\<AA\>", {5 +  .55, 1 -  .25}]}], \n\t
      Graphics[{AbsolutePointSize[8], Point[{7, 4}], 
          Text["\<BB\>", {7 +  .55, 4 +  .25}]}], \n\t
      Graphics[{AbsolutePointSize[8], Point[{2, 7}], 
          Text["\<CC\>", {2 -  .55, 7 +  .25}]}], \n\t
      Graphics[{AbsolutePointSize[8], Point[{1, 2}], 
          Text["\<DD\>", {1.55, 2.25}]}], \n\tAxes \[Rule] Automatic, \n\t
      AspectRatio \[Rule] Automatic, \n\tPlotRange \[Rule] {{0, 8}, {0, 8}}]; 
    \)\)], "Input",
  FontSize->12]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.  ",
    FontWeight->"Bold"],
  "After finding a formula you are satisfied with, can you then ",
  StyleBox["interpret it",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " geometrically with respect to a quadralateral such as the following?"
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \({AA, BB, CC, DD} = {{5, 1}, {7, 4}, {1, 2}, {2, 7}}\)], "Input"],

Cell[BoxData[
    \(\(Show[
      Graphics[{AbsoluteThickness[2.1], \n\t\t\tLine[{{0, 0}, {5, 1}}], \n
          \t\t\tLine[{{0, 0}, {7, 4}}], \n\t\t\tLine[{{0, 0}, {2, 7}}], \n
          \t\t\tLine[{{0, 0}, {1, 2}}]}], \n\t
      Graphics[{AbsoluteThickness[2.1], RGBColor[1, 0, 0], 
          Line[{{5, 1}, {7, 4}, {1, 2}, {2, 7}, {5, 1}}]}], \n\t
      Graphics[{AbsolutePointSize[8], Point[{5, 1}], 
          Text["\<AA\>", {5 +  .55, 1 -  .25}]}], \n\t
      Graphics[{AbsolutePointSize[8], Point[{7, 4}], 
          Text["\<BB\>", {7 +  .55, 4 +  .25}]}], \n\t
      Graphics[{AbsolutePointSize[8], Point[{1, 2}], 
          Text["\<CC\>", {1.55, 2.25}]}], \n\t
      Graphics[{AbsolutePointSize[8], Point[{2, 7}], 
          Text["\<DD\>", {2 -  .55, 7 +  .25}]}], \n\tAxes \[Rule] Automatic, 
      \n\tAspectRatio \[Rule] Automatic, \n\t
      PlotRange \[Rule] {{0, 8}, {0, 8}}]; \)\)], "Input",
  FontSize->12]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "2. Projective points and lines ",
  StyleBox["[45 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  " Are the following four projective points collinear?  If so, on which line \
do they lie?  If not, how many lines join these points?"
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell["\<\
p1 = 3 u - 2 v - 2 w;
p2 = 3 u - v + 11 w;
p3 = u - v - 5 w;
p4 = 3 u + 2 v - w;\
\>", "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  " Is it possible to express every  point on the projective line through the \
two distinct projective points  ",
  Cell[BoxData[
      StyleBox[\(point\_1\),
        FontWeight->"Bold"]]],
  " ,  ",
  Cell[BoxData[
      StyleBox[\(point\_2\),
        FontWeight->"Bold"]]],
  "  in the form \n                       ",
  Cell[BoxData[
      StyleBox[\(\((1 - t)\)\ point\_1 + t\ point\_2\),
        FontWeight->"Bold"]]],
  ", \nfor some  ",
  StyleBox["t", "InlineInput"],
  " ?  \nIf not, which are the ",
  StyleBox["\"inexpressible\"",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " points on this line?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3. ",
    FontWeight->"Bold"],
  " Consider the three lines\n",
  StyleBox["\t",
    FontWeight->"Bold"],
  Cell[BoxData[
      StyleBox[\(L1 = 3\ x - 2\ y\),
        FontWeight->"Bold"]]],
  StyleBox[";\n\t",
    FontWeight->"Bold"],
  Cell[BoxData[
      StyleBox[\(L2 = x - y + 2\ z\),
        FontWeight->"Bold"]]],
  StyleBox[";\n\t",
    FontWeight->"Bold"],
  Cell[BoxData[
      StyleBox[\(L3 = 3\ x - y + a\ z\),
        FontWeight->"Bold"]]],
  StyleBox[";\n",
    FontWeight->"Bold"],
  "Can we find the value of parameter  ",
  StyleBox["a", "InlineInput",
    FontWeight->"Bold"],
  "  such that the lines  ",
  StyleBox["L1", "InlineInput",
    FontWeight->"Bold"],
  ",  ",
  StyleBox["L2", "InlineInput",
    FontWeight->"Bold"],
  "  and  ",
  StyleBox["L3", "InlineInput",
    FontWeight->"Bold"],
  "  are ",
  StyleBox["concurrent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ? "
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "3. Projections between lines  ",
  StyleBox["[30 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 1.",
  StyleBox["  Choose a",
    FontWeight->"Plain"],
  " ",
  StyleBox["center",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      \(a\ u + b\ v + c\ w\)]],
  ".  ",
  StyleBox["Note that the points on the",
    FontWeight->"Plain"],
  " ",
  StyleBox["y",
    FontWeight->"Bold"],
  "-",
  StyleBox["axis",
    FontWeight->"Plain"],
  " ",
  StyleBox["have",
    FontWeight->"Plain"],
  " ",
  StyleBox["the form ",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      \(d\ v + e\ w\)]],
  ".  ",
  StyleBox["What is the ",
    FontWeight->"Plain"],
  StyleBox["formula",
    FontSlant->"Italic"],
  StyleBox[" for the result of projecting the point ",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      \(d\ v + e\ w\)]],
  StyleBox[" onto the ",
    FontWeight->"Plain"],
  "x",
  StyleBox["-axis ",
    FontWeight->"Plain"],
  StyleBox["via",
    FontSlant->"Italic"],
  StyleBox[" the given center?",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 2.",
  StyleBox["  Choose",
    FontWeight->"Plain"],
  " ",
  StyleBox["another",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["center",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      \(a\_1\ u + b\_1\ v + c\_1\ w\)]],
  ".  ",
  StyleBox["What is the ",
    FontWeight->"Plain"],
  StyleBox["formula",
    FontSlant->"Italic"],
  StyleBox[" for the result of projecting ",
    FontWeight->"Plain"],
  StyleBox["back",
    FontSlant->"Italic"],
  StyleBox[" onto the ",
    FontWeight->"Plain"],
  "y",
  StyleBox["-axis via the new center?",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]]
