Notebook[{
Cell[TextData[{
  "Week 12   Projective Geometry\n",
  StyleBox["Homework",
    FontSize->18]
}], "Title",
  Evaluatable->False,
  PageBreakAbove->True,
  AspectRatioFixed->True],

Cell["\[Copyright] Dana Scott 1993/1997/1998", "Text",
  FontWeight->"Bold",
  FontSlant->"Italic"],

Cell[TextData[{
  StyleBox[
  "Copy this notebook and do all work in it.\nName the file: \
12.yourlastname.nb\nPlease hand in by ",
    FontSize->12,
    FontWeight->"Bold"],
  StyleBox["Monday, 16 November",
    FontSize->12,
    FontWeight->"Bold",
    FontColor->GrayLevel[0]],
  StyleBox[".\nSave it in your subdirectory of\nthe class handin directory.",
    FontSize->12,
    FontWeight->"Bold"]
}], "Subsubtitle",
  FontColor->RGBColor[1, 0, 0]],

Cell[TextData[StyleBox["Name: xxxxxxxxx",
  FontSize->16]], "Subsubtitle"],

Cell[CellGroupData[{

Cell[TextData[{
  "1. Degeneracy and singularity ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question",
    FontWeight->"Bold"],
  "  Which of the following cubics are ",
  StyleBox["degenerate",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " or ",
  StyleBox["singular",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", and why?\n\t",
  StyleBox["(1)",
    FontWeight->"Bold"],
  " ",
  Cell[BoxData[
      StyleBox[\(\((x + y + z)\)\^3\),
        FontWeight->"Bold"]]],
  "\n\t",
  StyleBox["(2) ",
    FontWeight->"Bold"],
  Cell[BoxData[
      RowBox[{
        StyleBox[\(\((x + y)\)\^3\),
          FontWeight->"Bold"], 
        StyleBox["+",
          FontWeight->"Bold"], 
        StyleBox[\(z\^3\),
          FontWeight->"Bold"]}]]],
  "\n\t",
  StyleBox["(3)",
    FontWeight->"Bold"],
  "  ",
  Cell[BoxData[
      StyleBox[
        RowBox[{\(x\^3\), "+", 
          SuperscriptBox[
            StyleBox["y",
              FontWeight->"Bold"], "3"], "+", 
          SuperscriptBox[
            StyleBox["z",
              FontWeight->"Bold"], "3"]}],
        FontWeight->"Bold"]]],
  "\n\t",
  StyleBox["(4)",
    FontWeight->"Bold"],
  "  ",
  Cell[BoxData[
      StyleBox[\(y\^3 + x\^2\ z + 2\ y\^2\ z + y\ z\^2\),
        FontWeight->"Bold"]]],
  "\n\t",
  StyleBox["(5)",
    FontWeight->"Bold"],
  "  ",
  Cell[BoxData[
      StyleBox[\(z\^3 + x\ y\^2\),
        FontWeight->"Bold"]]]
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "2. A pencil of cubics ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  The pencil of cubics can be based on degenerate cubics, for example, \
consider ",
  Cell[BoxData[
      StyleBox[\(s\ x\ y\ z + t\ \((x - y)\) \((x\^2 + y\^2 - z\^2)\)\),
        FontWeight->"Bold"]]],
  ".  Can you find ",
  Cell[BoxData[
      StyleBox["8",
        FontWeight->"Bold"]]],
  " points common to ",
  StyleBox["all",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " these cubics?  Why can you ",
  StyleBox["not",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " find ",
  Cell[BoxData[
      StyleBox["9",
        FontWeight->"Bold"]]],
  "?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2. ",
    FontWeight->"Bold"],
  " Are there ",
  StyleBox["non-degenerate and non-singular",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " cubics in this pencil?  Aside from all passing through the ",
  Cell[BoxData[
      StyleBox["8",
        FontWeight->"Bold"]]],
  " points, do they share ",
  StyleBox["any other feature",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "3. Inflection points ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  Find the three ",
  StyleBox["real",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " inflection points of the cubic ",
  Cell[BoxData[
      StyleBox[\(x\ y\^2 + y\ z\^2 + z\ x\^2\),
        FontWeight->"Bold"]]],
  "."
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Hint.",
    FontWeight->"Bold"],
  "  If you try to solve algebraic equations, then maybe ",
  Cell[BoxData[
      StyleBox["ComplexSimplify",
        FontWeight->"Bold"]]],
  " will put the answers in a more readable form."
}], "Text",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  What about the ",
  StyleBox["other six",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " inflection points?"
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Hint.",
    FontWeight->"Bold"],
  "  Only look at them ",
  StyleBox["numerically",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "4. Conic polars of a cubic ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1  ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Definition.",
    FontWeight->"Bold"],
  "  Given a cubic ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " and a point ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  ", the ",
  StyleBox["conic polar ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "of ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  " relative to ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " is the conic ",
  Cell[BoxData[
      StyleBox[\(PD[f, p]\),
        FontWeight->"Bold"]]],
  "."
}], "Text",
  Background->RGBColor[1, 1, 0]],

Cell[TextData[{
  StyleBox["Question 1.  ",
    FontWeight->"Bold"],
  "Three questions:",
  StyleBox["\n(1) ",
    FontWeight->"Bold"],
  "Why is the conic polar of a nd cubic (= ",
  StyleBox["non-degenerate cubic",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ") always ",
  StyleBox["well defined",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?",
  StyleBox["\n(2) ",
    FontWeight->"Bold"],
  "Is ",
  StyleBox["every",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " nd conic the conic polar of ",
  StyleBox["some",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " point with respect to ",
  StyleBox["some",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " nd cubic?",
  StyleBox["\n(3)",
    FontWeight->"Bold"],
  " ",
  StyleBox["Fix",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " a nd cubic.  Is ",
  StyleBox["every",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " nd conic the conic polar of ",
  StyleBox["some",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " point with respect to ",
  StyleBox["this",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " cubic?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2  ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.  ",
    FontWeight->"Bold"],
  StyleBox["Fix",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " a ",
  StyleBox["pencil",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " generated by two nd cubics.  Is ",
  StyleBox["every",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " conic the conic ",
  StyleBox["polar",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of some point with respect to ",
  StyleBox["some",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " cubic in this pencil?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]]
