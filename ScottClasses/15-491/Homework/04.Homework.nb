Notebook[{
Cell[TextData[{
  "Week 4   Projective Geometry\n",
  StyleBox["Homework 4",
    FontSize->18]
}], "Title",
  Evaluatable->False,
  PageBreakAbove->True,
  AspectRatioFixed->True],

Cell["\[Copyright] Dana Scott 1993/1997/1998", "Text",
  FontWeight->"Bold",
  FontSlant->"Italic"],

Cell[TextData[{
  StyleBox[
  "Copy this notebook and do all work in it\nName the file: 03.Homework.nb\n\
Please hand in by ",
    FontSize->12,
    FontWeight->"Bold"],
  StyleBox["Monday, 21 September",
    FontSize->12,
    FontWeight->"Bold",
    FontColor->GrayLevel[0]],
  StyleBox[" \nSave it in your subdirectory of\nthe class handin directory ",
    FontSize->12,
    FontWeight->"Bold"]
}], "Subsubtitle",
  FontColor->RGBColor[1, 0, 0]],

Cell["Name: xxxxxxxxx", "Subsubtitle"],

Cell[CellGroupData[{

Cell[TextData[{
  "1. Dualizing Desargues and Pappus  ",
  StyleBox["[25points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  " Explain ",
  StyleBox["in words",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " how you would prove that if two triangles have ",
  StyleBox["the intersections of corresponding sides",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["collinear",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", then the joins of the corresponding vertices are ",
  StyleBox["concurrent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Hint: ",
    FontWeight->"Bold"],
  "A triangle is given either by three ",
  StyleBox["vertices",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " (and the ",
  StyleBox["sides",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " are the joins of the pairs of vertices), or ",
  StyleBox["dually",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " by three ",
  StyleBox["sides",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " (and the ",
  StyleBox["vertices",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" ",
    FontSlant->"Italic"],
  "are the meets of pairs of sides). "
}], "Text"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  " How do you ",
  StyleBox["formulate",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the dual of ",
  StyleBox["Pappus' Theorem",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?  Does it need a ",
  StyleBox["separate proof",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "2. Harmony and triangles  ",
  StyleBox["[20points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1. ",
    FontWeight->"Bold"],
  " Consider the triangle ",
  Cell[BoxData[
      StyleBox[\({u, v, w}\),
        FontWeight->"Bold"]]],
  ".  Let ",
  Cell[BoxData[
      StyleBox[\(X == a\ u + b\ v + c\ w\),
        FontWeight->"Bold"]]],
  " be a point ",
  StyleBox["not on",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " any of the sides of the triangle (which means none of ",
  StyleBox["a", "InlineInput"],
  ", ",
  StyleBox["b", "InlineInput"],
  ", and ",
  StyleBox["c", "InlineInput"],
  " are ",
  StyleBox["0", "InlineInput"],
  ").  Join each of the vertices to ",
  StyleBox["X", "InlineInput"],
  ", and then intersect those lines with the sides of the given triangle, \
forming a  ",
  StyleBox["new triangle",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      StyleBox[\({U\_1, V\_1, W\_1}\),
        FontWeight->"Bold"]]],
  ".  Here is the computation:"
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \({U\_1, V\_1, W\_1, X, U\_2, V\_2, W\_2, P\_u, P\_v, P\_w}\)], "Input"],

Cell[BoxData[{
    \(ClearAll[a, b, c]; \nX = \ a\ u + b\ v + c\ w; \n
    U\_1 = PE[PE[u, X], PE[v, w]]\), 
    \(V\_1 = PE[PE[v, X], PE[w, u]]\), 
    \(W\_1 = PE[PE[w, X], PE[u, v]]\)}], "Input"],

Cell[TextData[{
  "Next, find the intersections of the ",
  StyleBox["corresponding sides",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of the triangles.  Here is the computation:"
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[{
    \(U\_2 = PE[PE[v, w], PE[V\_1, W\_1]]\), 
    \(V\_2 = PE[PE[w, u], PE[W\_1, U\_1]]\), 
    \(W\_2 = PE[PE[u, v], PE[U\_1, V\_1]]\)}], "Input"],

Cell[TextData[{
  "Prove by ",
  StyleBox["(a)",
    FontWeight->"Bold"],
  " symbolic computation and also by ",
  StyleBox["(b)",
    FontWeight->"Bold"],
  " reasoning from a previous theorem that the points ",
  Cell[BoxData[
      StyleBox[\({U\_2, V\_2, W\_2}\),
        FontWeight->"Bold"]]],
  " are ",
  StyleBox["collinear",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  " Does the line found in Question 1 ",
  StyleBox["pass through",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " any of the other named points in the configuration?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3. ",
    FontWeight->"Bold"],
  "Here is a picture of a typical case of the configuration \[LongDash] once \
the line at infinity is made visible.  Find  as many cases of ",
  StyleBox["  ",
    FontSlant->"Italic"],
  StyleBox["harmonic separation ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "among the named points as you can. (The points ",
  Cell[BoxData[
      StyleBox[\({u, v, w}\),
        FontWeight->"Bold"]]],
  " have been renamed to make them more visible in the picture.)"
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \(a = \(-1\); b = \(-2\); c = 3; \n
    Draw[{x, y, 
        z, {u, \*"\"\<\!\(P\_u\)\>\""}, {v, \*"\"\<\!\(P\_v\)\>\""}, {w, 
          \*"\"\<\!\(P\_w\)\>\""}, {X, "\<X\>"}, {U\_1, 
          \*"\"\<\!\(U\_1\)\>\""}, {V\_1, \*"\"\<\!\(V\_1\)\>\""}, {W\_1, 
          \*"\"\<\!\(W\_1\)\>\""}, \n
        \t\t{U\_2, \*"\"\<\!\(U\_2\)\>\""}, {V\_2, \*"\"\<\!\(V\_2\)\>\""}, {
          W\_2, \*"\"\<\!\(W\_2\)\>\""}, \n\t\tPE[u, X], PE[v, X], PE[w, X], 
        \n\t\tPE[V\_1, W\_1], PE[W\_1, U\_1], PE[U\_1, V\_1], \n\ \ \t
        PE[U\_2, V\_2]}, \nTo \[Rule] {w, u + w, v + w, 5  x - \ y - 3\ z}]; 
    \nClearAll[a, b, c]; \)], "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "3. Discover a theorem yourself  ",
  StyleBox["[30points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  Here are six points giving an instance of ",
  StyleBox["Pappus\[CloseCurlyQuote] Theorem",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ":"
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \(ClearAll[
      Subscript]; {A\_1, A\_2, A\_3} = {\(-u\) + w, 2\ u + w, 4\ u + w}; {
        B\_1, B\_2, B\_3} = {\(-v\) + w, 3\ v + w, 4\ v + w}; \n\n
    Draw[{A\_1, A\_2, A\_3, B\_1, B\_2, B\_3, x, y}]; \)], "Input"],

Cell[TextData[{
  "There are, however, ",
  StyleBox["six",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " possible hexagons depending in the ",
  StyleBox["order",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" ",
    FontSlant->"Italic"],
  "in which we join the points."
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \(hex\_1 = {A\_1, B\_2, A\_2, B\_1, A\_3, B\_3, A\_1}; \n
    hex\_2 = {A\_1, B\_2, A\_3, B\_1, A\_2, B\_3, A\_1}; \n
    hex\_3 = {A\_1, B\_1, A\_2, B\_2, A\_3, B\_3, A\_1}; \n
    hex\_4 = {A\_1, B\_1, A\_3, B\_2, A\_2, B\_3, A\_1}; \n
    hex\_5 = {A\_1, B\_1, A\_2, B\_3, A\_3, B\_2, A\_1}; \n
    hex\_6 = {A\_1, B\_1, A\_3, B\_3, A\_2, B\_2, A\_1}; \)], "Input"],

Cell[TextData[{
  "Why are these the ",
  StyleBox["only six possibilities",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " that need be considered?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.  ",
    FontWeight->"Bold"],
  "Here is a program that computes the ",
  StyleBox["Pappus line",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " for any given hexagon."
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \(\(Pappus[hh_] := 
      Module[{ss}, ss = Partition[hh, 2, 1]; 
        Factor[PE[
            PE[PE@@ss\[LeftDoubleBracket]1\[RightDoubleBracket], 
              PE@@ss\[LeftDoubleBracket]4\[RightDoubleBracket]], 
            PE[PE@@ss\[LeftDoubleBracket]2\[RightDoubleBracket], 
              PE@@ss\[LeftDoubleBracket]5\[RightDoubleBracket]]]]]; \)\)], 
  "Input"],

Cell["Here are the results for the six specific hexagons:", "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[{
    \(pap\_1 = Pappus[hex\_1]\), 
    \(pap\_2 = Pappus[hex\_2]\), 
    \(pap\_3 = Pappus[hex\_3]\), 
    \(pap\_4 = Pappus[hex\_4]\), 
    \(pap\_5 = Pappus[hex\_5]\), 
    \(pap\_6 = Pappus[hex\_6]\)}], "Input"],

Cell[TextData[{
  "Look at the picture of these six lines.  Can you see in this configuration \
a ",
  StyleBox["possible",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["theorem",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?  Can you ",
  StyleBox["prove",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " it?"
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \(\(Draw[{pap\_1, pap\_2, pap\_3, pap\_4, pap\_5, pap\_6}]; \)\)], "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3.",
    FontWeight->"Bold"],
  "  This configuration started with ",
  StyleBox["specific points",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  Can you rerun the computations to give a ",
  StyleBox["general proof",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "4. Finding points on and off a line  ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question.",
    FontWeight->"Bold"],
  "  Why does the following construction find at least  ",
  StyleBox["two",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " points on a given line ",
  Cell[BoxData[
      StyleBox[\(a\ x + b\ y + c\ z\),
        FontWeight->"Bold"]]],
  " \[LongDash] often ",
  StyleBox["three",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?   But explain why there are clearly possibilities of degeneracy, and we \
cannot say ",
  StyleBox["which",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " point is going to be non degenerate."
}], "Text",
  Evaluatable->False,
  AspectRatioFixed->False,
  Background->RGBColor[0, 1, 1]],

Cell[BoxData[
    \(Flatten[Outer[PE, {a\ x + b\ y + c\ z}, {x, y, z}], 1]\)], "Input",
  AspectRatioFixed->False]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.  ",
    FontWeight->"Bold"],
  "Is there a simple program that always finds without failure a ",
  StyleBox["single",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " point ",
  StyleBox["on",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " a line?   And is there a program that always finds a single point ",
  StyleBox["off",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " a line?  Test your answers."
}], "Text",
  Evaluatable->False,
  AspectRatioFixed->False,
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3.  ",
    FontWeight->"Bold"],
  "Given a ",
  StyleBox["list",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of lines, how can we find a point  ",
  StyleBox["not",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " on any of them?"
}], "Text",
  Evaluatable->False,
  AspectRatioFixed->False,
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]]
},
