Cell[CellGroupData[{

Cell[TextData[{
  "Question 1  ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 1.",
  StyleBox["  At each vertex there are ",
    FontWeight->"Plain"],
  StyleBox["two sides ",
    FontSlant->"Italic"],
  StyleBox["and ",
    FontWeight->"Plain"],
  StyleBox["two diagonals",
    FontSlant->"Italic"],
  StyleBox[".  What is their ",
    FontWeight->"Plain"],
  StyleBox["crossratio",
    FontSlant->"Italic"],
  StyleBox["?  (Say, take the order side, diagonal, diagonal, side.)",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2  ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  "Question 2.",
  StyleBox["  What crossratio will the lines joining the ",
    FontWeight->"Plain"],
  StyleBox["origin",
    FontSlant->"Italic"],
  StyleBox[" to ",
    FontWeight->"Plain"],
  StyleBox["four",
    FontSlant->"Italic"],
  StyleBox[" of the vertices have?  (Take ",
    FontWeight->"Plain"],
  StyleBox["consecutive",
    FontSlant->"Italic"],
  StyleBox[" vertices!)",
    FontWeight->"Plain"]
}], "Text",
  FontWeight->"Bold",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Warning: ",
    FontWeight->"Bold"],
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " gives quite different answers depending on which four vertices you \
choose.  By symmetry the answers should all be the ",
  StyleBox["same",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  They are, but ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " \[LongDash] as far as Scott could manage it \[LongDash] does not simplify \
one expression to the other.  So, find the ",
  StyleBox["simplest one",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "!"
}], "Text",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]]
