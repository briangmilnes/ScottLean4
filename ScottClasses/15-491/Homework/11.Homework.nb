Notebook[{
Cell[TextData[{
  "Week 11   Projective Geometry\n",
  StyleBox["Homework",
    FontSize->18]
}], "Title",
  Evaluatable->False,
  PageBreakAbove->True,
  AspectRatioFixed->True],

Cell["\[Copyright] Dana Scott 1993/1997/1998", "Text",
  FontWeight->"Bold",
  FontSlant->"Italic"],

Cell[TextData[{
  StyleBox[
  "Copy this notebook and do all work in it.\nName the file: \
11.yourlastname.nb\nPlease hand in by ",
    FontSize->12,
    FontWeight->"Bold"],
  StyleBox["Monday, 9 November",
    FontSize->12,
    FontWeight->"Bold",
    FontColor->GrayLevel[0]],
  StyleBox[".\nSave it in your subdirectory of\nthe class handin directory.",
    FontSize->12,
    FontWeight->"Bold"]
}], "Subsubtitle",
  FontColor->RGBColor[1, 0, 0]],

Cell[TextData[StyleBox["Name: xxxxxxxxx",
  FontSize->16]], "Subsubtitle"],

Cell[CellGroupData[{

Cell[TextData[{
  "1. Self-polar triangles ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  Explain why if a (non-degenerate) triangle is self-polar with respect to \
a (non-degenerate) conic, then any ",
  StyleBox["two",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " vertices uniquely determine the ",
  StyleBox["third",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  Prove that if ",
  StyleBox["two",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " triangles are ",
  StyleBox["self-polar",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " with respect to a conic, then their vertices lie on ",
  StyleBox["another conic",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  Find some ",
  StyleBox["formulas",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " if possible."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3.",
    FontWeight->"Bold"],
  "  Explain why if a triangle is self-polar with respect to a conic, the ",
  StyleBox["trilateral",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " it determines is ",
  StyleBox["dually self-polar",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " with respect to the dual conic that envelops the given conic.  Draw a ",
  StyleBox["conclusion",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " from the hypothesis of Question 2 by duality."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "2. Two polarities by two conics ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  Prove that if a point varies along a line, then the intersection of the \
polars of the point with respect to ",
  StyleBox["two conics",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " sweeps out a third conic."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  Consider two non-degenerate, non-tangent conics.  Prove that the ",
  StyleBox["projective transformation",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " defined by taking a polar with respect to the first conic and a pole with \
respect to the second maps four points of the first conic onto four points of \
the second, but ",
  StyleBox["does not",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " map the first conic completely onto the second."
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Hint:",
    FontWeight->"Bold"],
  "  Two conics generally have ",
  StyleBox["four tangents",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " in common.  (Why?)"
}], "Text",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "3. Parameterization by crossratio ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  Consider the unit circle and think of the points \n\t\t",
  Cell[BoxData[
      StyleBox[\({p, q, r} = {v + w, \(-v\) + w, u + w}\),
        FontWeight->"Bold"]]],
  "\nas corresponding to ",
  Cell[BoxData[
      StyleBox[\({\[Infinity], 0, 1}\),
        FontWeight->"Bold"]]],
  ".  If we determine a fourth point on the circle as a function of a \
crossratio ",
  Cell[BoxData[
      StyleBox["a",
        FontWeight->"Bold"]]],
  " (or of ",
  Cell[BoxData[
      StyleBox[\({a, b}\),
        FontWeight->"Bold"]]],
  " in homogeneous form), what kind of parameterization of the circle do we \
get?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  Take the point ",
  Cell[BoxData[
      RowBox[{
        StyleBox["k",
          FontWeight->"Bold"], 
        StyleBox["=",
          FontWeight->"Bold"], 
        RowBox[{
          StyleBox[
            RowBox[{"2", 
              StyleBox["u",
                FontWeight->"Bold"]}],
            FontWeight->"Bold"], 
          StyleBox["+",
            FontWeight->"Bold"], 
          StyleBox[\(3\ v\),
            FontWeight->"Bold"], 
          StyleBox["+",
            FontWeight->"Bold"], 
          StyleBox["w",
            FontWeight->"Bold"]}]}]]],
  " and perform the ",
  StyleBox["involution",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of the unit circle using the rays through the center ",
  Cell[BoxData[
      StyleBox["k",
        FontWeight->"Bold"]]],
  " to determine the corresponding points.  In terms of the parameterization \
in the answer to Question 1, find a ",
  StyleBox["formula ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "for this involution.  Then project the point on the circle back to the ",
  StyleBox["x",
    FontWeight->"Bold"],
  "-axis.   ",
  StyleBox["Draw a picture",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " to illustrate the connections."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "4. Involutions on a conic ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  [A problem taken from a book.]  Let ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox["q",
        FontWeight->"Bold"]]],
  " be ",
  StyleBox["two",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " fixed points ",
  StyleBox["not on",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the non-degenerate conic ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  ".  Consider a variable line passing through ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  " intersecting the conic at points ",
  Cell[BoxData[
      StyleBox[\(s\_1\),
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox[\(s\_2\),
        FontWeight->"Bold"]]],
  ".  If these points are joined by lines to the fixed point ",
  Cell[BoxData[
      StyleBox["q",
        FontWeight->"Bold"]]],
  ", then two additional points ",
  Cell[BoxData[
      StyleBox[\(t\_1\),
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox[\(t\_2\),
        FontWeight->"Bold"]]],
  " of the conic are determined.   Prove that the line joining points ",
  Cell[BoxData[
      StyleBox[\(t\_1\),
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox[\(t\_2\),
        FontWeight->"Bold"]]],
  " always passes through a ",
  StyleBox["third",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " fixed point ",
  Cell[BoxData[
      StyleBox["r",
        FontWeight->"Bold"]]],
  "."
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Hint:",
    FontWeight->"Bold"],
  "  This can be proved nicely by symbolic computation (especially by \
choosing the conic and some of the points in special position).  However, if \
you can quote the right theorem, then this can be proved without any \
computation."
}], "Text",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  [Another problem taken from a book.]  Let ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  " be a fixed point ",
  StyleBox["not on",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the non-degenerate conic ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  ".  Take four ",
  StyleBox["non-tangent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " lines passing through ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  " each intersecting the conic at two points ",
  Cell[BoxData[
      StyleBox[\(q\_i\),
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox[\(r\_i\),
        FontWeight->"Bold"]]],
  ".  Prove that the two conics determined by ",
  Cell[BoxData[
      RowBox[{
        StyleBox["{",
          FontWeight->"Bold"], 
        RowBox[{
          StyleBox["p",
            FontWeight->"Bold"], 
          StyleBox[",",
            FontWeight->"Bold"], 
          StyleBox[\(q\_1\),
            FontWeight->"Bold"], 
          StyleBox[",",
            FontWeight->"Bold"], 
          StyleBox[\(q\_2\),
            FontWeight->"Bold"], 
          StyleBox[",",
            FontWeight->"Bold"], 
          StyleBox[\(q\_3\),
            FontWeight->"Bold"], 
          StyleBox[",",
            FontWeight->"Bold"], 
          StyleBox[\(q\_4\),
            FontWeight->"Bold"]}], 
        StyleBox["}",
          FontWeight->"Bold"]}]]],
  " and by ",
  Cell[BoxData[
      StyleBox[\({p, r\_1, r\_2, r\_3, r\_4}\),
        FontWeight->"Bold"]]],
  " are ",
  StyleBox["tangent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " at ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  "."
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Hint:",
    FontWeight->"Bold"],
  "  A center like ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  " determines an ",
  StyleBox["involution",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " on the conic.  A projective correspondence on a conic determines a unique \
",
  StyleBox["projective transformation",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of the whole plane onto itself.  Given five distinct points on a conic, \
one ought to be able to calculate something ",
  StyleBox["via",
    FontSlant->"Italic"],
  " crossratios to determine the ",
  StyleBox["tangent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " at one of the points."
}], "Text",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]]
},
