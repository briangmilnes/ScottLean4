Notebook[{
Cell[TextData[{
  "Week 10   Projective Geometry\n",
  StyleBox["Homework",
    FontSize->18]
}], "Title",
  Evaluatable->False,
  PageBreakAbove->True,
  AspectRatioFixed->True],

Cell["\[Copyright] Dana Scott 1993/1997/1998", "Text",
  FontWeight->"Bold",
  FontSlant->"Italic"],

Cell[TextData[{
  StyleBox[
  "Copy this notebook and do all work in it.\nName the file: \
10.yourlastname.nb\nPlease hand in by ",
    FontSize->12,
    FontWeight->"Bold"],
  StyleBox["Monday, 2 November",
    FontSize->12,
    FontWeight->"Bold",
    FontColor->GrayLevel[0]],
  StyleBox[".\nSave it in your subdirectory of\nthe class handin directory.",
    FontSize->12,
    FontWeight->"Bold"]
}], "Subsubtitle",
  FontColor->RGBColor[1, 0, 0]],

Cell[TextData[StyleBox["Name: xxxxxxxxx",
  FontSize->16]], "Subsubtitle"],

Cell[CellGroupData[{

Cell[TextData[{
  "1. Transforms of conics ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.  ",
    FontWeight->"Bold"],
  "Here are three conics:\n\t\t",
  Cell[BoxData[
      RowBox[{
        RowBox[{
          StyleBox[
            RowBox[{"f", "=", 
              RowBox[{\(x\^2\), "+", 
                SuperscriptBox[
                  StyleBox["y",
                    FontWeight->"Bold"], "2"], "-", \(z\^2\)}]}],
            FontWeight->"Bold"], 
          StyleBox[";",
            FontWeight->"Bold"], 
          StyleBox[
            StyleBox[
              RowBox[{
                StyleBox["  ",
                  FontWeight->"Bold"], "  "}]],
            FontWeight->"Bold"], 
          StyleBox[\( (*circle*) \),
            FontWeight->"Bold"], 
          StyleBox["\n",
            FontWeight->"Bold"], 
          StyleBox[
            RowBox[{"g", "=", 
              RowBox[{
                SuperscriptBox[
                  StyleBox["y",
                    FontWeight->"Bold"], "2"], "-", \(x\ z\)}]}],
            FontWeight->"Bold"], 
          StyleBox[";",
            FontWeight->"Bold"], 
          StyleBox["            ",
            FontWeight->"Bold"], 
          StyleBox[\( (*parabola*) \),
            FontWeight->"Bold"], 
          StyleBox["\n",
            FontWeight->"Bold"], 
          StyleBox[
            RowBox[{"h", "=", 
              RowBox[{
                SuperscriptBox[
                  StyleBox["x",
                    FontWeight->"Bold"], "2"], "-", \(y\^2\), "-", 
                \(z\^2\)}]}],
            FontWeight->"Bold"], 
          StyleBox[";",
            FontWeight->"Bold"]}], 
        StyleBox["     ",
          FontWeight->"Bold"], 
        StyleBox[\( (*hyperbola*) \),
          FontWeight->"Bold"]}]]],
  "\nFind projective transformations (not using complex numbers) mapping each \
one to each other one.  Check all results."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.  ",
    FontWeight->"Bold"],
  "If complex numbers are allowed, how can ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " be transformed to ",
  Cell[BoxData[
      StyleBox["g",
        FontWeight->"Bold"]]],
  " very easily?  Check answer."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "2. Conics tangent to a given line ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.   ",
    FontWeight->"Bold"],
  "What is a formula for a ",
  StyleBox["typical conic",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " in the pencil of conics passing through the unit points ",
  Cell[BoxData[
      StyleBox[\({w, u + w, v + w, u + v + w}\),
        FontWeight->"Bold"]]],
  " and for the ",
  StyleBox["dual conic",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " (envelope) to this conic?  Which conics in the pencil are ",
  StyleBox["degenerate",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.  ",
    FontWeight->"Bold"],
  "Prove that in general there are ",
  StyleBox["two",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " conics passing through ",
  StyleBox["four given points",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " and ",
  StyleBox["tangent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " to a ",
  StyleBox["given line",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  Are there conditions when there is only ",
  StyleBox["one",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " conic? "
}], "Text",
  Evaluatable->False,
  AspectRatioFixed->False,
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 3 ",
  StyleBox["[5 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3. ",
    FontWeight->"Bold"],
  "Draw a ",
  StyleBox["picture",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " to illustrate the theorem using the computations for Question 2"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "3. Tangents to a quintic ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.",
    FontWeight->"Bold"],
  "  The quintic curve \n\t\t",
  Cell[BoxData[
      StyleBox[
        \(f = 2 x\^5 - x\^4\ z + x\^3\ y\^2 - x\^2\ y\^3 + z\ y\^4 + 
            3\ y\^5\),
        FontWeight->"Bold"]]],
  "\nseems to have a ",
  StyleBox["quadruple",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " point somewhere.  Find ",
  StyleBox["it",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " and find all the ",
  StyleBox["tangents",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " at that point."
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  "  Does the curve have any other multiple points?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Extra Credit Question 3 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3.",
    FontWeight->"Bold"],
  "  Can you parameterize the curve?"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "4. Triangles and conics ",
  StyleBox["[25 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsection",
  Evaluatable->False,
  AspectRatioFixed->False],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 1 ",
  StyleBox["[15 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 1.  ",
    FontWeight->"Bold"],
  "Consider a ",
  StyleBox["conic",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " and a ",
  StyleBox["triangle",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " with vertices ",
  StyleBox["not",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " on the conic.",
  StyleBox["  ",
    FontWeight->"Bold"],
  "Prove that the the ",
  StyleBox["six",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " lines joining the vertices of the triangle to the ",
  StyleBox["intersections",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of the conic with the oppositie sides ",
  StyleBox["touch",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " (",
  StyleBox["i.e.",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", are tangent to) a ",
  StyleBox["second conic",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  Evaluatable->False,
  AspectRatioFixed->False,
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Warning.",
    FontWeight->"Bold"],
  "  Trying to do this in ",
  StyleBox["general position",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " requires far too much algebra crunching.  Without loss, however, we can \
assume the triangle has vertices ",
  Cell[BoxData[
      StyleBox[\({u, v, w}\),
        FontWeight->"Bold"]]],
  " and opposite sides ",
  Cell[BoxData[
      StyleBox[\({x, y, z}\),
        FontWeight->"Bold"]]],
  ".  Take the following general conic:"
}], "Text",
  Background->RGBColor[0, 1, 0]],

Cell[BoxData[
    \(conic = {a, 2  b, c, 2  d, 2  e, f} . Bxyz[2]\)], "Input"]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Question 2 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 2.",
    FontWeight->"Bold"],
  " Find the ",
  StyleBox["xyz",
    FontWeight->"Bold"],
  "-equation of the other conic and draw a picture of a special case."
}], "Text",
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  StyleBox["Hint.",
    FontWeight->"Bold"],
  "  Choose a ",
  StyleBox["hyperbola",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " (to make sure it crosses the line at infinity), and position it so it \
crosses the ",
  StyleBox["x",
    FontWeight->"Bold"],
  "- and ",
  StyleBox["y",
    FontWeight->"Bold"],
  "-axes in real points \[LongDash] otherwise we cannot graph the six lines."
}], "Text",
  Background->RGBColor[0, 1, 0]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]],

Cell[CellGroupData[{

Cell[TextData[{
  "Extra Credit Question 3 ",
  StyleBox["[10 points]",
    FontColor->RGBColor[1, 0, 0]]
}], "Subsubsection"],

Cell[TextData[{
  StyleBox["Question 3.",
    FontWeight->"Bold"],
  "   What should it mean for two conics to be ",
  StyleBox["tangent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " to each other, and are the two conics found indeed tangent?  (At least \
try some special cases.)"
}], "Text",
  Background->RGBColor[0, 1, 1]]
}, Closed]],

Cell[TextData[StyleBox["Answer",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]]], "Subsubsection",
  FontColor->RGBColor[1, 0, 0]]
}, Closed]]
},
