Cell[TextData[{
  "It seems to have a ",
  StyleBox["double point",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \(\(p = u + w;\)\)], "Input",
  CellLabel->"In[572]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[{
    \(PD[f, p\^2]\), "\n", 
    \(Factor[PD[f, p]]\)}], "Input",
  CellLabel->"In[634]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \(0\)], "Output",
  CellLabel->"Out[634]=",
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \(\(-\((x - y - z)\)\)\ \((x + y - z)\)\)], "Output",
  CellLabel->"Out[635]=",
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[TextData[{
  "It does, and we see the ",
  StyleBox["two tangents",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  Moreover, the curve is also ",
  StyleBox["tangent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " to the line at infinity at the intersection with the ",
  Cell[BoxData[
      StyleBox["y",
        FontWeight->"Bold"]]],
  "-axis."
}], "Text",
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[
    \({PD[f, v\^3], PD[f, v\^2]}\)], "Input",
  CellLabel->"In[632]:=",
  Evaluator->"None",
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \({0, 2\ z}\)], "Output",
  CellLabel->"Out[632]=",
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[TextData[{
  "We now attempt a ",
  StyleBox["parameterization",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " using our formula taking homogeneous coordinates on the ",
  Cell[BoxData[
      StyleBox["y",
        FontWeight->"Bold"]]],
  "-axis."
}], "Text",
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[{
    \(\(q = \[Alpha]\ \((v + w)\) + \[Beta]\ w;\)\), "\n", 
    \(r = 
      Factor /@ Tidy[\(-\(1\/6\)\)\ \((PD[f, q\^3]\ p - 
                3\ PD[f, p\ q\^2]\ q)\)]\)}], "Input",
  CellLabel->"In[611]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
