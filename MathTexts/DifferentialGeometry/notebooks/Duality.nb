Cell[TextData[{
  StyleBox["Looks like a ",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["tangent",
    FontWeight->"Bold",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox[" line.  And it is easy to find the ",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["other intersection",
    FontWeight->"Bold",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox[" with the curve.  (Why?)",
    FontColor->RGBColor[1, 0, 0]]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

