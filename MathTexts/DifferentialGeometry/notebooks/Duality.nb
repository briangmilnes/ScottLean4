  StyleBox["at",
    FontWeight->"Plain"],
  StyleBox[" ",
    FontWeight->"Bold"],
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["with",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  StyleBox[" ",
    FontWeight->"Bold"],
  StyleBox["if, and only if, \n",
    FontWeight->"Plain"],
  "\n         ",
  Cell[BoxData[
      StyleBox[
        RowBox[{
          RowBox[{"PD", "[", 
            RowBox[{
              StyleBox["f",
                FontWeight->"Bold"], 
              StyleBox[",",
                FontWeight->"Bold"], 
              RowBox[{\(p\^\(n - i\)\), " ", 
                StyleBox[\(q\^i\),
                  FontWeight->"Bold"]}]}], "]"}], "==", "0"}],
        FontWeight->"Bold"]]],
  " ",
  StyleBox["whenever",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox[\(0 \[LessEqual] i < m\),
        FontWeight->"Bold"]]],
  StyleBox[", but",
    FontWeight->"Plain"],
  "   \n         ",
  Cell[BoxData[
      StyleBox[\(PD[f, p\^\(n - m\)\ q\^m] \[NotEqual] 0\),
        FontWeight->"Bold"]]],
  "."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell["Test", "Subsubsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "Consider a ",
  StyleBox["cubic",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \(\(f = \(-x\^3\) + 2\ x\^2\ z + y\^2\ z - x\ z\^2;\)\)], "Input",
  CellLabel->"In[548]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "Find some ",
  StyleBox["points",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " on the curve."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Solve[{f \[Equal] 0, z \[Equal] 1, x \[Equal] 1/2}, {x, y, 
        z}]\)], "Input",
  CellLabel->"In[549]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \({{y \[Rule] \(-\(1\/\(2\ \@2\)\)\), z \[Rule] 1, 
        x \[Rule] 1\/2}, {y \[Rule] 1\/\(2\ \@2\), z \[Rule] 1, 
        x \[Rule] 1\/2}}\)], "Output",
  CellLabel->"Out[549]=",
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[TextData[{
  "So, this particular point ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["lies",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " on the curve."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[{
    \(\(p = \@2\ u + v + \((2\ \@2)\)\ w;\)\), "\[IndentingNewLine]", 
    \(PD[f, p\^3]\)}], "Input",
  CellLabel->"In[550]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \(0\)], "Output",
  CellLabel->"Out[551]=",
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[TextData[{
  "Here is an interesting ",
  StyleBox["line",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ". "
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[
    \(l = Tidy[Factor[1\/2\ PD[f, p\^2]]]\)], "Input",
  CellLabel->"In[552]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \(2\ x + 4\ \@2\ y - 3\ z\)], "Output",
  CellLabel->"Out[552]=",
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[TextData[{
  "We find a point on the line ",
  StyleBox["different from",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  "."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Solve[{l \[Equal] 0, z \[Equal] 1, x \[Equal] 0}, {x, y, z}]\)], "Input",\

  CellLabel->"In[553]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \({{y \[Rule] 3\/\(4\ \@2\), x \[Rule] 0, z \[Rule] 1}}\)], "Output",
  CellLabel->"Out[553]=",
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[TextData[{
  "We see how the line ",
  StyleBox["intersects",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the curve."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[
    \(q = 3\ v + 4\ \(\@2\) w; PD[f, \((p + t\ q)\)\^3] // Factor\)], "Input",\

  CellLabel->"In[554]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \(12\ \@2\ t\^2\ \((5 + 18\ t)\)\)], "Output",
  CellLabel->"Out[554]=",
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[TextData[{
  "Hence the line ",
  Cell[BoxData[
      StyleBox["l",
        FontWeight->"Bold"]]],
  " has ",
  StyleBox["degree of contact",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      StyleBox["2",
        FontWeight->"Bold"]]],
  " with the curve ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  ".  We can draw a picture."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(ImplicitPlot[{f == 0, l \[Equal] 0} /. {z \[Rule] 1}, \n\t{x, \(-3\), 
          3}, {y, \(-3\), 3}, \n\tPlotPoints \[Rule] 131, \n\t
        AxesOrigin \[Rule] {0, 0}, \n\t
        PlotStyle \[Rule] {Thickness[0.007]}];\)\)], "Input",
  CellLabel->"In[555]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

