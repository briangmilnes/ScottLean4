Cell["Example 4. Multiplicity", "Subsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Definition.  ",
    FontWeight->"Bold"],
  StyleBox["A point on a curve is a ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["m",
        FontWeight->"Bold"]]],
  StyleBox["-",
    FontWeight->"Plain",
    FontSlant->"Italic"],
  StyleBox["tuple point",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["if, and only if, ",
    FontWeight->"Plain"],
  StyleBox["every",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["line through the point has degree of contact ",
    FontWeight->"Plain"],
  StyleBox["at least",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      StyleBox["m",
        FontWeight->"Bold"]]],
  StyleBox[", and one line has degree of contact ",
    FontWeight->"Plain"],
  StyleBox["exactly",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      StyleBox["m",
        FontWeight->"Bold"]]],
  StyleBox[".",
    FontWeight->"Plain"]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  Background->RGBColor[1, 1, 0]],

Cell[TextData[{
  StyleBox["Theorem.  ",
    FontWeight->"Bold"],
  " ",
  StyleBox["If",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  StyleBox[" ",
    FontWeight->"Bold"],
  StyleBox["is a curve of degree ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["n",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["and",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox[\(0 < m \[LessEqual] n\),
        FontWeight->"Bold"]]],
  StyleBox[", then a point",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["is an ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["m",
        FontWeight->"Bold"]]],
  StyleBox["-",
    FontWeight->"Plain",
    FontSlant->"Italic"],
  StyleBox["tuple point",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["of",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  StyleBox[" ",
    FontWeight->"Bold"],
  " ",
  StyleBox["if, and only if, ",
    FontWeight->"Plain"],
  "\n\t    ",
  Cell[BoxData[
      StyleBox[\(PD[f, p\^\(n - m + 1\)] == 0\),
        FontWeight->"Bold"]]],
  StyleBox[",   ",
    FontWeight->"Bold"],
  StyleBox["but",
    FontWeight->"Plain"],
  "   \n\t    ",
  Cell[BoxData[
      StyleBox[\(PD[f, p\^\(n - m\)] \[NotEqual] 0\),
        FontWeight->"Bold"]]],
  StyleBox[".",
    FontWeight->"Bold"],
  StyleBox[" ",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Definition.  ",
    FontWeight->"Bold"],
  StyleBox["A curve is",
    FontWeight->"Plain"],
  " ",
  StyleBox["degenerate",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "  ",
  StyleBox["if the polynomial representing it ",
    FontWeight->"Plain"],
  StyleBox["factors",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" into homogeneous polynomials of  ",
    FontWeight->"Plain"],
  StyleBox["lower degree",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[".",
    FontWeight->"Plain"]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  Background->RGBColor[1, 1, 0]],

Cell[TextData[{
  StyleBox["Theorem.  ",
    FontWeight->"Bold"],
  StyleBox["The polynomial for a curve of degree",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["n",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["with an",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["n",
        FontWeight->"Bold"]]],
  StyleBox["-tuple point factors into a product of",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["n",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["linear forms",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["representing lines",
    FontWeight->"Plain"],
  " ",
  StyleBox["concurrent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["at the",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["n",
