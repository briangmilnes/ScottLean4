Cell[CellGroupData[{

Cell["Some Thoughts for the Future", "Section",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "Several perhaps difficult problems remain:\n\n",
  StyleBox["(1) ",
    FontWeight->"Bold"],
  "How to extend this approach to fields of ",
  StyleBox["characteristic",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["p",
    FontWeight->"Bold"],
  "?\n",
  StyleBox["(2)",
    FontWeight->"Bold"],
  " How to use symbolic computation with ",
  StyleBox["algebraic numbers",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?\n",
  StyleBox["(3)",
    FontWeight->"Bold"],
  " How to refine the methods for the ",
  StyleBox["real projective plane",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?\n",
  StyleBox["(4)",
    FontWeight->"Bold"],
  " How to move to",
  StyleBox[" higher dimensions",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " beyond plane geometry?\n",
  StyleBox["(5)",
    FontWeight->"Bold"],
  " How to implement more of the ideas of",
  StyleBox[" invariant theory",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?\n",
  StyleBox["(6)",
    FontWeight->"Bold"],
  " How to make use of symbolic computation in ",
  StyleBox["ideal theory",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?\n",
  StyleBox["(7) ",
    FontWeight->"Bold"],
  "How to connect with ",
  StyleBox["automated theorem proving",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "?",
  StyleBox[" \n  \t\n",
    FontSize->18],
  StyleBox["A further question is: ",
    FontSize->18,
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["How to publish such course material?",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]]
}, Closed]]
}, Open  ]]
