Cell[CellGroupData[{

Cell["Example 7. Cubic Hessians", "Subsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Theorem.",
    FontWeight->"Bold"],
  "  Let",
  StyleBox[" ",
    Background->None],
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold",
        Background->None]],
    Background->None],
  StyleBox[" ",
    Background->None],
  "be a ",
  StyleBox["non-singular cubic",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", and let",
  StyleBox[" ",
    Background->None],
  Cell[BoxData[
      StyleBox[\({p, q, r}\),
        FontWeight->"Bold"]],
    Background->None],
  StyleBox[" ",
    FontWeight->"Bold",
    Background->None],
  "be three ",
  StyleBox["collinear",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["inflection points",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of",
  StyleBox[" ",
    Background->None],
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]],
    Background->None],
  StyleBox[".",
    Background->None],
  "   Let",
  StyleBox[" ",
    Background->None],
  Cell[BoxData[
      StyleBox["h",
        FontWeight->"Bold"]],
    Background->None],
  StyleBox[" ",
    Background->None],
  "be the Hessian of",
  StyleBox[" ",
    Background->None],
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold",
        Background->None]],
    Background->None],
  ".  Then:\n\t",
  StyleBox["(",
    FontWeight->"Bold"],
  StyleBox["i ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[")",
    FontWeight->"Bold"],
  "   The Hessian curve",
  StyleBox[" ",
    Background->None],
  Cell[BoxData[
      StyleBox["h",
        FontWeight->"Bold"]],
    Background->None],
  " also passes through",
  StyleBox[" ",
    Background->None],
  Cell[BoxData[
      StyleBox[\({p, q, r}\),
        FontWeight->"Bold"]],
    Background->None],
  ";\n\t",
  StyleBox["(",
    FontWeight->"Bold"],
  StyleBox["ii ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[") ",
    FontWeight->"Bold"],
  " Each tangent to",
  StyleBox[" ",
    Background->None],
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]],
    Background->None],
  " at",
  StyleBox[" ",
    Background->None],
  Cell[BoxData[
      StyleBox[\({p, q, r}\),
        FontWeight->"Bold"]],
    Background->None],
  " is also tangent to",
  StyleBox[" ",
    Background->None],
  Cell[BoxData[
      StyleBox["h",
        FontWeight->"Bold"]],
    Background->None],
  StyleBox[" at the double point of the conic polar at that point;",
    Background->None],
  "\n\t",
  StyleBox["(",
    FontWeight->"Bold"],
  StyleBox["iii ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[") ",
    FontWeight->"Bold"],
  "Each ",
  StyleBox["pair",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of tangents to these points intersects on the ",
  StyleBox["conic polar",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of the third inflection point;  \n\t",
  StyleBox["(",
    FontWeight->"Bold"],
  StyleBox["iv ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[") ",
    FontWeight->"Bold"],
  "The the non-tangent factors of the three conic polars are ",
  StyleBox["concurrent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "; and  \n\t",
  StyleBox["(",
    FontWeight->"Bold"],
  StyleBox["v ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[")  ",
    FontWeight->"Bold"],
  "The double point on the tangent and the inflection point ",
  StyleBox["separate harmonically",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the points of intersection with the other two tangents.",
  StyleBox[" ",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

