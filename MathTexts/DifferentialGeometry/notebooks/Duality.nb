Cell[CellGroupData[{

Cell["Example 8. Parametrization", "Subsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Theorem. ",
    FontWeight->"Bold"],
  " ",
  StyleBox["If  ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["is a curve of degree",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["n",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["and",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["is an ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox[\((n - 1)\),
        FontWeight->"Bold"]]],
  StyleBox["-tuple point on",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  StyleBox[", then if ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["q",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["is any point ",
    FontWeight->"Plain"],
  StyleBox["not",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["on the tangents at",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  StyleBox[", we can find the ",
    FontWeight->"Plain"],
  StyleBox["other intersection",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" of the line joining ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  StyleBox[" and ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["q",
        FontWeight->"Bold"]]],
  StyleBox[" with the curve ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["by the formula:\n",
    FontWeight->"Plain"],
  StyleBox["      ",
    FontSize->10,
    FontWeight->"Plain"],
  "\n            ",
  Cell[BoxData[
      StyleBox[\(PD[f, q\^n]\ p - n\ PD[f, p\ q\^\(n - 1\)]\ q\),
        FontWeight->"Bold"]]],
  StyleBox[".",
    FontWeight->"Bold"],
  "  "
}], "Text",
  CellMargins->{{Inherited, Inherited}, {Inherited, 12}},
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  FontSize->18],

Cell[CellGroupData[{

Cell["Test", "Subsubsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "Consider this ",
  StyleBox["cubic",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[{
    \(\(ClearAll[f, e];\)\), "\n", 
    \(f = Tidy[y\^2\ z - x\ \((x - z)\)\ \((x - z)\)]\)}], "Input",
  CellLabel->"In[628]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \(\(-x\^3\) + 2\ x\^2\ z + y\^2\ z - x\ z\^2\)], "Output",
  CellLabel->"Out[629]=",
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[TextData[{
  "Here is a ",
  StyleBox["picture",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(ImplicitPlot[{f == 0} /. {z \[Rule] 1}, \n\t{x, \(-3\), 
          3}, {y, \(-2\), 2}, \n\tPlotPoints \[Rule] 200, \n\t
        AxesOrigin \[Rule] {0, 0}, \n\t
        PlotStyle \[Rule] {Thickness[0.007]}];\)\)], "Input",
  CellLabel->"In[633]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

