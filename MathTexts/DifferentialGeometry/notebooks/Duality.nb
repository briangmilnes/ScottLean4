Cell[CellGroupData[{

Cell["Comment", "Subsubsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["At first I thought I could find a low-degree curve with ",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["both",
    FontWeight->"Bold",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox[" a ",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["double",
    FontWeight->"Bold",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox[" and a ",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["triple",
    FontWeight->"Bold",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox[" point.  But then, after failing to find a non-degenerate one, I \
remembered an easy method to prove:",
    FontColor->RGBColor[1, 0, 0]]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Theorem.  ",
    FontWeight->"Bold"],
  " ",
  StyleBox["If a ",
    FontWeight->"Plain"],
  StyleBox["quartic",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" has both a double point and a triple point, then it ",
    FontWeight->"Plain"],
  StyleBox["factors",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" with the line joining the two points as one of the factors.",
    FontWeight->"Plain"]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Proof:  ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "Let ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  " be the double point of a quintic ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  ", and let ",
  Cell[BoxData[
      StyleBox["q",
        FontWeight->"Bold"]]],
  " be the triple point.  Consider this expansion:"
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[
    \(g = \((p + t\ q)\)\^4 // Expand\)], "Input",
  CellLabel->"In[567]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \(p\^4 + 4\ p\^3\ q\ t + 6\ p\^2\ q\^2\ t\^2 + 4\ p\ q\^3\ t\^3 + 
      q\^4\ t\^4\)], "Output",
  CellLabel->"Out[567]=",
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[TextData[{
  "When we evaluate ",
  Cell[BoxData[
      StyleBox[\(PD[f, g]\),
        FontWeight->"Bold"]]],
  ", then the first two terms kill ",
  Cell[BoxData[
      \(f\)]],
  ", and the last three do also -- for a different reason.  So, all points on \
the line joining ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox["q",
        FontWeight->"Bold"]]],
  " lie on the curve ",
  Cell[BoxData[
      StyleBox[\(f \[Equal] 0\),
        FontWeight->"Bold"]]],
  ".  ",
  StyleBox["Q.E.D.",
    FontWeight->"Bold"]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[StyleBox["\n\n\n\n\n\n\n\n\n\n\n",
  FontWeight->"Plain"]], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell["\<\


















\
\>", "Subsubsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[CellGroupData[{

Cell["Example 5. Tangency ", "Subsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Definition. ",
    FontWeight->"Bold"],
  StyleBox["If a line at an",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["m",
        FontWeight->"Bold"]]],
  StyleBox["-tuple point of a curve has degree of contact ",
    FontWeight->"Plain"],
  StyleBox["greater than",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      StyleBox["m",
        FontWeight->"Bold"]]],
  StyleBox[", then it is said to be",
    FontWeight->"Plain"],
  " ",
  StyleBox["tangent",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" at that point. ",
    FontWeight->"Plain"]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  Background->RGBColor[1, 1, 0]],

Cell[TextData[{
  StyleBox["Theorem.",
    FontWeight->"Bold"],
  "  ",
  StyleBox["If",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  StyleBox[" ",
    FontWeight->"Bold"],
  StyleBox["is a curve of degree ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["n",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["with an",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["m",
        FontWeight->"Bold"]]],
  StyleBox["-tuple point",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  ", ",
  StyleBox["then the curve",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox[\(g == PD[f, p\^\(n - m\)]\),
        FontWeight->"Bold"]]],
  " ",
  StyleBox["of",
    FontWeight->"Plain"],
  " ",
  StyleBox["degree",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["m",
        FontWeight->"Bold"]]],
  StyleBox[" ",
    FontWeight->"Bold"],
  StyleBox["factors into",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["m",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["linear factors representing",
    FontWeight->"Plain"],
  " ",
  StyleBox["all",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["the tangents to the curve at the point.",
    FontWeight->"Plain"]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Comment.",
    FontWeight->"Bold"],
  "  ",
  StyleBox["This theorem shows that at an",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["m",
        FontWeight->"Bold"]]],
  StyleBox["-tuple point",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  StyleBox[" on a curve",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["there are ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["m",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["tangents\[LongDash]but some of them may be counted",
    FontWeight->"Plain"],
  " ",
  StyleBox["multiple times",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["depending on how",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox[\(PD[f, p\^\(n - m\)]\),
        FontWeight->"Bold"]]],
  " ",
  StyleBox["factors.",
    FontWeight->"Plain"]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  Background->RGBColor[0.8, 1, 0.4]],

Cell[TextData[{
  StyleBox["Theorem.  ",
    FontWeight->"Bold"],
  StyleBox["If",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  StyleBox[" ",
    FontWeight->"Bold"],
  StyleBox["is a curve of degree",
    FontWeight->"Plain"],
  StyleBox[" ",
    FontWeight->"Bold"],
  Cell[BoxData[
      StyleBox["n",
        FontWeight->"Bold"]]],
  StyleBox[", and if",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["is ",
    FontWeight->"Plain"],
  " ",
  StyleBox["not",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["an",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["n",
        FontWeight->"Bold"]]],
  StyleBox["-tuple point of",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  StyleBox[", then the non-zero curve ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox[\(PD[f, \ p]\),
        FontWeight->"Bold"]]],
  StyleBox[" ",
    FontWeight->"Bold"],
  StyleBox["of degree ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox[\(n - 1\),
        FontWeight->"Bold"]]],
  StyleBox[" ",
    FontWeight->"Bold"],
  StyleBox["intersects",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["exactly at multiple points and points of contact of the tangents \
to ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["from the point",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  ".  ",
  StyleBox["Hence, there can be ",
    FontWeight->"Plain"],
  StyleBox["at most",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      StyleBox[\(n \((n - 1)\)\),
        FontWeight->"Bold"]]],
  " ",
  StyleBox["tangents to the curve",
    FontWeight->"Plain"],
  " ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["from the point ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  ".\n\n\n\n\n\n\n\n\n\n\n"
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[CellGroupData[{

Cell["Example 6. Inflection", "Subsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Definition.",
    FontWeight->"Bold"],
  "  ",
  StyleBox["A simple point (= ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["1",
        FontWeight->"Bold"]]],
  StyleBox["-tuple point)  on a curve is an",
    FontWeight->"Plain"],
  " ",
  StyleBox["inflection point",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" ",
    FontWeight->"Bold"],
  StyleBox["if the tangent to the curve at the point has degree of contact ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["3",
        FontWeight->"Bold"]]],
  StyleBox[" or more.",
    FontWeight->"Plain"]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  Background->RGBColor[1, 1, 0]],

Cell[TextData[{
  StyleBox["Theorem. ",
    FontWeight->"Bold"],
  " ",
  StyleBox["A point ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["p",
        FontWeight->"Bold"]]],
  StyleBox[" is an inflection point on a curve ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["of degree ",
    FontWeight->"Plain"],
  Cell[BoxData[
      StyleBox["n",
        FontWeight->"Bold"]]],
  " ",
  StyleBox["if, and only if, we have these",
    FontWeight->"Plain"],
  " ",
  StyleBox["three",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  StyleBox["conditions satisfied:",
    FontWeight->"Plain"],
  " \n\n\t",
  StyleBox["(",
    FontWeight->"Bold"],
  StyleBox["i ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[")    ",
    FontWeight->"Bold"],
  Cell[BoxData[
      \(PD[f, p\^n] == 0\)],
    FontWeight->"Bold"],
  ", \n\t",
  StyleBox["(",
    FontWeight->"Bold"],
  StyleBox["ii ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[")   ",
    FontWeight->"Bold"],
  Cell[BoxData[
      StyleBox[\(PD[f, p\^\(n - 1\)] \[NotEqual] 0\),
        FontWeight->"Bold"]]],
  ", \n\t",
  StyleBox["(",
    FontWeight->"Bold"],
  StyleBox["iii ",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[")  ",
    FontWeight->"Bold"],
  Cell[BoxData[
      \(PD[f, p\^\(n - 2\)]\)],
    FontWeight->"Bold"],
  StyleBox["factors into ",
    FontWeight->"Plain"],
  StyleBox["linear factors",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[".",
    FontWeight->"Plain"],
  StyleBox[" ",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

