Cell[CellGroupData[{

Cell["Note", "Subsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[StyleBox["This is a revised and expanded version of the \
notebook used at the 2006 Wolfram Technology Conference.   All input cells \
have been made inactive, as the necessary inplementations used for the \
coursework are not included.  Please contact the author if you are interested \
in seeing more.",
  FontSize->18]], "SmallText",
  CellAutoOverwrite->False]
}, Closed]],

Cell[CellGroupData[{

Cell["Dedication", "Section",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["\n\n", "Text",
    FontWeight->"Bold"],
  StyleBox["To the memories of", "Text",
    FontSize->24,
    FontWeight->"Bold"],
  StyleBox[" ", "Text",
    FontWeight->"Bold"]
}], "SmallText",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["    Alfred Tarski",
    FontSize->32,
    FontWeight->"Bold",
    FontColor->RGBColor[0.998367, 0, 0.00427253]],
  StyleBox["\n                    ",
    FontSize->16,
    FontWeight->"Bold",
    FontColor->RGBColor[0.998367, 0, 0.00427253]],
  StyleBox["1902 - 1983               &",
    FontSize->18,
    FontWeight->"Bold"],
  StyleBox[" ",
    FontSize->16,
    FontWeight->"Bold"],
  StyleBox["\n\t\t",
    FontSize->18,
    FontWeight->"Bold"],
  StyleBox["Abraham Seidenberg",
    FontSize->32,
    FontWeight->"Bold",
    FontColor->RGBColor[0.998367, 0, 0.00427253]],
  StyleBox["\n\t\t\t      1916 - 1988",
    FontSize->18,
    FontWeight->"Bold"]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["\t",
    FontWeight->"Bold"],
  StyleBox["\[LongDash]two amazing teachers, \n\tboth with a real love for \
geometry.",
    FontSize->24,
    FontWeight->"Bold"],
  StyleBox["\n\n\n\n\n\n\n\n\n\n\n\n\n",
    FontWeight->"Bold"]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[CellGroupData[{

Cell["Some Background", "Section",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Over four years (",
    FontSize->18],
  StyleBox["1989",
    FontSize->18,
    FontWeight->"Bold"],
  StyleBox[", ",
    FontSize->18],
  StyleBox["1993",
    FontSize->18,
    FontWeight->"Bold"],
  StyleBox[", ",
    FontSize->18],
  StyleBox["1997",
    FontSize->18,
    FontWeight->"Bold"],
  StyleBox[", ",
    FontSize->18],
  StyleBox["1998",
    FontSize->18,
    FontWeight->"Bold"],
  StyleBox["), the author offered at Carnegie Mellon University a \
one-semester course on algebraic curves in the classical complex projective \
plane.  The lectures and homework were presented in ",
    FontSize->18],
  StyleBox["Mathematica",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[".",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["The well-known ",
    FontSize->18],
  StyleBox["duality",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" between points and lines in projective geometry can be \
approached either ",
    FontSize->18],
  StyleBox["axiomatically",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" (by giving a symmetric formulation to axioms and thus to proofs) \
or ",
    FontSize->18],
  StyleBox["transformationally",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" (by invoking correlations, often effected by conic sections).  ",
    
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["What is not so well known is that this duality can be extended to \
",
    FontSize->18],
  StyleBox["higher-degree loci",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[", relating point ranges (i.e., ",
    FontSize->18],
  StyleBox["curves",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[") to line configurations (i.e., ",
    FontSize->18],
  StyleBox["envelopes of tangents",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[").  ",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["The course managed to work through the ",
    FontSize->18],
  StyleBox["projective classification of cubic curves",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[".\n\n\n\n\n\n\n\n",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[CellGroupData[{

Cell["Some Difficulties ", "Section",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["\nMost",
    FontSize->18],
  StyleBox[" ",
    FontSize->24],
  StyleBox["Mathematicians",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " do not really trust ",
  StyleBox["computers",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  FontSize->18],

Cell[TextData[{
  StyleBox["Most ",
    FontSize->18],
  StyleBox["Computer Scientists",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" are not so interested in ",
    FontSize->18],
  StyleBox["proofs",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[".",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  FontSize->18],

Cell[TextData[{
  StyleBox["Most ",
    FontSize->18],
  StyleBox["Departments",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" do not want to support ",
    FontSize->18],
  StyleBox["software",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[".",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  FontSize->18],

Cell[TextData[{
  StyleBox["Most ",
    FontSize->18],
  StyleBox["Students",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" have fairly little interest in ",
    FontSize->18],
  StyleBox["geometry",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[".\n\n\t",
    FontSize->18],
  StyleBox["OK. OK.  I know I exaggerate!  \n \t    But there is much truth \
in what I say.",
    FontSize->18,
    FontWeight->"Bold",
    FontColor->RGBColor[0.501961, 0, 0.25098]],
  StyleBox["\n",
    FontSize->18,
    FontColor->RGBColor[0.501961, 0, 0.25098]],
  StyleBox["\n\n\n\n\n\n\n\n\n\n\n\n\n\n",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  FontSize->18]
}, Closed]],

Cell[CellGroupData[{

Cell["Some Undecidable Theories", "Section",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["\n\nTheorem. [J. Robinson, 1949]  ",
    FontSize->18,
    FontWeight->"Bold"],
  StyleBox["The first-order theory of the field ",
    FontSize->18],
  Cell[BoxData[
      StyleBox[\(\[LeftAngleBracket]\[DoubleStruckCapitalQ], \(+\(\(,\)\(\
\[CenterDot]\)\)\)\[RightAngleBracket]\),
        FontWeight->"Bold"]]],
  StyleBox[" of rational numbers is ",
    FontSize->18],
  StyleBox["undecidable",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[".",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "\nLet ",
  Cell[BoxData[
      StyleBox[\(\[DoubleStruckCapitalP] \[Equal] \[DoubleStruckCapitalC][x, 
            y, z]\),
        FontWeight->"Bold"]]],
  "be the ",
  StyleBox["ring of polynomials",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " in three generators over the complex field ",
  Cell[BoxData[
      StyleBox["\[DoubleStruckCapitalC]",
        FontWeight->"Bold"]]],
  ". "
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Theorem.",
    FontWeight->"Bold"],
  " ",
  StyleBox["[R.M. Robinson, 1951]",
    FontWeight->"Bold"],
  "  The first-order theory of the ring ",
  Cell[BoxData[
      StyleBox[
        RowBox[{"\[LeftAngleBracket]", 
          RowBox[{
            StyleBox["\[DoubleStruckCapitalP]",
              FontWeight->"Bold"], ",", \(+\(\(,\)\(\[CenterDot]\)\)\)}], 
          "\[RightAngleBracket]"}],
        FontWeight->"Bold"]]],
  " is ",
  StyleBox["undecidable",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[CellGroupData[{

Cell["Some Decidable Theories", "Section",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "Now let ",
  Cell[BoxData[
      StyleBox[
        RowBox[{\(\[DoubleStruckCapitalP]\^n\), "\[Equal]", 
          RowBox[{
            SuperscriptBox[
              StyleBox["\[DoubleStruckCapitalC]",
                FontWeight->"Bold"], "n"], "[", \(x, y, z\), "]"}]}],
        FontWeight->"Bold"]]],
  "be the (linear vector space of) ",
  StyleBox["homogeneous polynomials",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " in three generators over the complex field ",
  Cell[BoxData[
      StyleBox["\[DoubleStruckCapitalC]",
        FontWeight->"Bold"]]],
  " of degree ",
  Cell[BoxData[
      StyleBox["n",
        FontWeight->"Bold"]]],
  ".  This space has ",
  StyleBox["linear dimension",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      StyleBox[\(1\/2\ \((n + 1)\)\ \((n + 2)\)\),
        FontSize->16,
        FontWeight->"Bold"]]],
  ".  We can regard the whole polynomial ring as a ",
  StyleBox["\"weak direct sum\"",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " as follows:  ",
  Cell[BoxData[
      StyleBox[\(\[DoubleStruckCapitalP] \[Equal] \[Sum]\+\(n = 0\)\%\
\[Infinity] \[DoubleStruckCapitalP]\^n\),
        FontWeight->"Bold"]]],
  ". "
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Theorem.",
    FontWeight->"Bold"],
  " ",
  StyleBox["[A. Tarski, 1949?]",
    FontWeight->"Bold"],
  " The first-order theory of the complex-number field ",
  Cell[BoxData[
      RowBox[{
        RowBox[{"\[LeftAngleBracket]", 
          RowBox[{
            StyleBox["\[DoubleStruckCapitalC]",
              FontWeight->"Bold"], ",", \(+\(\(,\)\(\[CenterDot]\)\)\)}], 
          "\[RightAngleBracket]"}], 
        StyleBox["\[Equal]",
          FontWeight->"Bold"], 
        RowBox[{"\[LeftAngleBracket]", 
          RowBox[{
            SuperscriptBox[
              StyleBox["\[DoubleStruckCapitalP]",
                FontWeight->"Bold"], 
              StyleBox["0",
                FontWeight->"Bold"]], ",", \(+\(\(,\)\(\[CenterDot]\)\)\)}], 
          "\[RightAngleBracket]"}]}]]],
  " is ",
  StyleBox["decidable",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".\n\nThe proof can be thrown back to the decision method for the field of \
",
  StyleBox["real numbers",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[".",
    FontSlant->"Italic"],
  "  A better proof can be  given in terms of ",
  StyleBox["Gr\[ODoubleDot]bner Bases",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Theorem.",
    FontWeight->"Bold"],
  " ",
  StyleBox["[Scott, 2006?]",
    FontWeight->"Bold"],
  " The ",
  StyleBox["multi-sorted",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " first-order theory of the structure ",
  Cell[BoxData[
      RowBox[{
        SuperscriptBox[
          StyleBox["\[DoubleStruckCapitalP]",
            FontWeight->"Bold"], "*"], 
        StyleBox["==",
          FontWeight->"Bold"], 
        RowBox[{"\[LeftAngleBracket]", 
          RowBox[{
            SuperscriptBox[
              StyleBox["\[DoubleStruckCapitalP]",
                FontWeight->"Bold"], "0"], ",", 
            SuperscriptBox[
              StyleBox["\[DoubleStruckCapitalP]",
                FontWeight->"Bold"], "1"], ",", 
            SuperscriptBox[
              StyleBox["\[DoubleStruckCapitalP]",
                FontWeight->"Bold"], "2"], ",", "\[Ellipsis]", ",", 
            SuperscriptBox[
              StyleBox["\[DoubleStruckCapitalP]",
                FontWeight->"Bold"], "n"], ",", "\[Ellipsis]", 
            ",", \(+\(\(,\)\(\[CenterDot]\)\)\)}], 
          "\[RightAngleBracket]"}]}]],
    FontWeight->"Bold"],
  " is ",
  StyleBox["decidable",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".",
  StyleBox[" \n\n\t",
    FontSize->18],
  StyleBox["A ",
    FontSize->18,
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["practical",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox[" proof would be welcome!",
    FontSize->18,
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["\n\n\n\n\n\n\n\n\n\n\n",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[CellGroupData[{

Cell["The Dual Ring", "Section",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "Consider the ",
  StyleBox["ring of differential operators",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " on ",
  Cell[BoxData[
      StyleBox[\(\[DoubleStruckCapitalC][x, y, z]\),
        FontWeight->"Bold"]]],
  " generated by the operators ",
  Cell[BoxData[
      StyleBox[\(\[PartialD]\(\(/\)\(\[PartialD]x\)\)\),
        FontWeight->"Bold"]], "InputInline"],
  ", ",
  Cell[BoxData[
      StyleBox[\(\[PartialD]\(\(/\)\(\[PartialD]y\)\)\),
        FontWeight->"Bold"]], "InputInline"],
  ", and ",
  Cell[BoxData[
      StyleBox[\(\[PartialD]\(\(/\)\(\[PartialD]z\)\)\),
        FontWeight->"Bold"]], "InputInline"],
  " ."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "Let us write ",
  Cell[BoxData[
      StyleBox[\(\[DoubleStruckCapitalD] \[Equal] \[DoubleStruckCapitalC][u, 
            v, w]\),
        FontWeight->"Bold"]]],
  " for this ring, where the symbols \n\n             ",
  Cell[BoxData[
      StyleBox[\(u \[Equal] \[PartialD]\(\(/\)\(\[PartialD]x\)\)\),
        FontWeight->"Bold"]]],
  ",     ",
  Cell[BoxData[
      StyleBox[\(v \[Equal] \[PartialD]\(\(/\)\(\[PartialD]y\)\)\),
        FontWeight->"Bold"]]],
  ", and     ",
  Cell[BoxData[
      StyleBox[\(w \[Equal] \[PartialD]\(\(/\)\(\[PartialD]z\)\)\),
        FontWeight->"Bold"]]],
  " \n\nare introduced as a ",
  StyleBox["shorthand",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  Background->RGBColor[1, 1, 0]],

Cell[TextData[{
  StyleBox["Theorem. [Exercise]",
    FontWeight->"Bold"],
  "  The rings ",
  Cell[BoxData[
      StyleBox["\[DoubleStruckCapitalP]",
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox["\[DoubleStruckCapitalD]",
        FontWeight->"Bold"]]],
  " are ",
  StyleBox["isomorphic",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".",
  StyleBox[" ",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["\tThis is a (small) first step to ",
    FontSize->18],
  StyleBox["duality",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[".\n\n\n\n\n\n\n\n\n\n\n\n\n",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[CellGroupData[{

Cell["Polydifferentiation", "Section",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "\nDecompose the ring ",
  Cell[BoxData[
      StyleBox["\[DoubleStruckCapitalD]",
        FontWeight->"Bold"]]],
  " into its homogeneous parts: ",
  Cell[BoxData[
      StyleBox[\(\[DoubleStruckCapitalD] \[Equal] \[Sum]\+\(n = 0\)\%\
\[Infinity] \[DoubleStruckCapitalD]\^n\),
        FontWeight->"Bold"]]],
  ".  "
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "For a polynomial ",
  Cell[BoxData[
      StyleBox[\(f \[Element] \[DoubleStruckCapitalP]\^n\),
        FontWeight->"Bold"]]],
  " and a polynomial ",
  Cell[BoxData[
      StyleBox[\(g \[Element] \[DoubleStruckCapitalD]\^m\),
        FontWeight->"Bold"]]],
  "  in case ",
  Cell[BoxData[
      StyleBox[\(m \[LessEqual] n\),
        FontWeight->"Bold"]]],
  " let ",
  Cell[BoxData[
      StyleBox[\(f\ \[CapitalDifferentialD]g\),
        FontWeight->"Bold"]]],
  " denote the result of letting ",
  Cell[BoxData[
      StyleBox["g",
        FontWeight->"Bold"]]],
  " operate on ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " as a ",
  StyleBox["differential operator",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  Then ",
  Cell[BoxData[
      StyleBox[\(f\ \[CapitalDifferentialD]g \[Element] \
\[DoubleStruckCapitalP]\^\(n - m\)\),
        FontWeight->"Bold"]]],
  ". "
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  Background->RGBColor[1, 1, 0]],

Cell[TextData[{
  "In case ",
  Cell[BoxData[
      StyleBox[\(m \[GreaterEqual] n\),
        FontWeight->"Bold"]]],
  ",  let ",
  Cell[BoxData[
      StyleBox[\(f\ \[CapitalDifferentialD]g\),
        FontWeight->"Bold"]]],
  " denote the result of letting ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " operate on ",
  Cell[BoxData[
      StyleBox["g",
        FontWeight->"Bold"]]],
  " as a ",
  StyleBox["differential operator",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", (allowed because the rings ",
  Cell[BoxData[
      StyleBox["\[DoubleStruckCapitalP]",
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox["\[DoubleStruckCapitalD]",
        FontWeight->"Bold"]]],
  " are isomorphic).  Then, ",
  Cell[BoxData[
      StyleBox[\(f\ \[CapitalDifferentialD]g \[Element] \
\[DoubleStruckCapitalD]\^\(m - n\)\),
        FontWeight->"Bold"]]],
  "."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  Background->RGBColor[0, 1, 0.501961]],

Cell[TextData[{
  StyleBox["Theorem.",
    FontWeight->"Bold"],
  "  If ",
  Cell[BoxData[
      StyleBox[\(f \[Element] \[DoubleStruckCapitalP]\^n\),
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox[\(g \[Element] \[DoubleStruckCapitalD]\^n\),
        FontWeight->"Bold"]]],
  ", then the meaning of ",
  Cell[BoxData[
      StyleBox[\(f\ \[CapitalDifferentialD]g \[Element] \
\[DoubleStruckCapitalC]\),
        FontWeight->"Bold"]]],
  " is ",
  StyleBox["the same",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " whether we let ",
  Cell[BoxData[
      StyleBox["g",
        FontWeight->"Bold"]]],
  " be the operator or let ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " be the operator.  \n\n\t",
  StyleBox["Hint:",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " Think of how the ",
  StyleBox["monomials",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      StyleBox[\(\(x\^i\) \(y\^j\) z\^k\),
        FontWeight->"Bold"]]],
  " behave."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Theorem. ",
    FontWeight->"Bold"],
  "Since differentiation is a ",
  StyleBox["linear",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " operation, the vector spaces ",
  Cell[BoxData[
      StyleBox[\(\[DoubleStruckCapitalP]\^n\),
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox[\(\[DoubleStruckCapitalD]\^n\),
        FontWeight->"Bold"]]],
  " are ",
  StyleBox["dual",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " to each other with the operation ",
  Cell[BoxData[
      StyleBox["\[CapitalDifferentialD]",
        FontWeight->"Bold"]]],
  " as the ",
  StyleBox["dual paring",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".",
  StyleBox[" \n\n\t",
    FontSize->18],
  StyleBox["This is another step to ",
    FontSize->18,
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["duality",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox[".",
    FontSize->18,
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["\n\n\n\n\n\n\n\n",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[CellGroupData[{

Cell["Axioms for Differentiation", "Section",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Theorem. ",
    FontWeight->"Bold"],
  "The following  ",
  StyleBox["five",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " algebraic properties ",
  StyleBox["uniquely determine",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the operation ",
  Cell[BoxData[
      StyleBox["\[CapitalDifferentialD]",
        FontWeight->"Bold"]]],
  " of ",
  StyleBox["polydifferentiation",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " operating on pairs of dual homogeneous polynomials of any degrees:\n\n",
  StyleBox["1. ",
    FontWeight->"Bold"],
  "Polydifferentiation ",
  StyleBox["subtracts",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " degrees:\n\t",
  Cell[BoxData[
      StyleBox[
        RowBox[{"\[CapitalDifferentialD]", 
          RowBox[{":", 
            RowBox[{\(\[DoubleStruckCapitalP]\^n\), "\[Times]", " ", 
              
              RowBox[{\(\[DoubleStruckCapitalD]\^m\), "\[LongRightArrow]", 
                " ", 
                SuperscriptBox["\[DoubleStruckCapitalP]", 
                  RowBox[{"n", 
                    StyleBox["-",
                      FontWeight->"Bold"], "m"}]]}]}]}]}],
        FontWeight->"Bold"]]],
  ", if ",
  Cell[BoxData[
      StyleBox[\(m < n\),
        FontWeight->"Bold"]]],
  "; \n\t",
  Cell[BoxData[
      StyleBox[
        RowBox[{"\[CapitalDifferentialD]", 
          RowBox[{":", 
            RowBox[{\(\[DoubleStruckCapitalP]\^n\), "\[Times]", " ", 
              
              RowBox[{\(\[DoubleStruckCapitalD]\^m\), "\[LongRightArrow]", 
                " ", 
                SuperscriptBox["\[DoubleStruckCapitalD]", 
                  RowBox[{"m", 
                    StyleBox["-",
                      FontWeight->"Bold"], "n"}]]}]}]}]}],
        FontWeight->"Bold"]]],
  ", if ",
  Cell[BoxData[
      StyleBox[\(m > n\),
        FontWeight->"Bold"]]],
  "; and\n\t",
  Cell[BoxData[
      StyleBox[\(\[CapitalDifferentialD]\(\(:\)\(\[DoubleStruckCapitalP]\^n\
\[Times]\ \[DoubleStruckCapitalD]\^n\[LongRightArrow]\ \
\[DoubleStruckCapitalC]\)\)\),
        FontWeight->"Bold"]]],
  ", if  ",
  Cell[BoxData[
      StyleBox[\(m \[Equal] n\),
        FontWeight->"Bold"]]],
  ".\n\t\t\n",
  StyleBox["2.  ",
    FontWeight->"Bold"],
  "Polydifferentiation is ",
  StyleBox["bilinear",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ":\n\t",
  Cell[BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"(", 
            StyleBox[\(a\ f\_1 + b\ f\_2\),
              FontWeight->"Bold"], 
            StyleBox[")",
              FontWeight->"Bold"]}], 
          StyleBox[\(\[CapitalDifferentialD]\ g\),
            FontWeight->"Bold"]}], 
        StyleBox["==",
          FontWeight->"Bold"], 
        StyleBox[\(a\ \((\(f\_1\) \[CapitalDifferentialD]\ g)\) + 
            b\ \((\(f\_2\) \[CapitalDifferentialD]\ g)\)\),
          FontWeight->"Bold"]}]]],
  ", and\n\t",
  Cell[BoxData[
      RowBox[{
        StyleBox[\(f\ \[CapitalDifferentialD]\ \((a\ g\_1 + b\ g\_2)\)\),
          FontWeight->"Bold"], 
        StyleBox["==",
          FontWeight->"Bold"], 
        RowBox[{
          StyleBox[\(a\ \((f \[CapitalDifferentialD]\ g\_1)\)\),
            FontWeight->"Bold"], 
          StyleBox["+",
            FontWeight->"Bold"], 
          RowBox[{
            StyleBox["b",
              FontWeight->"Bold"], 
            StyleBox[" ",
              FontWeight->"Bold"], 
            RowBox[{
              StyleBox["(",
                FontWeight->"Bold"], 
              RowBox[{"f", 
                StyleBox[\(\[CapitalDifferentialD]\ g\_2\),
                  FontWeight->"Bold"]}], 
              StyleBox[")",
                FontWeight->"Bold"]}]}]}]}]]],
  ".\n\t\t\n",
  StyleBox["3.  ",
    FontWeight->"Bold"],
  "Polydifferentiation is ",
  StyleBox["associative",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", in the sense that these four equations hold:\n",
  StyleBox["\t  ",
    FontFamily->"Courier"],
  Cell[BoxData[
      StyleBox[\(f\ \[CapitalDifferentialD]\ 1 == f\),
        FontWeight->"Bold"]]],
  ",\n",
  StyleBox["      ",
    FontFamily->"Courier"],
  Cell[BoxData[
      StyleBox[\(1 \[CapitalDifferentialD]\ g == g\),
        FontWeight->"Bold"]]],
  ",",
  StyleBox["\t\t\t\n",
    FontFamily->"Courier"],
  StyleBox["\t  ",
    FontFamily->"Courier",
    FontWeight->"Bold"],
  Cell[BoxData[
      StyleBox[\(f\ \[CapitalDifferentialD]\ \((g\_1\ g\_2)\) == \((f\ \
\[CapitalDifferentialD]g\_1)\) \[CapitalDifferentialD]\ g\_2\),
        FontWeight->"Bold"]]],
  ", \n\t  \t\tprovided ",
  Cell[BoxData[
      StyleBox[\(deg[g\_1\ g\_2] \[LessEqual] deg[f]\),
        FontWeight->"Bold"]]],
  ",",
  StyleBox[" \n\t  ",
    FontFamily->"Courier",
    FontWeight->"Bold"],
  Cell[BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"(", 
            StyleBox[\(f\_1\ f\_2\),
              FontWeight->"Bold"], 
            StyleBox[")",
              FontWeight->"Bold"]}], 
          StyleBox[\(\[CapitalDifferentialD]\ g\),
            FontWeight->"Bold"]}], 
        StyleBox["==",
          FontWeight->"Bold"], 
        StyleBox[\(\(f\_1\) \[CapitalDifferentialD]\((f\_2\ \
\[CapitalDifferentialD]\ g)\)\),
          FontWeight->"Bold"]}]]],
  ", \n\t  \t\tprovided ",
  Cell[BoxData[
      StyleBox[\(deg[f\_1\ f\_2] \[LessEqual] deg[g]\),
        FontWeight->"Bold"]]],
  ".\n\t\t  ",
  StyleBox["\t",
    FontFamily->"Courier",
    FontWeight->"Bold"],
  "\n",
  StyleBox["4. ",
    FontWeight->"Bold"],
  " The vector space ",
  Cell[BoxData[
      StyleBox[\(\[DoubleStruckCapitalP]\^1\),
        FontWeight->"Bold"]]],
  " of ",
  StyleBox["linear",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " homogeneous ",
  Cell[BoxData[
      StyleBox["xyz",
        FontWeight->"Bold"]]],
  "-polynomials is ",
  StyleBox["dual",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "  to the vector space ",
  Cell[BoxData[
      StyleBox[\(\[DoubleStruckCapitalD]\^1\),
        FontWeight->"Bold"]]],
  " of ",
  StyleBox["linear",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " homogeneous ",
  Cell[BoxData[
      StyleBox["uvw",
        FontWeight->"Bold"]]],
  "-polynomials, as shown by:\n",
  StyleBox["  ",
    FontSize->9],
  "\n\t",
  Cell[BoxData[
      StyleBox[
        RowBox[{
          TagBox[
            RowBox[{"(", "\[NoBreak]", GridBox[{
                  {\(x \[CapitalDifferentialD]\ 
                        u\), \(x \[CapitalDifferentialD]\ 
                        v\), \(x \[CapitalDifferentialD]\ w\)},
                  {\(y \[CapitalDifferentialD]\ 
                        u\), \(y \[CapitalDifferentialD]\ 
                        v\), \(y \[CapitalDifferentialD]\ w\)},
                  {\(z \[CapitalDifferentialD]\ 
                        u\), \(z \[CapitalDifferentialD]\ 
                        v\), \(z \[CapitalDifferentialD]\ w\)}
                  }], "\[NoBreak]", ")"}],
            Function[ BoxForm`e$, 
              MatrixForm[ BoxForm`e$]]], "\[Equal]", 
          TagBox[
            RowBox[{"(", "\[NoBreak]", GridBox[{
                  {"1", "0", "0"},
                  {"0", "1", "0"},
                  {"0", "0", "1"}
                  }], "\[NoBreak]", ")"}],
            Function[ BoxForm`e$, 
              MatrixForm[ BoxForm`e$]]]}],
        FontWeight->"Bold"]]],
  ".\n\t\t\n",
  StyleBox["5.",
    FontWeight->"Bold"],
  "  Polydifferentiation is a ",
  StyleBox["derivative",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox[" ",
    FontWeight->"Bold"],
  StyleBox["operator",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", which means that for ",
  StyleBox["linear",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " polynomials ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " and ",
  Cell[BoxData[
      StyleBox["g",
        FontWeight->"Bold"]]],
  StyleBox[" ",
    FontWeight->"Bold"],
  "we have:\n",
  StyleBox["   ",
    FontSize->9],
  "\n\t",
  Cell[BoxData[
      StyleBox[
        RowBox[{
          RowBox[{\((\(f\_1\) f\_2)\), 
            RowBox[{"\[CapitalDifferentialD]", " ", 
              StyleBox["g",
                FontWeight->"Bold"]}]}], 
          "==", \(\((f\_1\ \[CapitalDifferentialD]\ 
                    g)\)\ f\_2 + \((\(f\_2\) \[CapitalDifferentialD]g)\)\ \
f\_1\)}],
        FontWeight->"Bold"]]],
  ", and\n\t ",
  Cell[BoxData[
      StyleBox[
        RowBox[{\(f \[CapitalDifferentialD]\((g\_1\ g\_2)\)\), "==", 
          RowBox[{
            RowBox[{
              RowBox[{
                StyleBox["(",
                  FontWeight->"Bold"], 
                RowBox[{"f", 
                  StyleBox[" ",
                    FontWeight->"Bold"], 
                  RowBox[{"\[CapitalDifferentialD]", " ", 
                    StyleBox[\(g\_1\),
                      FontWeight->"Bold"]}]}], 
                StyleBox[")",
                  FontWeight->"Bold"]}], 
              StyleBox[" ",
                FontWeight->"Bold"], 
              StyleBox[\(g\_2\),
                FontWeight->"Bold"]}], "+", 
            RowBox[{
              RowBox[{
                StyleBox["(",
                  FontWeight->"Bold"], 
                RowBox[{"f", 
                  StyleBox[" ",
                    FontWeight->"Bold"], 
                  RowBox[{"\[CapitalDifferentialD]", " ", 
                    StyleBox[\(g\_2\),
                      FontWeight->"Bold"]}]}], 
                StyleBox[")",
                  FontWeight->"Bold"]}], " ", \(g\_1\)}]}]}],
        FontWeight->"Bold"]]],
  ".\n\t\t"
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Theorem.",
    FontWeight->"Bold"],
  "  The ",
  StyleBox["multi-sorted",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " first-order theory of the structure  \n ",
  Cell[BoxData[
      RowBox[{
        SuperscriptBox[
          StyleBox[
            RowBox[{
              StyleBox["\[DoubleStruckCapitalP]",
                FontWeight->"Bold"], "\[DoubleStruckCapitalD]"}]], "*"], 
        StyleBox["==",
          FontWeight->"Bold"], 
        RowBox[{"\[LeftAngleBracket]", 
          RowBox[{
          "\[DoubleStruckCapitalC]", ",", \(\[DoubleStruckCapitalP]\^1\), ",",
             
            SuperscriptBox[
              StyleBox["\[DoubleStruckCapitalP]",
                FontWeight->"Bold"], "2"], ",", "\[Ellipsis]", ",", 
            SuperscriptBox[
              StyleBox["\[DoubleStruckCapitalP]",
                FontWeight->"Bold"], "n"], ",", "\[Ellipsis]", 
            ",", \(\[DoubleStruckCapitalD]\^1\), 
            ",", \(\[DoubleStruckCapitalD]\^2\), ",", "\[Ellipsis]", 
            ",", \(\[DoubleStruckCapitalD]\^n\), ",", "\[Ellipsis]", 
            ",", \(+\(\(,\)\(\(\[CenterDot]\)\(\(,\)\(\[CapitalDifferentialD]\
\)\)\)\)\)}], "\[RightAngleBracket]"}]}]],
    FontWeight->"Bold"],
  " \n \nis ",
  StyleBox["decidable",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  Background->RGBColor[0, 1, 1]],

Cell[TextData[{
  "\n\t",
  StyleBox["A ",
    FontSize->18,
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["practical",
    FontSize->18,
    FontWeight->"Bold",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox[" proof would be welcome!",
    FontSize->18,
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["\n",
    FontSize->18],
  "\n\n\n\n\n\n\n\n\n\n\n\n\n"
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
  "A ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " Implementation"
}], "Section",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " well implements ",
  StyleBox["commutative algebra",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " (and many algebraic algorithms) and of course it implements ",
  StyleBox["partial differentiation",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  It does not directly implement an ",
  StyleBox["algebra",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of differential operators, however.  "
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "With the help of graduate-student assistants\[LongDash]we were able to do \
that by defining first the function ",
  Cell[BoxData[
      StyleBox["DegP",
        FontWeight->"Bold"]]],
  " for computing the ",
  StyleBox["degree",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of homogeneous polynomials, and by transcribing the axiomatic \
characterization of ",
  Cell[BoxData[
      StyleBox["\[CapitalDifferentialD]",
        FontWeight->"Bold"]]],
  " into ",
  StyleBox["rewrite rules",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " between the two kinds of polynomials using ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  " rule sets.  ",
  StyleBox["(In ",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["Mathematica",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox[" notation, we had to write ",
    FontColor->RGBColor[1, 0, 0]],
  Cell[BoxData[
      StyleBox[\(f\ \[CapitalDifferentialD]g\),
        FontWeight->"Bold"]],
    FontColor->RGBColor[1, 0, 0]],
  StyleBox[" as ",
    FontColor->RGBColor[1, 0, 0]],
  Cell[BoxData[
      StyleBox[\(PD[f, g]\),
        FontWeight->"Bold"]],
    FontColor->RGBColor[1, 0, 0]],
  StyleBox[".) ",
    FontColor->RGBColor[1, 0, 0]],
  "  "
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "This made it possible to ",
  StyleBox["prove",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " facts about ",
  StyleBox["all",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " homogeneous polynomials of a given degree without having to represent \
polynomials ",
  StyleBox["via",
    FontSlant->"Italic"],
  " ",
  StyleBox["suites of coefficients",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "Additionally some ideas of ",
  StyleBox["exterior algebra",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " had to be represented (on linear forms), and some polynomial invariants \
using ",
  StyleBox["determinants",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " had to be used.  "
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "Otherwise, ",
  StyleBox["polynomial simplification",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", ",
  StyleBox["factorization",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", and ",
  StyleBox["root findin",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  StyleBox["g",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " (all built into ",
  StyleBox["Mathematica",
    FontSlant->"Italic"],
  ") were the basic constructs needed.  To solve ",
  StyleBox["implicit",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " characterizations of curves, ",
  StyleBox["elimination theory algorithms",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " also had to be used."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "One big advantage discovered by using symbolic computation in this way was \
that ",
  StyleBox["formulae",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " for the solution of geometric problems could be developed and then used \
in numerical computation (for example, in creating ",
  StyleBox["graphical illustrations",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "). "
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  Background->RGBColor[0, 1, 0.501961]],

Cell["\<\
 











\
\>", "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[CellGroupData[{

Cell["Some Examples", "Section",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell["Example 1. Evaluation", "Subsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Theorem. [Euler]",
    FontWeight->"Bold"],
  " If ",
  Cell[BoxData[
      StyleBox["f",
        FontWeight->"Bold"]]],
  " is a homogeneous ",
  Cell[BoxData[
      StyleBox["xyz",
        FontWeight->"Bold"]]],
  "-polynomial of degree ",
  Cell[BoxData[
      StyleBox["n",
        FontWeight->"Bold"]]],
  ", and if ",
  Cell[BoxData[
      StyleBox["g",
        FontWeight->"Bold"]]],
  " is the ",
  StyleBox["linear form",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "  ",
  Cell[BoxData[
      StyleBox[\(a\ u + b\ v + c\ w\),
        FontWeight->"Bold"]]],
  ", then we have \n\t\t",
  Cell[BoxData[
      StyleBox[\(f\ \[CapitalDifferentialD]g\^n \[Equal] \(n!\)\ f[a, b, c]\),
        
        FontWeight->"Bold"]]],
  ", \n\t\t\t\nwhere ",
  Cell[BoxData[
      StyleBox[\(f[a, b, c]\),
