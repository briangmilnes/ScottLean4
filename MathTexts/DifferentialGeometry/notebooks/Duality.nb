Cell[CellGroupData[{

Cell["Example 9. Euclidean Geometry", "Subsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Euclidean transformations",
  FontWeight->"Bold"]], "Subsubsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Projective geometry is a ",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["generalization",
    FontWeight->"Bold",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox[" of ordinary geometry\[LongDash]one might say it is a ",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["completion",
    FontWeight->"Bold",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox[" by adjoining the line at infinity ",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["and",
    FontWeight->"Bold",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox[" by using complex numbers.  But there is a reverse procedure as \
well: ",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["deriving the Euclidean world from the projective.",
    FontWeight->"Bold",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "In order to understand the connection between projective and Euclidean \
geometry, we note first that we can show that ",
  StyleBox["circles",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " are exactly the conics which pass through the two, fixed, complex, \
so-called ",
  StyleBox["circular points at infinity",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", namely the two points ",
  Cell[BoxData[
      StyleBox[\(u \[PlusMinus] \[ImaginaryI]\ v\),
        FontWeight->"Bold"]]],
  ".  "
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Definition.",
    FontWeight->"Bold"],
  "  ",
  StyleBox["Euclidean transformations",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " are the projective transformations which map circles to circles.  There \
are two kinds: the ",
  StyleBox["direct",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " transformations that the leave the points ",
  Cell[BoxData[
      \(u \[PlusMinus] \[ImaginaryI]\ v\)],
    FontWeight->"Bold"],
  " fixed, and the ",
  StyleBox["opposite",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " transformations that interchange the two points."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  Background->RGBColor[1, 1, 0]],

Cell["It follows at once that we have:", "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Theorem.",
    FontWeight->"Bold"],
  " The Euclidean transformations form a ",
  StyleBox["subgroup",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of the group of all projective transformations, and the direct \
transformations form a smaller subgroup.  "
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[CellGroupData[{

Cell["Getting circles", "Subsubsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  "Consider the general ",
  StyleBox["quadratic",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[
    \(f\  = Table[a\_i, {i, 1, 6}] . Bxyz[2]\)], "Input",
  CellLabel->"In[454]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \(x\^2\ a\_1 + x\ y\ a\_2 + y\^2\ a\_3 + x\ z\ a\_4 + y\ z\ a\_5 + 
      z\^2\ a\_6\)], "Output",
  CellLabel->"Out[454]=",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[TextData[{
  "Suppose it passes through the ",
  StyleBox["circular points",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " at infinity."
}], "Text",
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[
    \({PD[f, \((u + \[ImaginaryI]\ v)\)\^2], 
        PD[f, \((u - \[ImaginaryI]\ v)\)\^2]} // ExpandAll\)], "Input",
  CellLabel->"In[456]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \({2\ a\_1 + 2\ \[ImaginaryI]\ a\_2 - 2\ a\_3, 
      2\ a\_1 - 2\ \[ImaginaryI]\ a\_2 - 2\ a\_3}\)], "Output",
  CellLabel->"Out[456]=",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[TextData[{
  "The polynomial must ",
  StyleBox["simplify",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[
    \(Solve[{2\ a\_1 + 2\ \[ImaginaryI]\ a\_2 - 2\ a\_3 \[Equal] 0, 
        2\ a\_1 - 2\ \[ImaginaryI]\ a\_2 - 2\ a\_3 \[Equal] 0}, {a\_1, 
        a\_2}]\)], "Input",
  CellLabel->"In[457]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \({{a\_1 \[Rule] a\_3, a\_2 \[Rule] 0}}\)], "Output",
  CellLabel->"Out[457]=",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[CellGroupData[{

Cell[BoxData[
    \(f = \(f /. \[InvisibleSpace]{a\_1 \[Rule] a\_3, 
            a\_2 \[Rule] 0}\) /. {a\_3 \[Rule] 1}\)], "Input",
  CellLabel->"In[463]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \(x\^2 + y\^2 + x\ z\ a\_4 + y\ z\ a\_5 + z\^2\ a\_6\)], "Output",
  CellLabel->"Out[463]=",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[TextData[{
  "We can try some ",
  StyleBox["random",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " examples."
}], "Text",
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[{
    \(g = 
      f /. \[InvisibleSpace]{a\_4 \[Rule] \(-5\)\ Random[], 
          a\_5 \[Rule] \(-5\)\ Random[], 
          a\_6 \[Rule] \(-Random[]\)}\), "\n", 
    \(\(ImplicitPlot[{g \[Equal] 0} /. \[InvisibleSpace]{z \[Rule] 
              1}, {x, \(-10\), 10}, {y, \(-10\), 10}, PlotPoints \[Rule] 300, 
        AxesOrigin \[Rule] {0, 0}, 
        PlotStyle \[Rule] {Thickness[0.007]}];\)\)}], "Input",
  CellLabel->"In[546]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \(x\^2 + y\^2 - 0.8765052248865253`\ x\ z - 1.8298069505080448`\ y\ z - 
      0.7421311802364832`\ z\^2\)], "Output",
  CellLabel->"Out[546]=",
  CellFrameColor->GrayLevel[0]],

