Cell[TextData[{
  "We seem to have a ",
  StyleBox["triple point",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  Here is a check:"
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[
    \(PD[g, \((2\ u + w)\)\^2] // Tidy\)], "Input",
  CellLabel->"In[560]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \(0\)], "Output",
  CellLabel->"Out[560]=",
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[TextData[{
  "Let's introduce the ",
  StyleBox["first derivative",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " and factor it."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[
    \(h = Factor[PD[g, 2\ u + w], Extension \[Rule] {\@22}]\)], "Input",
  CellLabel->"In[561]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[BoxData[
    \(4\/3\ \((3\ x + \((\(-7\) + 2\ \@22)\)\ y - 6\ z)\)\ \((x + 2\ y - 
          2\ z)\)\ \((\(-3\)\ x + \((7 + 2\ \@22)\)\ y + 6\ z)\)\)], "Output",\

  CellLabel->"Out[561]=",
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[TextData[{
  "Yes! It factors into ",
  StyleBox["linear factors",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  Here is the ",
  StyleBox["picture",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(ImplicitPlot[{h == 0} /. {z \[Rule] 1}, \n\t{x, \(-4\), 
          4}, {y, \(-4\), 4}, \n\tPlotPoints \[Rule] 300, \n\t
        AxesOrigin \[Rule] {0, 0}, \n\t
        PlotStyle \[Rule] {Thickness[0.007]}];\)\)], "Input",
  CellLabel->"In[562]:=",
  Evaluator->"None",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  Evaluatable->False,
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

