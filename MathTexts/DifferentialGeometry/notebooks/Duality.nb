Cell[TextData[{
  StyleBox["They all seem to be ",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["circles!  ",
    FontWeight->"Bold",
    FontSlant->"Italic",
    FontColor->RGBColor[1, 0, 0]],
  StyleBox["OK?",
    FontWeight->"Bold",
    FontColor->RGBColor[1, 0, 0]]
}], "Text",
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]]
}, Closed]],

Cell[CellGroupData[{

Cell["Perpendicularity", "Subsubsection",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

Cell[TextData[{
  StyleBox["Definition.",
    FontWeight->"Bold"],
  " Two lines (neither of which are at infinity) are ",
  StyleBox["perpendicular",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " if, and only if, ",
  StyleBox["either",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " they pass through the ",
  StyleBox["same",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " circular point at infinity ",
  StyleBox["or",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " the circular points separate their intersections with the line at \
infinity ",
  StyleBox["harmonically",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  "."
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0],
  Background->RGBColor[1, 1, 0]],

Cell[TextData[{
  StyleBox["Theorem.",
    FontWeight->"Bold"],
  "  For a parabola, a ",
  StyleBox["point",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " on the curve, the ",
  StyleBox["focus",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ", the ",
  StyleBox["foot",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of the perpendicular to the directrix, and the ",
  StyleBox["intersection",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " of the tangent with the axis form a ",
  StyleBox["rhombus",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  ".  Therefore, the parabola is the locus of points ",
  StyleBox["equidistant",
    FontWeight->"Bold",
    FontSlant->"Italic"],
  " from the focus and the directrix.",
  StyleBox[" ",
    FontSize->18]
}], "Text",
  CellBracketOptions->{"Color"->GrayLevel[0]},
  CellAutoOverwrite->False,
  CellFrameColor->GrayLevel[0]],

