{
  // Lean 4 abbreviation input (\to, \sqsubseteq, ...) also fires in Markdown, so
  // prose in docs/ and notes/ is typed with the same keystrokes as the proofs.
  // This array replaces the extension default ["lean4", "lean"] rather than
  // extending it, so both defaults are listed explicitly.
  "lean4.input.languages": ["lean4", "lean", "markdown"]
}
