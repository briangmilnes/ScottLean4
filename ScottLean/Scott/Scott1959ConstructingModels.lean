/-! ## Section 1.  Ordered rings and domains -/

/-- A commutative ring with unit `⟨R, +, ·, 0, 1⟩` (Section 1). -/
structure CommRing where
  R        : Type
  add      : R → R → R
  mul      : R → R → R
  neg      : R → R
  zero     : R
  one      : R
  add_comm  : ∀ a b, add a b = add b a
  add_assoc : ∀ a b c, add (add a b) c = add a (add b c)
  add_zero  : ∀ a, add a zero = a
  add_neg   : ∀ a, add a (neg a) = zero
  mul_comm  : ∀ a b, mul a b = mul b a
  mul_assoc : ∀ a b c, mul (mul a b) c = mul a (mul b c)
  mul_one   : ∀ a, mul a one = a
  distrib   : ∀ a b c, mul a (add b c) = add (mul a b) (mul a c)

/-- An *ordered ring* `⟨R, +, ·, 0, 1, ≤⟩`: a commutative ring with a linear
    order compatible with the ring operations (Section 1, p. 236). -/
structure OrderedRing extends CommRing where
  le          : R → R → Prop
  le_refl     : ∀ a, le a a
  le_trans    : ∀ a b c, le a b → le b c → le a c
  le_antisymm : ∀ a b, le a b → le b a → a = b
  le_total    : ∀ a b, le a b ∨ le b a
  add_le      : ∀ a b c, le a b → le (add a c) (add b c)
  mul_pos     : ∀ a b, le zero a → le zero b → le zero (mul a b)

/-- An *integral domain* has no zero divisors. -/
def OrderedRing.NoZeroDivisors (D : OrderedRing) : Prop :=
  ∀ a b, D.mul a b = D.zero → a = D.zero ∨ b = D.zero

/-- An *ordered domain* is an ordered ring that is an integral domain. -/
structure OrderedDomain extends OrderedRing where
  no_zero_divisors : ∀ a b, mul a b = zero → a = zero ∨ b = zero

/-- Strict order derived from `≤`. -/
def OrderedRing.lt (D : OrderedRing) (a b : D.R) : Prop := D.le a b ∧ a ≠ b

/-- *Formally real* (Section 1, p. 236): `0` is not a finite sum of non-zero
    squares.  We record the key single-square consequence used throughout: `-1`
    is not a sum of squares.  (Stated as a predicate on a ring.) -/
def CommRing.FormallyReal (R : CommRing) : Prop :=
  ∀ (k : Nat) (f : Fin k → R.R),
    -- no non-trivial representation of 0 as a sum of squares
    (∀ i, f i ≠ R.zero) →
    (List.foldr (fun i acc => R.add (R.mul (f i) (f i)) acc) R.zero
      (List.finRange k) = R.zero) → k = 0

/-- Proposition 1.1.  An ordered ring is always a formally real integral
    domain. -/
theorem orderedDomain_formallyReal (D : OrderedDomain) :
    D.toCommRing.FormallyReal := by
  sorry -- TODO Proposition 1.1

/-- *Densely ordered*: between any two elements there is a third. -/
def OrderedDomain.Dense (D : OrderedDomain) : Prop :=
  ∀ a b, D.lt a b → ∃ c, D.lt a c ∧ D.lt c b

/-- *Discretely ordered*: there is no element strictly between `0` and `1`. -/
def OrderedDomain.Discrete (D : OrderedDomain) : Prop :=
  ¬ ∃ c, D.lt D.zero c ∧ D.lt c D.one

/-- *Archimedean ordered* (p. 237): for `0 < a < b` some integer multiple of `a`
    exceeds `b`.  `nsmul n a` is `a + a + ⋯ + a` (`n` times). -/
def OrderedRing.nsmul (D : OrderedRing) : Nat → D.R → D.R
  | 0,     _ => D.zero
  | n + 1, a => D.add a (D.nsmul n a)

def OrderedDomain.Archimedean (D : OrderedDomain) : Prop :=
  ∀ a b, D.lt D.zero a → D.lt a b → ∃ n : Nat, D.lt b (D.toOrderedRing.nsmul n a)

/-- Proposition 1.2.  An ordered domain is either densely or discretely
    ordered. -/
theorem dense_or_discrete (D : OrderedDomain) : D.Dense ∨ D.Discrete := by
  sorry -- TODO Proposition 1.2

/-- An *inductive domain* (Definition, p. 237): an ordered domain in which every
    algebraically defined subset containing `0` and closed under `x ↦ x+1`
    includes all non-negative elements.  Equivalently (Proposition 1.4) an
    algebraically well-ordered domain.  This is Scott's algebraic name for a
    *model of first-order arithmetic*.  We capture the induction schema over an
    abstract family `Def` of "algebraically definable" subsets. -/
structure InductiveDomain extends OrderedDomain where
  /-- the algebraically (first-order) definable subsets of the domain. -/
  Def         : (R → Prop) → Prop
  /-- induction: a definable set containing 0, closed under successor, contains
      all non-negatives. -/
  induction   : ∀ S : R → Prop, Def S → S zero →
                  (∀ x, S x → S (add x one)) →
                  ∀ x, le zero x → S x

/-- Proposition 1.5.  An inductive domain is always discretely ordered. -/
theorem inductive_discrete (D : InductiveDomain) : D.toOrderedDomain.Discrete := by
  sorry -- TODO Proposition 1.5

/-- `D` is *non-archimedean* iff it is not archimedean; Scott's "non-standard
    model of arithmetic". -/
def InductiveDomain.NonArchimedean (D : InductiveDomain) : Prop :=
  ¬ D.toOrderedDomain.Archimedean

/-- Theorem 1.10.  No non-archimedean inductive domain can be generated from a
    parametrically definable sequence of elements by a parametrically definable
    sequence of functions.  Stated: the subring generated by any
    countably-indexed (`Nat`) family of elements under any countable family of
    functions is not all of `D`. -/
