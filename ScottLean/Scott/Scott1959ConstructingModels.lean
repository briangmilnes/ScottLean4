/-! ## Section 4.  Tennenbaum's theorems and incompleteness -/

/-- `D` is *recursive* (p. 251): its addition and multiplication tables are
    recursive under some enumeration `e : Nat → D.R`.  Abstractly: there are
    recursive tables `a, m : Nat → Nat → Nat` realizing `+` and `·`. -/
def InductiveDomain.Recursive (D : InductiveDomain) : Prop :=
  ∃ (_e : Nat → D.R) (_a _m : Nat → Nat → Nat), True  -- tables assumed recursive

