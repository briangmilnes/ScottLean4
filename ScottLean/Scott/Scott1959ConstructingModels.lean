/-! ## Section 2.  Function rings and minimal primes -/

/-- A ring *has enough idempotents* (p. 240): a map `e : R → R` with
      e 0 = 0, e (x·y) = e x · e y, e (e x) = e x, e x · x = x. -/
structure EnoughIdempotents (Ring : CommRing) where
  e         : Ring.R → Ring.R
  e_zero    : e Ring.zero = Ring.zero
  e_mul     : ∀ x y, e (Ring.mul x y) = Ring.mul (e x) (e y)
  e_idem    : ∀ x, e (e x) = e x
  e_absorb  : ∀ x, Ring.mul (e x) x = x

/-- A (proper) ideal of a commutative ring. -/
structure Ideal (Ring : CommRing) where
  mem       : Ring.R → Prop
  zero_mem  : mem Ring.zero
  add_mem   : ∀ a b, mem a → mem b → mem (Ring.add a b)
  smul_mem  : ∀ r a, mem a → mem (Ring.mul r a)
  proper    : ¬ mem Ring.one

/-- A *prime* ideal. -/
def Ideal.IsPrime {Ring : CommRing} (P : Ideal Ring) : Prop :=
  ∀ a b, P.mem (Ring.mul a b) → P.mem a ∨ P.mem b

/-- `P` is a *minimal* prime ideal: prime, and contained in no strictly smaller
    prime. -/
def Ideal.IsMinimalPrime {Ring : CommRing} (P : Ideal Ring) : Prop :=
  P.IsPrime ∧ ∀ Q : Ideal Ring, Q.IsPrime → (∀ a, Q.mem a → P.mem a) →
    (∀ a, P.mem a → Q.mem a)

/-- Lemma 2.2.  If `R` has enough idempotents and `P` is prime, then `P` is
    minimal iff `e(P) ⊆ P` (i.e. `P` is closed under `e`). -/
theorem minimalPrime_iff_closed_under_e {Ring : CommRing}
    (idem : EnoughIdempotents Ring) (P : Ideal Ring) (_hP : P.IsPrime) :
    P.IsMinimalPrime ↔ ∀ a, P.mem a → P.mem (idem.e a) := by
  sorry -- TODO Lemma 2.2

/-- The complete direct power `Zᴵ` (function ring), abstractly: functions from an
    index set `I` to a base ordered domain `Base` with pointwise operations.  We
    keep it opaque as a ring together with the constant-embedding of `Base`. -/
structure FunctionRing where
  I        : Type
  Base     : OrderedDomain
  ring     : CommRing
  const    : Base.R → ring.R           -- constant sequences
  idem     : EnoughIdempotents ring    -- Zᴵ has enough idempotents (p. 241)

